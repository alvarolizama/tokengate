<Layouts.flash_group flash={@flash} />
<div class="relative min-h-screen overflow-hidden">
  <%!-- Background gradient orbs --%>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-[40rem] h-[40rem] rounded-full bg-primary/10 blur-3xl">
    </div>
    <div class="absolute -bottom-40 -left-40 w-[40rem] h-[40rem] rounded-full bg-secondary/10 blur-3xl">
    </div>
  </div>

  <div class="relative px-4 py-10 sm:px-6 sm:py-16 lg:px-8 xl:px-28 xl:py-24">
    <div class="mx-auto max-w-3xl">
      <%!-- Brand --%>
      <div class="flex items-center gap-3">
        <img src={~p"/images/logo.svg"} width="48" alt="TokenGate" />
        <h1 class="text-2xl font-bold tracking-tight">TokenGate</h1>
      </div>

      <%!-- Hero --%>
      <div class="mt-12">
        <p class="text-4xl sm:text-5xl font-bold leading-tight tracking-tight text-balance">
          Tu gateway autohospedado para modelos de lenguaje.
        </p>
        <p class="mt-6 text-lg leading-8 text-base-content/70 max-w-2xl">
          Proxy compatible con OpenAI para múltiples proveedores. Gestiona API keys, presupuestos, modelos y reglas de enrutamiento desde un solo panel. Round-robin, fallback y circuit breaker incluidos.
        </p>
      </div>

      <%!-- CTA --%>
      <div class="mt-10 flex flex-wrap gap-4">
        <.link href={~p"/login"} class="btn btn-primary gap-2">
          <.icon name="hero-arrow-right-circle" class="w-5 h-5" /> Iniciar sesión
        </.link>
        <.link href={~p"/login"} class="btn btn-ghost gap-2">
          <.icon name="hero-document-text" class="w-5 h-5" /> Ver documentación
        </.link>
      </div>

      <%!-- Feature cards --%>
      <div class="mt-20 grid grid-cols-1 gap-6 sm:grid-cols-3">
        <div class="card bg-base-200/50 border border-base-300">
          <div class="card-body gap-2 p-5">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <.icon name="hero-arrows-right-left" class="w-5 h-5 text-primary" />
            </div>
            <h2 class="card-title text-base">Proxy OpenAI-compatible</h2>
            <p class="text-sm text-base-content/60">
              Drop-in replacement. Apunta tu cliente a
              <code class="text-xs px-1.5 py-0.5 rounded bg-base-300">/v1/chat/completions</code>
              y funciona.
            </p>
          </div>
        </div>

        <div class="card bg-base-200/50 border border-base-300">
          <div class="card-body gap-2 p-5">
            <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center">
              <.icon name="hero-shield-check" class="w-5 h-5 text-secondary" />
            </div>
            <h2 class="card-title text-base">Presupuestos y control</h2>
            <p class="text-sm text-base-content/60">
              Límites por equipo y API key. Alertas de gasto. Visibilidad total del consumo.
            </p>
          </div>
        </div>

        <div class="card bg-base-200/50 border border-base-300">
          <div class="card-body gap-2 p-5">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center">
              <.icon name="hero-server-stack" class="w-5 h-5 text-accent" />
            </div>
            <h2 class="card-title text-base">Multi-proveedor</h2>
            <p class="text-sm text-base-content/60">
              Round-robin, fallback automático y circuit breaker. Tus modelos siempre disponibles.
            </p>
          </div>
        </div>
      </div>

      <%!-- Footer --%>
      <div class="mt-20 flex items-center justify-between border-t border-base-300 pt-6">
        <p class="text-sm text-base-content/40">
          v{Application.spec(:tokengate, :vsn) |> to_string()}
        </p>
        <Layouts.theme_toggle />
      </div>
    </div>
  </div>
</div>
