<Layouts.dashboard flash={@flash} current_scope={@current_user} impersonator={@impersonator}>
  <div class="space-y-6">
    <%!-- Header + period selector --%>
    <div class="flex items-center justify-between flex-wrap gap-4">
      <.header>
        Estadísticas
        <:subtitle>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-funnel" class="w-4 h-4 text-base-content/50" />
            {@scope_label}
          </span>
        </:subtitle>
      </.header>

      <div class="flex items-center gap-3">
        <span
          :if={@stats_loading}
          class="loading loading-spinner loading-sm text-primary"
          id="stats-loading"
          title="Actualizando estadísticas…"
        ></span>
        <div class="join" id="period-selector" role="tablist">
          <button
            :for={period <- ~w(today 7d 30d 90d)}
            phx-click="set_period"
            phx-value-period={period}
            class={[
              "join-item btn btn-sm",
              if(period_active?(@period, period), do: "btn-primary", else: "btn-ghost")
            ]}
            id={"period-#{period}"}
          >
            {period_label(period)}
          </button>
        </div>
      </div>
    </div>

    <%!-- Nav tabs between the 3 views --%>
    <div class="join" id="stats-nav" role="tablist">
      <.link
        patch={~p"/dashboard/stats?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :index, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-stats"
      >
        <.icon name="hero-chart-bar-square" class="w-4 h-4" /> Resumen
      </.link>
      <.link
        patch={~p"/dashboard/stats/models?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :models, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-models"
      >
        <.icon name="hero-rectangle-stack" class="w-4 h-4" /> Modelos
      </.link>
      <.link
        patch={~p"/dashboard/stats/teams?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :teams, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-teams"
      >
        <.icon name="hero-user-group" class="w-4 h-4" /> Equipos
      </.link>
      <.link
        patch={~p"/dashboard/stats/services?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :services, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-services"
      >
        <.icon name="hero-wrench-screwdriver" class="w-4 h-4" /> Servicios
      </.link>
    </div>

    <div
      class={[
        "transition-opacity duration-200",
        @stats_loading && "opacity-50 pointer-events-none"
      ]}
      id="stats-content"
    >
      <%= cond do %>
        <% @live_action == :index -> %>
          <div class="space-y-6">
            <%!-- KPI cards --%>
            <.kpi_cards metrics={@metrics} />

            <%!-- Patrones de uso: hora del día, picos y concurrencia --%>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" id="usage-patterns">
              <%!-- Card 1: Por modelo y proveedor --%>
              <div
                class="card bg-base-100 border border-base-300 shadow-sm"
                id="model-provider-breakdown"
              >
                <div class="card-body p-4 gap-2">
                  <h2 class="card-title text-base">
                    <.icon name="hero-rectangle-stack" class="w-5 h-5 text-base-content/60" />
                    Por modelo y proveedor
                  </h2>

                  <%= if model_provider_max(@model_provider_stacked) > 0 do %>
                    <% mp_legend = provider_legend(@model_provider_stacked) %>

                    <div class="flex gap-4 mt-2 pt-2 border-t border-base-200">
                      <%!-- Chart --%>
                      <div class="flex-1 space-y-2">
                        <div
                          :for={row <- @model_provider_stacked}
                          class="group"
                        >
                          <div class="flex items-center gap-2">
                            <%!-- Model label --%>
                            <span class="text-[11px] font-medium text-base-content/70 w-28 truncate shrink-0 text-right">
                              {row.model_name}
                            </span>

                            <%!-- Bar --%>
                            <div class="flex-1 relative h-5 rounded overflow-hidden bg-base-200/50">
                              <div
                                :for={seg <- provider_segments(row, mp_legend)}
                                class={["h-full inline-block transition-all", seg.color]}
                                style={"width: #{seg.width_pct}%"}
                                title={"#{seg.provider_name}: #{format_number(seg.requests)} req"}
                              >
                              </div>
                            </div>

                            <%!-- Request count --%>
                            <span class="text-[10px] text-base-content/50 tabular-nums shrink-0 w-12 text-right">
                              {format_number(row.total_requests)}
                            </span>
                          </div>
                        </div>
                      </div>

                      <%!-- Legend --%>
                      <div class="w-48 shrink-0 border-l border-base-300 pl-4">
                        <div class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wide mb-2">
                          Proveedores
                        </div>
                        <div class="space-y-2">
                          <div :for={entry <- mp_legend}>
                            <div class="flex items-center gap-1.5">
                              <span class={[
                                "w-2.5 h-2.5 rounded-sm shrink-0",
                                provider_legend_color(entry.provider_name, mp_legend)
                              ]} />
                              <span class="text-[10px] font-medium truncate flex-1">{entry.provider_name}</span>
                              <span class="text-[9px] text-base-content/50 shrink-0">
                                {format_number(entry.requests)} req
                              </span>
                              <span
                                :if={Decimal.compare(entry.cost_usd, Decimal.new(0)) == :gt}
                                class="text-[9px] text-warning shrink-0"
                              >
                                ${format_decimal(entry.cost_usd)}
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      Sin datos en este período.
                    </p>
                  <% end %>
                </div>
              </div>

              <%!-- Card 2: Uso por hora del día --%>
              <div
                class="card bg-base-100 border border-base-300 shadow-sm"
                id="hour-distribution"
              >
                <div class="card-body p-4 gap-2">
                  <div class="flex items-center justify-between">
                    <h2 class="card-title text-base">
                      <.icon name="hero-clock" class="w-5 h-5 text-base-content/60" />
                      Uso por hora del día
                    </h2>
                    <span class="text-[10px] text-base-content/40 hidden sm:inline">
                      gris = included · morada = pay_per_token · escala √
                    </span>
                  </div>

                  <%!-- Hour distribution chart --%>
                  <%= if hour_usage_stacked_max(@hour_usage_stacked) > 0 do %>
                    <% max = hour_usage_stacked_max(@hour_usage_stacked) %>
                    <% legend = legend_data(@hour_usage_stacked, @hovered_hour) %>
                    <% y_ticks = y_axis_ticks(max) %>

                    <div class="flex gap-4 mt-2 items-end">
                      <%!-- Chart --%>
                      <div class="flex-1">
                        <div class="flex gap-2 items-end">
                          <%!-- Y axis labels --%>
                          <div class="relative h-48 w-10 shrink-0">
                            <span
                              :for={tick <- y_ticks}
                              class="absolute right-0 text-[9px] text-base-content/50 tabular-nums -translate-y-1/2"
                              style={"bottom: #{:math.sqrt(tick / max) * 100}%"}
                            >
                              {format_number(tick)}
                            </span>
                            <span class="absolute right-0 bottom-0 text-[9px] text-base-content/50 tabular-nums translate-y-1/2">
                              0
                            </span>
                          </div>

                          <div class="relative flex-1">
                            <%!-- Gridlines --%>
                            <div class="absolute inset-0 pointer-events-none">
                              <div
                                :for={tick <- y_ticks}
                                class="absolute left-0 right-0 border-t border-base-300/50 border-dashed"
                                style={"bottom: #{:math.sqrt(tick / max) * 100}%"}
                              />
                            </div>

                            <div class="flex items-end gap-[3px] h-48 relative">
                              <div
                                :for={row <- @hour_usage_stacked}
                                class="group relative flex-1 flex flex-col items-center justify-end h-full"
                                phx-mouseover="hour_hover"
                                phx-value-hour={row.hour}
                                phx-mouseleave="hour_leave"
                              >
                                <% height_pct = hour_usage_bar_height(row.total_requests, max) %>
                                <% segments = bar_segments(row) %>

                                <%!-- Tooltip --%>
                                <div class="hidden group-hover:block absolute -top-1 -translate-y-full left-1/2 -translate-x-1/2 z-20 pointer-events-none">
                                  <div class="bg-base-300 text-base-content text-[10px] rounded-md px-2.5 py-1.5 shadow-lg whitespace-nowrap">
                                    <div class="font-semibold">
                                      {hour_label(row.hour)} · {format_number(row.total_requests)} req
                                    </div>
                                    <div
                                      :if={row.included_requests > 0}
                                      class="text-base-content/70"
                                    >
                                      included: {format_number(row.included_requests)}
                                    </div>
                                    <div
                                      :if={row.pay_per_token_requests > 0}
                                      class="text-base-content/70"
                                    >
                                      pay_per_token: {format_number(row.pay_per_token_requests)}
                                    </div>
                                    <div
                                      :for={m <- ppt_models_for_tooltip(row)}
                                      class="text-base-content/50 flex justify-between gap-3"
                                    >
                                      <span class="truncate max-w-[140px]">{m.model}</span>
                                      <span class="tabular-nums shrink-0">{format_number(
                                        m.requests
                                      )}</span>
                                    </div>
                                  </div>
                                </div>

                                <div
                                  class={[
                                    "w-full rounded-t transition-all relative overflow-hidden cursor-pointer",
                                    if(@hovered_hour == row.hour,
                                      do: "ring-2 ring-primary",
                                      else: ""
                                    )
                                  ]}
                                  style={"height: #{height_pct}%"}
                                >
                                  <%= if segments == [] do %>
                                    <div class="w-full h-full bg-base-300/30" />
                                  <% else %>
                                    <div class="flex flex-col-reverse h-full w-full">
                                      <div
                                        :for={seg <- segments}
                                        class={["w-full", seg.color]}
                                        style={"height: #{seg.height_pct}%"}
                                      />
                                    </div>
                                  <% end %>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <%!-- Hour labels --%>
                        <div class="flex gap-[3px] mt-1 ml-12">
                          <span :for={row <- @hour_usage_stacked} class="flex-1 text-center">
                            <span
                              :if={rem(row.hour, 3) == 0}
                              class={[
                                "text-[10px]",
                                if(rem(row.hour, 6) == 0,
                                  do: "text-base-content/60 font-medium",
                                  else: "text-base-content/40"
                                )
                              ]}
                            >
                              {hour_label(row.hour)}
                            </span>
                          </span>
                        </div>
                      </div>

                      <%!-- Legend panel --%>
                      <div class="w-56 shrink-0 border-l border-base-300 pl-4">
                        <div class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wide mb-2">
                          <%= if legend.hovered_hour do %>
                            {hour_label(legend.hovered_hour)} hrs
                          <% else %>
                            Total período
                          <% end %>
                        </div>

                        <%!-- Included entry --%>
                        <div :if={legend.included_requests > 0} class="mb-2">
                          <div class="flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-sm shrink-0 bg-base-300/30" />
                            <span class="text-[10px] font-medium flex-1">Included</span>
                            <span class="text-[9px] text-base-content/50 shrink-0">
                              {format_number(legend.included_requests)} req
                            </span>
                          </div>
                        </div>

                        <%!-- Pay-per-token model breakdown --%>
                        <div class="space-y-2.5">
                          <div :for={entry <- legend.ppt_entries}>
                            <div class="flex items-center gap-1.5">
                              <span class="w-2.5 h-2.5 rounded-sm shrink-0 bg-primary" />
                              <span class="text-[10px] font-medium truncate flex-1">{entry.model}</span>
                              <span class="text-[9px] text-base-content/50 shrink-0">
                                {format_number(entry.requests)} req
                              </span>
                              <span
                                :if={Decimal.compare(entry.cost_usd, Decimal.new(0)) == :gt}
                                class="text-[9px] text-warning shrink-0"
                              >
                                ${format_decimal(entry.cost_usd)}
                              </span>
                            </div>
                          </div>
                        </div>

                        <%!-- Totals --%>
                        <div class="mt-3 pt-2 border-t border-base-300">
                          <div class="text-[10px] font-semibold">
                            {format_number(legend.total_requests)} requests
                          </div>
                          <div
                            :if={Decimal.compare(legend.total_cost_usd, Decimal.new(0)) == :gt}
                            class="text-[10px] text-warning font-medium"
                          >
                            ${format_decimal(legend.total_cost_usd)} total
                          </div>
                        </div>
                      </div>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      Sin datos en este período.
                    </p>
                  <% end %>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <%= if @current_user && @current_user.global_role == "admin" do %>
                  <div id="peak-concurrency" class="card bg-base-100 border border-base-300 shadow-sm">
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                          Pico de concurrencia
                        </span>
                        <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-primary/10">
                          <.icon name="hero-arrow-trending-up" class="w-5 h-5 text-primary" />
                        </span>
                      </div>
                      <%= if @peak_concurrency && @peak_concurrency.max_concurrent > 0 do %>
                        <p class="mt-2 text-2xl font-bold text-base-content">
                          {format_number(@peak_concurrency.max_concurrent)}
                        </p>
                        <p class="text-xs text-base-content/40 mt-1">
                          requests simultáneos · {format_bucket(
                            @peak_concurrency.at,
                            @timezone
                          )}
                        </p>
                      <% else %>
                        <p class="text-sm text-base-content/40 mt-2">
                          Sin datos
                        </p>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <div id="busiest-hours" class="card bg-base-100 border border-base-300 shadow-sm">
                  <div class="card-body p-5">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                        Horas pico
                      </span>
                      <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-warning/10">
                        <.icon name="hero-fire" class="w-5 h-5 text-warning" />
                      </span>
                    </div>
                    <%= if has_data?(@busiest_hours) do %>
                      <ul class="mt-2 space-y-1">
                        <li
                          :for={{row, idx} <- Enum.with_index(@busiest_hours, 1)}
                          id={"busiest-hour-#{idx}"}
                          class="flex items-center justify-between text-sm"
                        >
                          <span class="text-base-content/70">
                            {idx}. {format_bucket(row.bucket, @timezone)}
                          </span>
                          <span class="font-mono">{format_number(row.request_count)}</span>
                        </li>
                      </ul>
                    <% else %>
                      <p class="text-sm text-base-content/40 mt-2">
                        Sin datos
                      </p>
                    <% end %>
                  </div>
                </div>

                <div id="busiest-minutes" class="card bg-base-100 border border-base-300 shadow-sm">
                  <div class="card-body p-5">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                        Minutos pico
                      </span>
                      <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-accent/10">
                        <.icon name="hero-bolt" class="w-5 h-5 text-accent" />
                      </span>
                    </div>
                    <%= if has_data?(@busiest_minutes) do %>
                      <ul class="mt-2 space-y-1">
                        <li
                          :for={{row, idx} <- Enum.with_index(@busiest_minutes, 1)}
                          id={"busiest-minute-#{idx}"}
                          class="flex items-center justify-between text-sm"
                        >
                          <span class="text-base-content/70">
                            {idx}. {format_bucket(row.bucket, @timezone)}
                          </span>
                          <span class="font-mono">{format_number(row.request_count)}</span>
                        </li>
                      </ul>
                    <% else %>
                      <p class="text-sm text-base-content/40 mt-2">
                        Sin datos
                      </p>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
            <%!-- Top 5 tables --%>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                  <div class="flex items-center justify-between">
                    <h2 class="card-title text-base">
                      <.icon name="hero-user-group" class="w-5 h-5 text-base-content/60" />
                      Top 5 Equipos
                    </h2>
                    <.link
                      patch={~p"/dashboard/stats/teams?period=#{@period}"}
                      class="btn btn-xs btn-ghost"
                      id="see-all-teams"
                    >
                      Ver todos <.icon name="hero-arrow-right" class="w-3 h-3" />
                    </.link>
                  </div>
                  <%= if has_data?(@breakdown_team) do %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm table-zebra">
                        <thead>
                          <tr>
                            <th>Equipo</th>
                            <th class="text-right">Requests</th>
                            <th class="text-right">Costo</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr
                            :for={row <- Enum.take(@breakdown_team, 5)}
                            id={"top-team-#{row.team_id}"}
                          >
                            <td class="font-medium truncate max-w-[180px]">{row.team_name}</td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(row.cost_usd)}
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">Sin datos.</p>
                  <% end %>
                </div>
              </div>
              <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                  <h2 class="card-title text-base">
                    <.icon name="hero-user" class="w-5 h-5 text-base-content/60" /> Top 5 Miembros
                  </h2>
                  <%= if has_data?(@breakdown_member) do %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm table-zebra">
                        <thead>
                          <tr>
                            <th>Usuario</th>
                            <th class="text-right">Requests</th>
                            <th class="text-right">Costo</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr
                            :for={row <- Enum.take(@breakdown_member, 5)}
                            id={"top-member-#{row.team_member_id}"}
                          >
                            <td class="font-medium truncate max-w-[180px]">{row.user_email}</td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(row.cost_usd)}
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">Sin datos.</p>
                  <% end %>
                </div>
              </div>
            </div>

            <%!-- Ranking de proveedores (solo admin) --%>
            <%= if @current_user && @current_user.global_role == "admin" do %>
              <div class="card bg-base-100 border border-base-300 shadow-sm" id="provider-ranking">
                <div class="card-body">
                  <h2 class="card-title text-base">
                    <.icon name="hero-trophy" class="w-5 h-5 text-base-content/60" />
                    Ranking de proveedores
                  </h2>
                  <p class="text-xs text-base-content/60">
                    Clasificación por confiabilidad (fallos) y velocidad (latencia) en el período.
                    Tier S es el mejor; "—" significa menos de 10 requests.
                  </p>
                  <%= if has_data?(@provider_ranking) do %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>Proveedor</th>
                            <th class="text-center">Tier</th>
                            <th class="text-right">Score</th>
                            <th class="text-right">Requests</th>
                            <th class="text-right">% Fallos</th>
                            <th class="text-right">Latencia prom</th>
                            <th class="text-right">P95</th>
                            <th class="text-right">TTFT prom</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr
                            :for={{row, idx} <- Enum.with_index(@provider_ranking, 1)}
                            id={"provider-ranking-row-#{row.provider_id}"}
                          >
                            <td class="text-base-content/60">{idx}</td>
                            <td class="font-medium truncate max-w-[180px]">
                              {row.provider_name}
                            </td>
                            <td class="text-center">
                              <span class={["badge badge-sm", tier_badge_class(row.tier)]}>
                                {row.tier}
                              </span>
                            </td>
                            <td class="text-right font-mono">{row.score || "—"}</td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class={[
                              "text-right font-mono",
                              row.error_rate >= 0.05 && "text-error",
                              row.error_rate > 0 && row.error_rate < 0.05 && "text-warning"
                            ]}>
                              {format_percent(row.error_rate)}
                            </td>
                            <td class="text-right font-mono">{format_ms(row.avg_latency_ms)}</td>
                            <td class="text-right font-mono">{format_ms(row.p95_latency_ms)}</td>
                            <td class="text-right font-mono">{format_ms(row.avg_ttft_ms)}</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      Sin datos en este período.
                    </p>
                  <% end %>
                </div>
              </div>

              <%!-- Ranking de modelos --%>
              <div class="card bg-base-100 border border-base-300 shadow-sm" id="model-ranking">
                <div class="card-body">
                  <h2 class="card-title text-base">
                    <.icon name="hero-rectangle-stack" class="w-5 h-5 text-base-content/60" />
                    Ranking de modelos
                  </h2>
                  <p class="text-xs text-base-content/60">
                    Clasificación por confiabilidad (fallos) y velocidad (latencia) en el período.
                    Tier S es el mejor; "—" significa menos de 10 requests.
                  </p>
                  <%= if has_data?(@model_ranking) do %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>Modelo</th>
                            <th class="text-center">Tier</th>
                            <th class="text-right">Score</th>
                            <th class="text-right">Requests</th>
                            <th class="text-right">% Fallos</th>
                            <th class="text-right">Latencia prom</th>
                            <th class="text-right">P95</th>
                            <th class="text-right">TTFT prom</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr
                            :for={{row, idx} <- Enum.with_index(@model_ranking, 1)}
                            id={"model-ranking-row-#{row.model_id}"}
                          >
                            <td class="text-base-content/60">{idx}</td>
                            <td class="font-medium truncate max-w-[180px]">
                              {row.model_name}
                            </td>
                            <td class="text-center">
                              <span class={["badge badge-sm", tier_badge_class(row.tier)]}>
                                {row.tier}
                              </span>
                            </td>
                            <td class="text-right font-mono">{row.score || "—"}</td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class={[
                              "text-right font-mono",
                              row.error_rate >= 0.05 && "text-error",
                              row.error_rate > 0 && row.error_rate < 0.05 && "text-warning"
                            ]}>
                              {format_percent(row.error_rate)}
                            </td>
                            <td class="text-right font-mono">{format_ms(row.avg_latency_ms)}</td>
                            <td class="text-right font-mono">{format_ms(row.p95_latency_ms)}</td>
                            <td class="text-right font-mono">{format_ms(row.avg_ttft_ms)}</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      Sin datos en este período.
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%!-- Tiers de uso por miembro (solo admin) --%>
            <%= if @current_user && @current_user.global_role == "admin" do %>
              <div
                class="card bg-base-100 border border-base-300 shadow-sm"
                id="member-usage-tiers"
              >
                <div class="card-body">
                  <h2 class="card-title text-base">
                    <.icon name="hero-chart-bar" class="w-5 h-5 text-base-content/60" />
                    Tiers de uso por miembro
                  </h2>
                  <p class="text-xs text-base-content/60">
                    Clasificación en 3 grupos (alto / regular / bajo) combinando volumen, frecuencia y concurrencia.
                  </p>
                  <%= if has_data?(@member_usage_tiers) do %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>Usuario</th>
                            <th>Equipo</th>
                            <th class="text-center">Tier</th>
                            <th class="text-right">Score</th>
                            <th class="text-right">Requests</th>
                            <th class="text-right">Costo</th>
                            <th class="text-right">Tokens</th>
                            <th class="text-right">Días activos</th>
                            <th class="text-right">Peak RPM</th>
                            <th class="text-right">P95 RPM</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr
                            :for={{row, idx} <- Enum.with_index(@member_usage_tiers, 1)}
                            id={"member-tier-row-#{row.team_member_id}"}
                          >
                            <td class="text-base-content/60">{idx}</td>
                            <td class="font-medium truncate max-w-[200px]">
                              {row.user_name || row.user_email}
                            </td>
                            <td class="truncate max-w-[120px]">{row.team_name}</td>
                            <td class="text-center">
                              <span class={[
                                "badge badge-sm",
                                tier_badge_class(row.tier)
                              ]}>
                                {String.capitalize(row.tier)}
                              </span>
                            </td>
                            <td class="text-right font-mono">{row.score}</td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">${format_decimal(row.cost_usd)}</td>
                            <td class="text-right font-mono">
                              {format_compact(row.prompt_tokens + row.completion_tokens)}
                            </td>
                            <td class="text-right font-mono">{row.active_days}</td>
                            <td class="text-right font-mono">{row.peak_rpm}</td>
                            <td class="text-right font-mono">{row.p95_rpm}</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      Sin datos en este período.
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% @live_action == :models -> %>
          <div class="space-y-6">
            <div class="flex items-center justify-end flex-wrap gap-3">
              <.link
                href={
                  if @model_filter,
                    do:
                      "/dashboard/stats/export?type=models&period=#{@period}&model_id=#{@model_filter}",
                    else: "/dashboard/stats/export?type=models&period=#{@period}"
                }
                class="btn btn-sm btn-ghost"
                id="csv-models"
              >
                <.icon name="hero-arrow-down-tray" class="w-4 h-4" /> CSV
              </.link>
            </div>

            <%= if @model_filter do %>
              <div class="space-y-6">
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                  <div
                    id="model-kpi-requests"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Requests</span>
                        <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-primary/10">
                          <.icon name="hero-server-stack" class="w-5 h-5 text-primary" />
                        </span>
                      </div>
                      <p class="mt-2 text-2xl font-bold">
                        {format_number(@metrics.requests_total)}
                      </p>
                    </div>
                  </div>
                  <div
                    id="model-kpi-cost"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Costo</span>
                        <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-accent/10">
                          <.icon name="hero-currency-dollar" class="w-5 h-5 text-accent" />
                        </span>
                      </div>
                      <p class="mt-2 text-2xl font-bold">
                        ${format_decimal(@metrics.cost_usd)}
                      </p>
                    </div>
                  </div>
                  <div
                    id="model-kpi-tokens"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Tokens in/out</span>
                        <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-base-300">
                          <.icon name="hero-cpu-chip" class="w-5 h-5 text-base-content/60" />
                        </span>
                      </div>
                      <p
                        class="mt-2 text-lg font-bold"
                        title={"#{format_number(@metrics.prompt_tokens)} / #{format_number(@metrics.completion_tokens)}"}
                      >
                        {format_compact(@metrics.prompt_tokens)} / {format_compact(
                          @metrics.completion_tokens
                        )}
                      </p>
                    </div>
                  </div>
                  <div
                    id="model-kpi-tps"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">TPS</span>
                        <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-base-300">
                          <.icon name="hero-bolt" class="w-5 h-5 text-base-content/60" />
                        </span>
                      </div>
                      <p class="mt-2 text-2xl font-bold">
                        {format_tps(@metrics.avg_tps)}
                      </p>
                    </div>
                  </div>
                </div>

                <%!-- Daily usage sparkline: providers over time --%>
                <%= if @drilldown_series != [] do %>
                  <% pivoted = pivot_daily_series(@drilldown_series) %>
                  <% spark_max = daily_series_max(pivoted) %>
                  <% labels = @drilldown_series_labels %>

                  <div class="card bg-base-100 border border-base-300 shadow-sm">
                    <div class="card-body p-4 gap-2">
                      <div class="flex items-center justify-between">
                        <h2 class="card-title text-base">
                          <.icon name="hero-chart-bar" class="w-5 h-5 text-base-content/60" />
                          Uso diario por proveedor
                        </h2>
                        <span class="text-[10px] text-base-content/40 hidden sm:inline">
                          {period_label(@period)}
                        </span>
                      </div>

                      <div class="flex gap-4 mt-2">
                        <%!-- Chart area --%>
                        <div class="flex-1">
                          <div class="flex items-end gap-px h-32 relative">
                            <div
                              :for={day <- pivoted.days}
                              class="flex-1 flex flex-col items-center justify-end h-full group relative"
                            >
                              <%!-- Tooltip --%>
                              <div class="hidden group-hover:block absolute -top-1 -translate-y-full left-1/2 -translate-x-1/2 z-20 pointer-events-none">
                                <div class="bg-base-300 text-base-content text-[10px] rounded-md px-2 py-1 shadow-lg whitespace-nowrap">
                                  <div class="font-semibold">{Calendar.strftime(day, "%d %b")}</div>
                                  <div :for={label <- labels} class="flex justify-between gap-2">
                                    <span class="truncate max-w-[100px]">{label}</span>
                                    <span class="tabular-nums">
                                      {format_number(Map.get(pivoted.series[label] || %{}, day, 0))}
                                    </span>
                                  </div>
                                </div>
                              </div>

                              <%!-- Stacked bar --%>
                              <div class="w-full flex flex-col-reverse rounded-t overflow-hidden">
                                <div
                                  :for={label <- labels}
                                  class={["w-full", sparkline_color(Enum.find_index(labels, &(&1 == label)) || 0)]}
                                  style={"height: #{sparkline_bar_height(Map.get(pivoted.series[label] || %{}, day, 0), spark_max)}%"}
                                  title={"#{label}: #{format_number(Map.get(pivoted.series[label] || %{}, day, 0))}"}
                                />
                              </div>
                            </div>
                          </div>

                          <%!-- Day labels --%>
                          <div class="flex gap-px mt-1">
                            <span
                              :for={day <- pivoted.days}
                              class="flex-1 text-center text-[9px] text-base-content/40"
                            >
                              {Calendar.strftime(day, "%d")}
                            </span>
                          </div>
                        </div>

                        <%!-- Legend --%>
                        <div class="w-40 shrink-0 border-l border-base-300 pl-3">
                          <div class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wide mb-2">
                            Proveedores
                          </div>
                          <div class="space-y-1.5">
                            <div :for={{label, idx} <- Enum.with_index(labels)} class="flex items-center gap-1.5">
                              <span class={["w-2 h-2 rounded-sm shrink-0", sparkline_color(idx)]} />
                              <span class="text-[10px] truncate flex-1">{label}</span>
                              <span class="text-[9px] text-base-content/50 shrink-0">
                                {format_number(sparkline_label_total(pivoted.series[label] || %{}))}
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>

                <div class="card bg-base-100 border border-base-300 shadow-sm">
                  <div class="card-body">
                    <h2 class="card-title text-base">
                      <.icon name="hero-server-stack" class="w-5 h-5 text-base-content/60" />
                      Por modelo del proveedor
                    </h2>
                    <%= if has_data?(@breakdown_provider) do %>
                      <% provider_total = breakdown_total(@breakdown_provider) %>
                      <div class="overflow-x-auto mt-3">
                        <table class="table table-sm table-zebra">
                          <thead>
                            <tr>
                              <th>#</th>
                              <th>
                                <button
                                  phx-click="sort"
                                  phx-value-field="provider_name"
                                  class="flex items-center gap-1 hover:text-primary"
                                >
                                  Proveedor / Modelo
                                  <.sort_icon
                                    field={:provider_name}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="request_count"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Requests
                                  <.sort_icon
                                    field={:request_count}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="cost_usd"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Costo
                                  <.sort_icon
                                    field={:cost_usd}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="prompt_tokens"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Tokens in
                                  <.sort_icon
                                    field={:prompt_tokens}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="completion_tokens"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Tokens out
                                  <.sort_icon
                                    field={:completion_tokens}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="avg_tps"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  TPS
                                  <.sort_icon
                                    field={:avg_tps}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr
                              :for={{row, idx} <- Enum.with_index(@breakdown_provider, 1)}
                              id={"bd-provider-#{row.model_provider_id || "unknown"}"}
                            >
                              <td class="text-base-content/60">{idx}</td>
                              <td>
                                <div class="font-medium">
                                  {row.provider_name}{if row.provider_model,
                                    do: " · #{row.provider_model}"}
                                </div>
                                <div
                                  :if={row.credential_name}
                                  class="text-xs text-base-content/60"
                                >
                                  {row.credential_name}
                                </div>
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(row.cost_usd)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.prompt_tokens)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.completion_tokens)}
                              </td>
                              <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                            </tr>
                          </tbody>
                          <tfoot>
                            <tr class="font-bold bg-base-200">
                              <td colspan="2">
                                Total · {distinct_providers(@breakdown_provider)} proveedores
                              </td>
                              <td class="text-right font-mono">
                                {format_number(provider_total.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(provider_total.cost_usd)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(provider_total.prompt_tokens)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(provider_total.completion_tokens)}
                              </td>
                              <td></td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>
                    <% else %>
                      <p class="text-sm text-base-content/40 py-6 text-center">
                        Sin datos para este periodo.
                      </p>
                    <% end %>
                  </div>
                </div>
                <div class="card bg-base-100 border border-base-300 shadow-sm">
                  <div class="card-body">
                    <h2 class="card-title text-base">
                      <.icon name="hero-user-group" class="w-5 h-5 text-base-content/60" />
                      Equipos que lo usan
                    </h2>
                    <%= if has_data?(@breakdown_team) do %>
                      <% team_total = breakdown_total(@breakdown_team) %>
                      <div class="overflow-x-auto mt-3">
                        <table class="table table-sm table-zebra">
                          <thead>
                            <tr>
                              <th>
                                <button
                                  phx-click="sort"
                                  phx-value-field="team_name"
                                  class="flex items-center gap-1 hover:text-primary"
                                >
                                  Equipo
                                  <.sort_icon
                                    field={:team_name}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="request_count"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Requests
                                  <.sort_icon
                                    field={:request_count}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="cost_usd"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Costo
                                  <.sort_icon
                                    field={:cost_usd}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="avg_tps"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  TPS
                                  <.sort_icon
                                    field={:avg_tps}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr :for={row <- @breakdown_team} id={"bd-model-team-#{row.team_id}"}>
                              <td class="font-medium">{row.team_name}</td>
                              <td class="text-right font-mono">
                                {format_number(row.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(row.cost_usd)}
                              </td>
                              <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                            </tr>
                          </tbody>
                          <tfoot>
                            <tr class="font-bold bg-base-200">
                              <td>Total · {length(@breakdown_team)} equipos</td>
                              <td class="text-right font-mono">
                                {format_number(team_total.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(team_total.cost_usd)}
                              </td>
                              <td></td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>
                    <% else %>
                      <p class="text-sm text-base-content/40 py-6 text-center">
                        Sin datos para este periodo.
                      </p>
                    <% end %>
                  </div>
                </div>
                <div class="card bg-base-100 border border-base-300 shadow-sm">
                  <div class="card-body">
                    <h2 class="card-title text-base">
                      <.icon name="hero-user" class="w-5 h-5 text-base-content/60" />
                      Miembros que lo usan
                    </h2>
                    <%= if has_data?(@breakdown_member) do %>
                      <% member_total = breakdown_total(@breakdown_member) %>
                      <div class="overflow-x-auto mt-3">
                        <table class="table table-sm table-zebra">
                          <thead>
                            <tr>
                              <th>
                                <button
                                  phx-click="sort"
                                  phx-value-field="team_name"
                                  class="flex items-center gap-1 hover:text-primary"
                                >
                                  Equipo
                                  <.sort_icon
                                    field={:team_name}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th>
                                <button
                                  phx-click="sort"
                                  phx-value-field="user_email"
                                  class="flex items-center gap-1 hover:text-primary"
                                >
                                  Usuario
                                  <.sort_icon
                                    field={:user_email}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="request_count"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Requests
                                  <.sort_icon
                                    field={:request_count}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="cost_usd"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Costo
                                  <.sort_icon
                                    field={:cost_usd}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="avg_tps"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  TPS
                                  <.sort_icon
                                    field={:avg_tps}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr
                              :for={row <- @breakdown_member}
                              id={"bd-model-member-#{row.team_member_id}"}
                            >
                              <td>{row.team_name}</td>
                              <td class="font-mono text-sm">
                                <.link
                                  navigate={~p"/dashboard/users/#{row.user_id}/stats"}
                                  class="link link-hover"
                                >
                                  {row.user_email}
                                </.link>
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(row.cost_usd)}
                              </td>
                              <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                            </tr>
                          </tbody>
                          <tfoot>
                            <tr class="font-bold bg-base-200">
                              <td colspan="2">
                                Total · {distinct_users(@breakdown_member)} usuarios
                              </td>
                              <td class="text-right font-mono">
                                {format_number(member_total.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(member_total.cost_usd)}
                              </td>
                              <td></td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>
                    <% else %>
                      <p class="text-sm text-base-content/40 py-6 text-center">
                        Sin datos para este periodo.
                      </p>
                    <% end %>
                  </div>
                </div>
                <button
                  phx-click="clear_model_filter"
                  class="btn btn-sm btn-ghost"
                  id="clear-model-filter"
                >
                  <.icon name="hero-x-mark" class="w-4 h-4" /> Quitar filtro de modelo
                </button>
              </div>
            <% else %>
              <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                  <h2 class="card-title text-base">
                    <.icon name="hero-rectangle-stack" class="w-5 h-5 text-base-content/60" />
                    Todos los modelos
                  </h2>
                  <%= if has_data?(@breakdown_model) do %>
                    <% model_total = breakdown_total(@breakdown_model) %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm table-zebra">
                        <thead>
                          <tr>
                            <th>
                              <button
                                phx-click="sort"
                                phx-value-field="model_name"
                                class="flex items-center gap-1 hover:text-primary"
                              >
                                Modelo
                                <.sort_icon
                                  field={:model_name}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="request_count"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Requests
                                <.sort_icon
                                  field={:request_count}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="cost_usd"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Costo
                                <.sort_icon
                                  field={:cost_usd}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="prompt_tokens"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Tokens in
                                <.sort_icon
                                  field={:prompt_tokens}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="completion_tokens"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Tokens out
                                <.sort_icon
                                  field={:completion_tokens}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="avg_tps"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                TPS
                                <.sort_icon
                                  field={:avg_tps}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr
                            :for={row <- @breakdown_model}
                            id={"bd-model-#{row.model_id || "unknown"}"}
                          >
                            <td class="font-medium">
                              <%= if row.model_id do %>
                                <.link
                                  patch={
                                    ~p"/dashboard/stats/models?period=#{@period}&model_id=#{row.model_id}"
                                  }
                                  class="link link-hover"
                                >{row.model_name}</.link>
                              <% else %>
                                {row.model_name}
                              <% end %>
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(row.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.completion_tokens)}
                            </td>
                            <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                          </tr>
                        </tbody>
                        <tfoot>
                          <tr class="font-bold bg-base-200">
                            <td>Total · {length(@breakdown_model)} modelos</td>
                            <td class="text-right font-mono">
                              {format_number(model_total.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(model_total.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(model_total.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(model_total.completion_tokens)}
                            </td>
                            <td></td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      Sin datos para este periodo.
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% @live_action == :teams -> %>
          <div class="space-y-6">
            <div class="flex items-center justify-end flex-wrap gap-3">
              <.link
                href={
                  if @team_filter,
                    do:
                      "/dashboard/stats/export?type=teams&period=#{@period}&team_id=#{@team_filter}",
                    else: "/dashboard/stats/export?type=teams&period=#{@period}"
                }
                class="btn btn-sm btn-ghost"
                id="csv-teams"
              >
                <.icon name="hero-arrow-down-tray" class="w-4 h-4" /> CSV
              </.link>
            </div>

            <%= if @team_filter do %>
              <div class="space-y-6">
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                  <div
                    id="team-kpi-cost"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Costo</span>
                        <span class={[
                          "flex items-center justify-center w-9 h-9 rounded-lg",
                          accent_bg("accent")
                        ]}>
                          <.icon
                            name="hero-currency-dollar"
                            class={["w-5 h-5", accent_text("accent")]}
                          />
                        </span>
                      </div>
                      <p class="mt-2 text-2xl font-bold">
                        ${format_decimal(@metrics.cost_usd)}
                      </p>
                    </div>
                  </div>
                  <div
                    id="team-kpi-requests"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Requests</span>
                        <span class={[
                          "flex items-center justify-center w-9 h-9 rounded-lg",
                          accent_bg("primary")
                        ]}>
                          <.icon
                            name="hero-arrow-trending-up"
                            class={["w-5 h-5", accent_text("primary")]}
                          />
                        </span>
                      </div>
                      <p class="mt-2 text-2xl font-bold">
                        {format_number(@metrics.requests_total)}
                      </p>
                    </div>
                  </div>
                  <div
                    id="team-kpi-tokens"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Tokens</span>
                        <span class={[
                          "flex items-center justify-center w-9 h-9 rounded-lg",
                          accent_bg("primary")
                        ]}>
                          <.icon name="hero-cpu-chip" class={["w-5 h-5", accent_text("primary")]} />
                        </span>
                      </div>
                      <div class="mt-2 flex items-baseline gap-3">
                        <div>
                          <p
                            class="text-lg font-bold"
                            title={format_number(@metrics.prompt_tokens)}
                          >
                            {format_compact(@metrics.prompt_tokens)}
                          </p>
                          <p class="text-xs text-base-content/50">in</p>
                        </div>
                        <span class="text-base-content/30">/</span>
                        <div>
                          <p
                            class="text-lg font-bold"
                            title={format_number(@metrics.completion_tokens)}
                          >
                            {format_compact(@metrics.completion_tokens)}
                          </p>
                          <p class="text-xs text-base-content/50">out</p>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div id="team-kpi-tps" class="card bg-base-100 border border-base-300 shadow-sm">
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">TPS</span>
                        <span class={[
                          "flex items-center justify-center w-9 h-9 rounded-lg",
                          accent_bg("accent")
                        ]}>
                          <.icon name="hero-bolt" class={["w-5 h-5", accent_text("accent")]} />
                        </span>
                      </div>
                      <p class="mt-2 text-2xl font-bold">
                        {format_tps(@metrics.avg_tps)}
                      </p>
                    </div>
                  </div>
                </div>

                <%!-- Daily usage sparkline: models over time --%>
                <%= if @drilldown_series != [] do %>
                  <% pivoted = pivot_daily_series(@drilldown_series) %>
                  <% spark_max = daily_series_max(pivoted) %>
                  <% labels = @drilldown_series_labels %>

                  <div class="card bg-base-100 border border-base-300 shadow-sm">
                    <div class="card-body p-4 gap-2">
                      <div class="flex items-center justify-between">
                        <h2 class="card-title text-base">
                          <.icon name="hero-chart-bar" class="w-5 h-5 text-base-content/60" />
                          Uso diario por modelo
                        </h2>
                        <span class="text-[10px] text-base-content/40 hidden sm:inline">
                          {period_label(@period)}
                        </span>
                      </div>

                      <div class="flex gap-4 mt-2">
                        <%!-- Chart area --%>
                        <div class="flex-1">
                          <div class="flex items-end gap-px h-32 relative">
                            <div
                              :for={day <- pivoted.days}
                              class="flex-1 flex flex-col items-center justify-end h-full group relative"
                            >
                              <%!-- Tooltip --%>
                              <div class="hidden group-hover:block absolute -top-1 -translate-y-full left-1/2 -translate-x-1/2 z-20 pointer-events-none">
                                <div class="bg-base-300 text-base-content text-[10px] rounded-md px-2 py-1 shadow-lg whitespace-nowrap">
                                  <div class="font-semibold">{Calendar.strftime(day, "%d %b")}</div>
                                  <div :for={label <- labels} class="flex justify-between gap-2">
                                    <span class="truncate max-w-[100px]">{label}</span>
                                    <span class="tabular-nums">
                                      {format_number(Map.get(pivoted.series[label] || %{}, day, 0))}
                                    </span>
                                  </div>
                                </div>
                              </div>

                              <%!-- Stacked bar --%>
                              <div class="w-full flex flex-col-reverse rounded-t overflow-hidden">
                                <div
                                  :for={label <- labels}
                                  class={["w-full", sparkline_color(Enum.find_index(labels, &(&1 == label)) || 0)]}
                                  style={"height: #{sparkline_bar_height(Map.get(pivoted.series[label] || %{}, day, 0), spark_max)}%"}
                                  title={"#{label}: #{format_number(Map.get(pivoted.series[label] || %{}, day, 0))}"}
                                />
                              </div>
                            </div>
                          </div>

                          <%!-- Day labels --%>
                          <div class="flex gap-px mt-1">
                            <span
                              :for={day <- pivoted.days}
                              class="flex-1 text-center text-[9px] text-base-content/40"
                            >
                              {Calendar.strftime(day, "%d")}
                            </span>
                          </div>
                        </div>

                        <%!-- Legend --%>
                        <div class="w-40 shrink-0 border-l border-base-300 pl-3">
                          <div class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wide mb-2">
                            Modelos
                          </div>
                          <div class="space-y-1.5">
                            <div :for={{label, idx} <- Enum.with_index(labels)} class="flex items-center gap-1.5">
                              <span class={["w-2 h-2 rounded-sm shrink-0", sparkline_color(idx)]} />
                              <span class="text-[10px] truncate flex-1">{label}</span>
                              <span class="text-[9px] text-base-content/50 shrink-0">
                                {format_number(sparkline_label_total(pivoted.series[label] || %{}))}
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>

                <div class="card bg-base-100 border border-base-300 shadow-sm">
                  <div class="card-body">
                    <h2 class="card-title text-base">
                      <.icon name="hero-rectangle-stack" class="w-5 h-5 text-base-content/60" />
                      Modelos usados
                    </h2>
                    <%= if has_data?(@breakdown_model) do %>
                      <% model_total = breakdown_total(@breakdown_model) %>
                      <div class="overflow-x-auto mt-3">
                        <table class="table table-sm table-zebra">
                          <thead>
                            <tr>
                              <th>
                                <button
                                  phx-click="sort"
                                  phx-value-field="model_name"
                                  class="flex items-center gap-1 hover:text-primary"
                                >
                                  Modelo
                                  <.sort_icon
                                    field={:model_name}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="request_count"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Requests
                                  <.sort_icon
                                    field={:request_count}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="cost_usd"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Costo
                                  <.sort_icon
                                    field={:cost_usd}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="prompt_tokens"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Tokens in
                                  <.sort_icon
                                    field={:prompt_tokens}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="completion_tokens"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Tokens out
                                  <.sort_icon
                                    field={:completion_tokens}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="avg_tps"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  TPS
                                  <.sort_icon
                                    field={:avg_tps}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr
                              :for={row <- @breakdown_model}
                              id={"bd-team-model-#{row.model_id || "unknown"}"}
                            >
                              <td class="font-medium">
                                <%= if row.model_id do %>
                                  <.link
                                    patch={
                                      ~p"/dashboard/stats/models?period=#{@period}&model_id=#{row.model_id}"
                                    }
                                    class="link link-hover"
                                  >{row.model_name}</.link>
                                <% else %>
                                  {row.model_name}
                                <% end %>
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(row.cost_usd)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.prompt_tokens)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.completion_tokens)}
                              </td>
                              <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                            </tr>
                          </tbody>
                          <tfoot>
                            <tr class="font-bold bg-base-200">
                              <td>Total · {length(@breakdown_model)} modelos</td>
                              <td class="text-right font-mono">
                                {format_number(model_total.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(model_total.cost_usd)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(model_total.prompt_tokens)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(model_total.completion_tokens)}
                              </td>
                              <td></td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>
                    <% else %>
                      <p class="text-sm text-base-content/40 py-6 text-center">
                        Sin datos para este periodo.
                      </p>
                    <% end %>
                  </div>
                </div>
                <div class="card bg-base-100 border border-base-300 shadow-sm">
                  <div class="card-body">
                    <h2 class="card-title text-base">
                      <.icon name="hero-user" class="w-5 h-5 text-base-content/60" />
                      Miembros del equipo
                    </h2>
                    <%= if has_data?(@breakdown_member) do %>
                      <% member_total = breakdown_total(@breakdown_member) %>
                      <div class="overflow-x-auto mt-3">
                        <table class="table table-sm table-zebra">
                          <thead>
                            <tr>
                              <th>
                                <button
                                  phx-click="sort"
                                  phx-value-field="user_email"
                                  class="flex items-center gap-1 hover:text-primary"
                                >
                                  Usuario
                                  <.sort_icon
                                    field={:user_email}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="request_count"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Requests
                                  <.sort_icon
                                    field={:request_count}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="cost_usd"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Costo
                                  <.sort_icon
                                    field={:cost_usd}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="prompt_tokens"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Tokens in
                                  <.sort_icon
                                    field={:prompt_tokens}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="completion_tokens"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Tokens out
                                  <.sort_icon
                                    field={:completion_tokens}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="avg_tps"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  TPS
                                  <.sort_icon
                                    field={:avg_tps}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr
                              :for={row <- @breakdown_member}
                              id={"bd-team-member-#{row.team_member_id}"}
                            >
                              <td class="font-mono text-sm">
                                <.link
                                  navigate={~p"/dashboard/users/#{row.user_id}/stats"}
                                  class="link link-hover"
                                >
                                  {row.user_email}
                                </.link>
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(row.cost_usd)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.prompt_tokens)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.completion_tokens)}
                              </td>
                              <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                            </tr>
                          </tbody>
                          <tfoot>
                            <tr class="font-bold bg-base-200">
                              <td>Total · {distinct_users(@breakdown_member)} usuarios</td>
                              <td class="text-right font-mono">
                                {format_number(member_total.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(member_total.cost_usd)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(member_total.prompt_tokens)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(member_total.completion_tokens)}
                              </td>
                              <td></td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>
                    <% else %>
                      <p class="text-sm text-base-content/40 py-6 text-center">
                        Sin datos para este periodo.
                      </p>
                    <% end %>
                  </div>
                </div>
                <button
                  phx-click="clear_team_filter"
                  class="btn btn-sm btn-ghost"
                  id="clear-team-filter"
                >
                  <.icon name="hero-x-mark" class="w-4 h-4" /> Quitar filtro de equipo
                </button>
              </div>
            <% else %>
              <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                  <h2 class="card-title text-base">
                    <.icon name="hero-user-group" class="w-5 h-5 text-base-content/60" />
                    Todos los equipos
                  </h2>
                  <%= if has_data?(@breakdown_team) do %>
                    <% team_total = breakdown_total(@breakdown_team) %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm table-zebra">
                        <thead>
                          <tr>
                            <th>
                              <button
                                phx-click="sort"
                                phx-value-field="team_name"
                                class="flex items-center gap-1 hover:text-primary"
                              >
                                Equipo
                                <.sort_icon
                                  field={:team_name}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="request_count"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Requests
                                <.sort_icon
                                  field={:request_count}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="cost_usd"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Costo
                                <.sort_icon
                                  field={:cost_usd}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="prompt_tokens"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Tokens in
                                <.sort_icon
                                  field={:prompt_tokens}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="completion_tokens"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Tokens out
                                <.sort_icon
                                  field={:completion_tokens}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="avg_tps"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                TPS
                                <.sort_icon
                                  field={:avg_tps}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr :for={row <- @breakdown_team} id={"bd-team-#{row.team_id}"}>
                            <td class="font-medium">
                              <.link
                                patch={
                                  ~p"/dashboard/stats/teams?period=#{@period}&team_id=#{row.team_id}"
                                }
                                class="link link-hover"
                              >{row.team_name}</.link>
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(row.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.completion_tokens)}
                            </td>
                            <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                          </tr>
                        </tbody>
                        <tfoot>
                          <tr class="font-bold bg-base-200">
                            <td>Total · {length(@breakdown_team)} equipos</td>
                            <td class="text-right font-mono">
                              {format_number(team_total.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(team_total.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(team_total.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(team_total.completion_tokens)}
                            </td>
                            <td></td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      Sin datos para este periodo.
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% @live_action == :services -> %>
          <div class="space-y-6">
            <div class="flex items-center justify-end flex-wrap gap-3">
              <.link
                href="/dashboard/stats/export?type=services&period=#{@period}"
                class="btn btn-sm btn-ghost"
                id="csv-services"
              >
                <.icon name="hero-arrow-down-tray" class="w-4 h-4" /> CSV
              </.link>
            </div>

            <%= if @service_filter do %>
              <div class="space-y-6">
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                  <div
                    id="service-kpi-cost"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Costo</span>
                        <span class={[
                          "flex items-center justify-center w-9 h-9 rounded-lg",
                          accent_bg("accent")
                        ]}>
                          <.icon
                            name="hero-currency-dollar"
                            class={["w-5 h-5", accent_text("accent")]}
                          />
                        </span>
                      </div>
                      <p class="mt-2 text-2xl font-bold">
                        ${format_decimal(@metrics.cost_usd)}
                      </p>
                    </div>
                  </div>
                  <div
                    id="service-kpi-requests"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Requests</span>
                        <span class={[
                          "flex items-center justify-center w-9 h-9 rounded-lg",
                          accent_bg("primary")
                        ]}>
                          <.icon
                            name="hero-arrow-trending-up"
                            class={["w-5 h-5", accent_text("primary")]}
                          />
                        </span>
                      </div>
                      <p class="mt-2 text-2xl font-bold">
                        {format_number(@metrics.requests_total)}
                      </p>
                    </div>
                  </div>
                  <div
                    id="service-kpi-tokens"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Tokens</span>
                        <span class={[
                          "flex items-center justify-center w-9 h-9 rounded-lg",
                          accent_bg("primary")
                        ]}>
                          <.icon name="hero-cpu-chip" class={["w-5 h-5", accent_text("primary")]} />
                        </span>
                      </div>
                      <div class="mt-2 flex items-baseline gap-3">
                        <div>
                          <p
                            class="text-lg font-bold"
                            title={format_number(@metrics.prompt_tokens)}
                          >
                            {format_compact(@metrics.prompt_tokens)}
                          </p>
                          <p class="text-xs text-base-content/50">in</p>
                        </div>
                        <span class="text-base-content/30">/</span>
                        <div>
                          <p
                            class="text-lg font-bold"
                            title={format_number(@metrics.completion_tokens)}
                          >
                            {format_compact(@metrics.completion_tokens)}
                          </p>
                          <p class="text-xs text-base-content/50">out</p>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    id="service-kpi-tps"
                    class="card bg-base-100 border border-base-300 shadow-sm"
                  >
                    <div class="card-body p-5">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">TPS</span>
                        <span class={[
                          "flex items-center justify-center w-9 h-9 rounded-lg",
                          accent_bg("accent")
                        ]}>
                          <.icon name="hero-bolt" class={["w-5 h-5", accent_text("accent")]} />
                        </span>
                      </div>
                      <p class="mt-2 text-2xl font-bold">
                        {format_tps(@metrics.avg_tps)}
                      </p>
                    </div>
                  </div>
                </div>

                <%!-- Daily usage sparkline: models over time --%>
                <%= if @drilldown_series != [] do %>
                  <% pivoted = pivot_daily_series(@drilldown_series) %>
                  <% spark_max = daily_series_max(pivoted) %>
                  <% labels = @drilldown_series_labels %>

                  <div class="card bg-base-100 border border-base-300 shadow-sm">
                    <div class="card-body p-4 gap-2">
                      <div class="flex items-center justify-between">
                        <h2 class="card-title text-base">
                          <.icon name="hero-chart-bar" class="w-5 h-5 text-base-content/60" />
                          Uso diario por modelo
                        </h2>
                        <span class="text-[10px] text-base-content/40 hidden sm:inline">
                          {period_label(@period)}
                        </span>
                      </div>

                      <div class="flex gap-4 mt-2">
                        <%!-- Chart area --%>
                        <div class="flex-1">
                          <div class="flex items-end gap-px h-32 relative">
                            <div
                              :for={day <- pivoted.days}
                              class="flex-1 flex flex-col items-center justify-end h-full group relative"
                            >
                              <%!-- Tooltip --%>
                              <div class="hidden group-hover:block absolute -top-1 -translate-y-full left-1/2 -translate-x-1/2 z-20 pointer-events-none">
                                <div class="bg-base-300 text-base-content text-[10px] rounded-md px-2 py-1 shadow-lg whitespace-nowrap">
                                  <div class="font-semibold">{Calendar.strftime(day, "%d %b")}</div>
                                  <div :for={label <- labels} class="flex justify-between gap-2">
                                    <span class="truncate max-w-[100px]">{label}</span>
                                    <span class="tabular-nums">
                                      {format_number(Map.get(pivoted.series[label] || %{}, day, 0))}
                                    </span>
                                  </div>
                                </div>
                              </div>

                              <%!-- Stacked bar --%>
                              <div class="w-full flex flex-col-reverse rounded-t overflow-hidden">
                                <div
                                  :for={label <- labels}
                                  class={["w-full", sparkline_color(Enum.find_index(labels, &(&1 == label)) || 0)]}
                                  style={"height: #{sparkline_bar_height(Map.get(pivoted.series[label] || %{}, day, 0), spark_max)}%"}
                                  title={"#{label}: #{format_number(Map.get(pivoted.series[label] || %{}, day, 0))}"}
                                />
                              </div>
                            </div>
                          </div>

                          <%!-- Day labels --%>
                          <div class="flex gap-px mt-1">
                            <span
                              :for={day <- pivoted.days}
                              class="flex-1 text-center text-[9px] text-base-content/40"
                            >
                              {Calendar.strftime(day, "%d")}
                            </span>
                          </div>
                        </div>

                        <%!-- Legend --%>
                        <div class="w-40 shrink-0 border-l border-base-300 pl-3">
                          <div class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wide mb-2">
                            Modelos
                          </div>
                          <div class="space-y-1.5">
                            <div :for={{label, idx} <- Enum.with_index(labels)} class="flex items-center gap-1.5">
                              <span class={["w-2 h-2 rounded-sm shrink-0", sparkline_color(idx)]} />
                              <span class="text-[10px] truncate flex-1">{label}</span>
                              <span class="text-[9px] text-base-content/50 shrink-0">
                                {format_number(sparkline_label_total(pivoted.series[label] || %{}))}
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>

                <div class="card bg-base-100 border border-base-300 shadow-sm">
                  <div class="card-body">
                    <h2 class="card-title text-base">
                      <.icon name="hero-rectangle-stack" class="w-5 h-5 text-base-content/60" />
                      Modelos usados
                    </h2>
                    <%= if has_data?(@breakdown_model) do %>
                      <% model_total = breakdown_total(@breakdown_model) %>
                      <div class="overflow-x-auto mt-3">
                        <table class="table table-sm table-zebra">
                          <thead>
                            <tr>
                              <th>
                                <button
                                  phx-click="sort"
                                  phx-value-field="model_name"
                                  class="flex items-center gap-1 hover:text-primary"
                                >
                                  Modelo
                                  <.sort_icon
                                    field={:model_name}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="request_count"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Requests
                                  <.sort_icon
                                    field={:request_count}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="cost_usd"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Costo
                                  <.sort_icon
                                    field={:cost_usd}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="prompt_tokens"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Tokens in
                                  <.sort_icon
                                    field={:prompt_tokens}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="completion_tokens"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  Tokens out
                                  <.sort_icon
                                    field={:completion_tokens}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                              <th class="text-right">
                                <button
                                  phx-click="sort"
                                  phx-value-field="avg_tps"
                                  class="flex items-center justify-end gap-1 hover:text-primary"
                                >
                                  TPS
                                  <.sort_icon
                                    field={:avg_tps}
                                    current={@sort_field}
                                    direction={@sort_direction}
                                  />
                                </button>
                              </th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr
                              :for={row <- @breakdown_model}
                              id={"bd-service-model-#{row.model_id || "unknown"}"}
                            >
                              <td class="font-medium">
                                <%= if row.model_id do %>
                                  <.link
                                    patch={
                                      ~p"/dashboard/stats/models?period=#{@period}&model_id=#{row.model_id}"
                                    }
                                    class="link link-hover"
                                  >{row.model_name}</.link>
                                <% else %>
                                  {row.model_name}
                                <% end %>
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(row.cost_usd)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.prompt_tokens)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(row.completion_tokens)}
                              </td>
                              <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                            </tr>
                          </tbody>
                          <tfoot>
                            <tr class="font-bold bg-base-200">
                              <td>Total · {length(@breakdown_model)} modelos</td>
                              <td class="text-right font-mono">
                                {format_number(model_total.request_count)}
                              </td>
                              <td class="text-right font-mono">
                                ${format_decimal(model_total.cost_usd)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(model_total.prompt_tokens)}
                              </td>
                              <td class="text-right font-mono">
                                {format_number(model_total.completion_tokens)}
                              </td>
                              <td></td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>
                    <% else %>
                      <p class="text-sm text-base-content/40 py-6 text-center">
                        Sin datos para este periodo.
                      </p>
                    <% end %>
                  </div>
                </div>
                <button
                  phx-click="clear_service_filter"
                  class="btn btn-sm btn-ghost"
                  id="clear-service-filter"
                >
                  <.icon name="hero-x-mark" class="w-4 h-4" /> Quitar filtro de servicio
                </button>
              </div>
            <% else %>
              <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                  <h2 class="card-title text-base">
                    <.icon name="hero-wrench-screwdriver" class="w-5 h-5 text-base-content/60" />
                    Todos los servicios
                  </h2>
                  <%= if has_data?(@breakdown_service) do %>
                    <% service_total = breakdown_total(@breakdown_service) %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm table-zebra">
                        <thead>
                          <tr>
                            <th>
                              <button
                                phx-click="sort"
                                phx-value-field="service_name"
                                class="flex items-center gap-1 hover:text-primary"
                              >
                                Servicio
                                <.sort_icon
                                  field={:service_name}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="request_count"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Requests
                                <.sort_icon
                                  field={:request_count}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="cost_usd"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Costo
                                <.sort_icon
                                  field={:cost_usd}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="prompt_tokens"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Tokens in
                                <.sort_icon
                                  field={:prompt_tokens}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="completion_tokens"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                Tokens out
                                <.sort_icon
                                  field={:completion_tokens}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                            <th class="text-right">
                              <button
                                phx-click="sort"
                                phx-value-field="avg_tps"
                                class="flex items-center justify-end gap-1 hover:text-primary"
                              >
                                TPS
                                <.sort_icon
                                  field={:avg_tps}
                                  current={@sort_field}
                                  direction={@sort_direction}
                                />
                              </button>
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr :for={row <- @breakdown_service} id={"bd-service-#{row.service_id}"}>
                            <td class="font-medium">
                              <.link
                                patch={
                                  ~p"/dashboard/stats/services?period=#{@period}&service_id=#{row.service_id}"
                                }
                                class="link link-hover"
                              >{row.service_name}</.link>
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(row.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.completion_tokens)}
                            </td>
                            <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                          </tr>
                        </tbody>
                        <tfoot>
                          <tr class="font-bold bg-base-200">
                            <td>Total · {length(@breakdown_service)} servicios</td>
                            <td class="text-right font-mono">
                              {format_number(service_total.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(service_total.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(service_total.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(service_total.completion_tokens)}
                            </td>
                            <td></td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      Sin datos para este periodo.
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% @live_action == :member -> %>
          <div class="space-y-6">
            <%= if @member do %>
              <div class="flex items-center justify-between flex-wrap gap-3">
                <div>
                  <h1 class="text-xl font-bold">
                    {@member.user.email}
                  </h1>
                  <p class="text-sm text-base-content/60">
                    Equipo: {@member.team.name} · Rol: {@member.team_role}
                  </p>
                </div>
                <.link
                  patch={~p"/dashboard/stats/teams?period=#{@period}&team_id=#{@member.team_id}"}
                  class="btn btn-sm btn-ghost"
                  id="back-to-team"
                >
                  <.icon name="hero-arrow-left" class="w-4 h-4" /> Volver al equipo
                </.link>
              </div>

              <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                  <h2 class="card-title text-base">
                    <.icon name="hero-rectangle-stack" class="w-5 h-5 text-base-content/60" />
                    Modelos usados
                  </h2>
                  <%= if @member_models != [] do %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm table-zebra">
                        <thead>
                          <tr>
                            <th>Modelo</th>
                            <th class="text-right">Requests</th>
                            <th class="text-right">Costo</th>
                            <th class="text-right">Tokens in</th>
                            <th class="text-right">Tokens out</th>
                            <th class="text-right">TPS</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr
                            :for={row <- @member_models}
                            id={"member-model-#{row.model_id || "unknown"}"}
                          >
                            <td class="font-medium truncate max-w-[200px]">
                              <%= if row.model_id do %>
                                <.link
                                  navigate={
                                    ~p"/dashboard/stats/models?period=#{@period}&model_id=#{row.model_id}"
                                  }
                                  class="link link-hover"
                                >{row.model_name}</.link>
                              <% else %>
                                {row.model_name}
                              <% end %>
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(row.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.completion_tokens)}
                            </td>
                            <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      Sin actividad en este período.
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
      <% end %>
    </div>
  </div>
</Layouts.dashboard>
