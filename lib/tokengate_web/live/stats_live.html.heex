<Layouts.dashboard
  flash={@flash}
  current_scope={@current_user}
  impersonator={@impersonator}
  current_path={@current_path}
>
  <div class="space-y-6">
    <%!-- Header + period selector (hidden on credits: budgets are live
         calendar-day/month counters, not a rolling window) --%>
    <div class="flex items-center justify-between flex-wrap gap-4">
      <.header>
        Estadísticas
        <:subtitle>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-funnel" class="w-4 h-4 text-base-content/50" />
            {@scope_label}
          </span>
        </:subtitle>
      </.header>

      <%!-- Selector de período: solo en las tabs de datos. "En vivo" es una
           ventana fija (última hora + hoy), no un rango elegible; en su lugar
           el header muestra el estado de la actualización automática. --%>
      <div :if={@live_action not in [:live, :credits]} class="flex items-center gap-3">
        <span
          :if={@stats_loading}
          class="loading loading-spinner loading-sm text-primary"
          id="stats-loading"
          title="Actualizando estadísticas…"
        ></span>
        <div class="join" id="period-selector" role="tablist">
          <button
            :for={period <- ~w(today week month 30d 90d)}
            phx-click="set_period"
            phx-value-period={period}
            class={[
              "join-item btn btn-sm",
              if(period_active?(@period, period), do: "btn-primary", else: "btn-ghost")
            ]}
            id={"period-#{period}"}
          >
            {period_label(period)}
          </button>
        </div>
      </div>

      <%!-- "En vivo": mismo lugar del header que ocupaban los timeframes --%>
      <div
        :if={@live_action == :live}
        class="flex items-center gap-3 text-xs"
        id="live-status"
      >
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-60"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-success"></span>
        </span>
        <span class="text-base-content/60">
          En vivo · actualización automática
        </span>
        <span class="text-base-content/40 tabular-nums" id="live-last-sync">
          {Stats.format_dt(@last_sync_at)}
        </span>
      </div>
    </div>

    <%!-- Nav tabs between the views --%>
    <div class="join" id="stats-nav" role="tablist">
      <.link
        patch={~p"/stats"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :live, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-live"
      >
        <span class="relative inline-flex w-4 h-4 items-center justify-center">
          <span class="absolute w-2 h-2 rounded-full bg-success animate-pulse"></span>
        </span>
        En vivo
      </.link>
      <.link
        patch={~p"/stats/overview?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :index, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-overview"
      >
        <.icon name="hero-chart-bar-square" class="w-4 h-4" /> Resumen
      </.link>
      <.link
        patch={~p"/stats/providers?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action in [:providers, :provider], do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-providers"
      >
        <.icon name="hero-server-stack" class="w-4 h-4" /> Proveedores
      </.link>
      <.link
        patch={~p"/stats/models?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action in [:models, :model], do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-models"
      >
        <.icon name="hero-rectangle-stack" class="w-4 h-4" /> Modelos
      </.link>
      <.link
        patch={~p"/stats/profiles?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action in [:groups, :group], do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-groups"
      >
        <.icon name="hero-user-group" class="w-4 h-4" /> Perfiles de límites
      </.link>
      <.link
        patch={~p"/stats/users?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :users, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-users"
      >
        <.icon name="hero-users" class="w-4 h-4" /> Usuarios
      </.link>
      <.link
        patch={~p"/stats/services?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :services, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-services"
      >
        <.icon name="hero-wrench-screwdriver" class="w-4 h-4" /> Servicios
      </.link>
    </div>

    <div
      class={[
        "transition-opacity duration-200",
        @stats_loading && "opacity-50 pointer-events-none"
      ]}
      id="stats-content"
    >
      <%= cond do %>
        <% @live_action == :live -> %>
          <.live
            pulse={@pulse}
            today_metrics={@today_metrics}
            org_budget={@org_budget}
            minute_series={@minute_series}
            minute_series_max={@minute_series_max}
            minute_tokens_max={@minute_tokens_max}
            minute_cost_max={@minute_cost_max}
            inflight_count={@inflight_count}
            day_by_hour={@day_by_hour}
            last_sync_at={@last_sync_at}
            timezone={@timezone}
            budget_reset_hours={@budget_reset_hours}
            budget_reset_minutes={@budget_reset_minutes}
            budget_reset_at={@budget_reset_at}
            stats_loading={@stats_loading}
            streams={@streams}
          />
        <% @live_action == :index -> %>
          <.index
            metrics={@metrics}
            peak_concurrency={@peak_concurrency}
            busiest_hours={@busiest_hours}
            busiest_minutes={@busiest_minutes}
            hour_usage_by_provider={@hour_usage_by_provider}
            model_provider_stacked={@model_provider_stacked}
            period={@period}
            timezone={@timezone}
            budget_reset_hours={@budget_reset_hours}
            budget_reset_minutes={@budget_reset_minutes}
            budget_reset_at={@budget_reset_at}
            current_user={@current_user}
          />
        <% @live_action == :providers -> %>
          <.providers
            provider_ranking={@provider_ranking}
            period={@period}
            per_page={@per_page}
            shown_counts={@shown_counts}
            list_search={@list_search}
          />
        <% @live_action == :provider -> %>
          <.provider
            provider={@provider}
            provider_ranking={@provider_ranking}
            provider_metrics={@provider_metrics}
            breakdown_model={@breakdown_model}
            breakdown_user={@breakdown_user}
            breakdown_service={@breakdown_service}
            breakdown_group={@breakdown_group}
            show_services={@current_user.global_role == "admin"}
            period={@period}
            per_page={@per_page}
            shown_counts={@shown_counts}
            stats_loading={@stats_loading}
          />
        <% @live_action in [:models, :model] -> %>
          <%= if @model_filter do %>
            <%!-- Detalle del modelo: la MISMA vista para la ruta propia
                 (/stats/models/:id, action :model) y para el alias ?model_id= --%>
            <.model
              model={@model}
              model_ranking={@model_ranking}
              metrics={@metrics}
              breakdown_provider={@breakdown_provider}
              breakdown_group={@breakdown_group}
              breakdown_member={@breakdown_member}
              drilldown_series={@drilldown_series}
              drilldown_series_labels={@drilldown_series_labels}
              period={@period}
              sort_field={@sort_field}
              sort_direction={@sort_direction}
              per_page={@per_page}
              shown_counts={@shown_counts}
              stats_loading={@stats_loading}
            />
          <% else %>
            <.models
              breakdown_model={@breakdown_model}
              period={@period}
              sort_field={@sort_field}
              sort_direction={@sort_direction}
              per_page={@per_page}
              shown_counts={@shown_counts}
              list_search={@list_search}
            />
          <% end %>
        <% @live_action == :groups -> %>
          <.groups
            metrics={@metrics}
            breakdown_group={@breakdown_group}
            group_budgets={@group_budgets}
            breakdown_member={@breakdown_member}
            breakdown_model={@breakdown_model}
            drilldown_series={@drilldown_series}
            drilldown_series_labels={@drilldown_series_labels}
            group_filter={@group_filter}
            group={@group}
            list_search={@list_search}
            period={@period}
            sort_field={@sort_field}
            sort_direction={@sort_direction}
            per_page={@per_page}
            shown_counts={@shown_counts}
          />
        <% @live_action == :services -> %>
          <.services
            metrics={@metrics}
            breakdown_service={@breakdown_service}
            service_budgets={@service_budgets}
            breakdown_model={@breakdown_model}
            drilldown_series={@drilldown_series}
            drilldown_series_labels={@drilldown_series_labels}
            service_filter={@service_filter}
            list_search={@list_search}
            period={@period}
            sort_field={@sort_field}
            sort_direction={@sort_direction}
            per_page={@per_page}
            shown_counts={@shown_counts}
          />
        <% @live_action == :users -> %>
          <.users
            breakdown_user={@breakdown_user}
            budgets_by_user={@budgets_by_user}
            period={@period}
            sort_field={@sort_field}
            sort_direction={@sort_direction}
            per_page={@per_page}
            shown_counts={@shown_counts}
            list_search={@list_search}
          />
        <% @live_action == :group -> %>
          <.groups
            metrics={@metrics}
            breakdown_group={@breakdown_group}
            group_budgets={@group_budgets}
            group_budget={@group_budget}
            breakdown_member={@breakdown_member}
            breakdown_model={@breakdown_model}
            drilldown_series={@drilldown_series}
            drilldown_series_labels={@drilldown_series_labels}
            group_filter={@group_id}
            list_search={@list_search}
            period={@period}
            sort_field={@sort_field}
            sort_direction={@sort_direction}
            per_page={@per_page}
            shown_counts={@shown_counts}
          />
      <% end %>
    </div>
  </div>
</Layouts.dashboard>
