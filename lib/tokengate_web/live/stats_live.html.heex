<Layouts.dashboard
  flash={@flash}
  current_scope={@current_user}
  impersonator={@impersonator}
  current_path={@current_path}
>
  <div class="space-y-6">
    <%!-- Header + period selector (hidden on credits: budgets are live
         calendar-day/month counters, not a rolling window) --%>
    <div class="flex items-center justify-between flex-wrap gap-4">
      <.header>
        {gettext("Statistics")}
        <:subtitle>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-funnel" class="w-4 h-4 text-base-content/50" />
            {@scope_label}
          </span>
        </:subtitle>
      </.header>

      <%!-- Selector de período: solo en las tabs de datos. "En vivo" es una
           ventana fija (última hora + hoy), no un rango elegible; en su lugar
           el header muestra el estado de la actualización automática. --%>
      <div :if={@live_action not in [:live, :credits]} class="flex items-center gap-3">
        <span
          :if={@stats_loading}
          class="loading loading-spinner loading-sm text-primary"
          id="stats-loading"
          title={gettext("Updating statistics…")}
        ></span>
        <.period_selector target={period_target(assigns)} period={@period} id="period-selector" />
      </div>

      <%!-- "En vivo": mismo lugar del header que ocupaban los timeframes --%>
      <div
        :if={@live_action == :live}
        class="flex items-center gap-3 text-xs"
        id="live-status"
      >
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-60"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-success"></span>
        </span>
        <span class="text-base-content/60">
          {gettext("Live · auto-refresh")}
        </span>
        <span class="text-base-content/40 tabular-nums" id="live-last-sync">
          {Stats.format_dt(@last_sync_at)}
        </span>
      </div>
    </div>

    <%!-- Nav tabs between the views --%>
    <div class="join" id="stats-nav" role="tablist">
      <.link
        patch={~p"/stats"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :live, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-live"
      >
        <span class="relative inline-flex w-4 h-4 items-center justify-center">
          <span class="absolute w-2 h-2 rounded-full bg-success animate-pulse"></span>
        </span>
        {gettext("Live")}
      </.link>
      <.link
        patch={~p"/stats/overview?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :index, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-overview"
      >
        <.icon name="hero-chart-bar-square" class="w-4 h-4" /> {gettext("Overview")}
      </.link>
      <.link
        patch={~p"/stats/providers?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action in [:providers, :provider], do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-providers"
      >
        <.icon name="hero-server-stack" class="w-4 h-4" /> {gettext("Providers")}
      </.link>
      <.link
        patch={~p"/stats/models?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action in [:models, :model], do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-models"
      >
        <.icon name="hero-rectangle-stack" class="w-4 h-4" /> {gettext("Models")}
      </.link>
      <.link
        patch={~p"/stats/agents?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :agents, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-agents"
      >
        <.icon name="hero-command-line" class="w-4 h-4" /> {gettext("Agents")}
      </.link>
      <.link
        patch={~p"/stats/profiles?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action in [:groups, :group], do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-groups"
      >
        <.icon name="hero-user-group" class="w-4 h-4" /> {gettext("Limit profiles")}
      </.link>
      <.link
        patch={~p"/stats/users?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :users, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-users"
      >
        <.icon name="hero-users" class="w-4 h-4" /> {gettext("Users")}
      </.link>
      <.link
        patch={~p"/stats/services?period=#{@period}"}
        class={[
          "join-item btn btn-sm",
          if(@live_action == :services, do: "btn-primary", else: "btn-ghost")
        ]}
        id="nav-services"
      >
        <.icon name="hero-wrench-screwdriver" class="w-4 h-4" /> {gettext("Services")}
      </.link>
    </div>

    <div
      class={[
        "transition-opacity duration-200",
        @stats_loading && "opacity-50 pointer-events-none"
      ]}
      id="stats-content"
    >
      <div
        :if={@load_error || assigns[:counters_error]}
        id="stats-load-error"
        class="alert alert-warning mb-4 text-sm"
        role="alert"
      >
        <.icon name="hero-exclamation-triangle" class="w-5 h-5 shrink-0" />
        <span>
          {gettext("Could not load this period. The data below is from the previous period.")}
        </span>
      </div>
      <%= cond do %>
        <% @live_action == :live -> %>
          <.live
            pulse={@pulse}
            today_metrics={@today_metrics}
            org_budget={@org_budget}
            minute_series={@minute_series}
            minute_series_max={@minute_series_max}
            minute_tokens_max={@minute_tokens_max}
            minute_cost_max={@minute_cost_max}
            inflight_count={@inflight_count}
            day_by_hour={@day_by_hour}
            last_sync_at={@last_sync_at}
            timezone={@timezone}
            stats_loading={@stats_loading}
            streams={@streams}
          />
        <% @live_action == :index -> %>
          <.index
            metrics={@metrics}
            peak_concurrency={@peak_concurrency}
            busiest_hours={@busiest_hours}
            busiest_minutes={@busiest_minutes}
            hour_usage_by_provider={@hour_usage_by_provider}
            model_provider_stacked={@model_provider_stacked}
            period={@period}
            timezone={@timezone}
            current_user={@current_user}
          />
        <% @live_action == :providers -> %>
          <.providers
            provider_ranking={@provider_ranking}
            period={@period}
            per_page={@per_page}
            shown_counts={@shown_counts}
            list_search={@list_search}
          />
        <% @live_action == :agents -> %>
          <div class="space-y-6">
            <div class="card bg-base-100 border border-base-300 shadow-sm" id="agent-ranking">
              <div class="card-body">
                <h2 class="card-title text-base">
                  <.icon name="hero-command-line" class="w-5 h-5 text-base-content/60" /> {gettext(
                    "Agents"
                  )}
                </h2>
                <p class="text-xs text-base-content/60">
                  {gettext(
                    "One row per coding agent identified from its client identity (X-Agent-Type / User-Agent), with its consumption for the period (%{period}).",
                    period: Stats.period_label(@period)
                  )}
                </p>
                <div class="mt-3 overflow-x-auto">
                  <.table
                    id="agents-table"
                    rows={@agent_ranking}
                    row_id={fn row -> "agent-row-#{row.key}" end}
                    sort_field={@sort_field}
                    sort_direction={@sort_direction}
                    sort_event="sort"
                  >
                    <:col :let={row} label={gettext("Agent")} field={:label}>
                      <div class="min-w-0">
                        <div class="font-medium truncate" title={row.key}>{row.label}</div>
                        <div class="text-[10px] uppercase tracking-wide text-base-content/40">
                          {row.family}
                        </div>
                      </div>
                    </:col>
                    <:col
                      :let={row}
                      label={gettext("Requests")}
                      field={:request_count}
                      align="right"
                    >
                      <span class="font-mono tabular-nums">
                        {Stats.format_number(row.request_count)}
                      </span>
                    </:col>
                    <:col :let={row} label={gettext("Cost")} field={:cost_usd} align="right">
                      <span class="font-mono tabular-nums">
                        ${Stats.format_decimal(row.cost_usd)}
                      </span>
                    </:col>
                    <:col
                      :let={row}
                      label={gettext("Share")}
                      field={:share}
                      align="right"
                      tooltip={gettext("Share of the period's cost")}
                    >
                      <span class="font-mono tabular-nums">{Stats.format_percent(row.share)}</span>
                    </:col>
                    <:col
                      :let={row}
                      label={gettext("Tokens in")}
                      field={:prompt_tokens}
                      align="right"
                    >
                      <span class="font-mono tabular-nums">
                        {Stats.format_number(row.prompt_tokens)}
                      </span>
                    </:col>
                    <:col
                      :let={row}
                      label={gettext("Tokens out")}
                      field={:completion_tokens}
                      align="right"
                    >
                      <span class="font-mono tabular-nums">
                        {Stats.format_number(row.completion_tokens)}
                      </span>
                    </:col>
                    <:col
                      :let={row}
                      label={gettext("Latency")}
                      field={:avg_latency_ms}
                      align="right"
                    >
                      <span class="font-mono tabular-nums">
                        {Stats.format_ms(row.avg_latency_ms)}
                      </span>
                    </:col>
                    <:col :let={row} label={gettext("Errors")} field={:error_rate} align="right">
                      <span class={[
                        "font-mono tabular-nums",
                        row.error_count > 0 && "text-error"
                      ]}>
                        {Stats.format_number(row.error_count)}
                      </span>
                      <span class="ml-1 text-[10px] text-base-content/40">
                        {Stats.format_percent(row.error_rate)}
                      </span>
                    </:col>
                    <:empty>
                      <div id="agent-empty">
                        <.icon
                          name="hero-command-line"
                          class="w-10 h-10 mx-auto mb-2 opacity-40"
                        />
                        <p>{gettext("No agent traffic in this period.")}</p>
                      </div>
                    </:empty>
                  </.table>
                </div>
                <div
                  id="agents-table-totals"
                  class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 text-xs"
                >
                  <span class="font-semibold text-base-content/70">
                    {gettext("Total · %{count} agents", count: length(@agent_ranking))}
                  </span>
                  <%= if totals = Stats.breakdown_total(@agent_ranking) do %>
                    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 font-mono tabular-nums text-base-content/80">
                      <span>
                        <span class="text-base-content/40">{gettext("Requests")}</span>
                        {Stats.format_number(totals.request_count)}
                      </span>
                      <span>
                        <span class="text-base-content/40">{gettext("Cost")}</span>
                        ${Stats.format_decimal(totals.cost_usd)}
                      </span>
                      <span>
                        <span class="text-base-content/40">{gettext("Tokens in")}</span>
                        {Stats.format_number(totals.prompt_tokens)}
                      </span>
                      <span>
                        <span class="text-base-content/40">{gettext("Tokens out")}</span>
                        {Stats.format_number(totals.completion_tokens)}
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% @live_action == :provider -> %>
          <.provider
            provider={@provider}
            provider_ranking={@provider_ranking}
            provider_metrics={@provider_metrics}
            breakdown_model={@breakdown_model}
            breakdown_user={@breakdown_user}
            breakdown_service={@breakdown_service}
            breakdown_group={@breakdown_group}
            show_services={@current_user.global_role == "admin"}
            period={@period}
            per_page={@per_page}
            shown_counts={@shown_counts}
            stats_loading={@stats_loading}
          />
        <% @live_action in [:models, :model] -> %>
          <%= if @model_filter do %>
            <%!-- Detalle del modelo: la MISMA vista para la ruta propia
                 (/stats/models/:id, action :model) y para el alias ?model_id= --%>
            <.model
              model={@model}
              model_ranking={@model_ranking}
              metrics={@metrics}
              breakdown_provider={@breakdown_provider}
              breakdown_group={@breakdown_group}
              breakdown_member={@breakdown_member}
              drilldown_series={@drilldown_series}
              drilldown_series_labels={@drilldown_series_labels}
              period={@period}
              sort_field={@sort_field}
              sort_direction={@sort_direction}
              per_page={@per_page}
              shown_counts={@shown_counts}
              stats_loading={@stats_loading}
            />
          <% else %>
            <.models
              breakdown_model={@breakdown_model}
              period={@period}
              sort_field={@sort_field}
              sort_direction={@sort_direction}
              per_page={@per_page}
              shown_counts={@shown_counts}
              list_search={@list_search}
            />
          <% end %>
        <% @live_action == :groups -> %>
          <.groups
            metrics={@metrics}
            breakdown_group={@breakdown_group}
            group_budgets={@group_budgets}
            breakdown_member={@breakdown_member}
            breakdown_model={@breakdown_model}
            drilldown_series={@drilldown_series}
            drilldown_series_labels={@drilldown_series_labels}
            group_filter={@group_filter}
            group={@group}
            list_search={@list_search}
            period={@period}
            sort_field={@sort_field}
            sort_direction={@sort_direction}
            per_page={@per_page}
            shown_counts={@shown_counts}
          />
        <% @live_action == :services -> %>
          <.services
            breakdown_service={@breakdown_service}
            service_budgets={@service_budgets}
            list_search={@list_search}
            period={@period}
            sort_field={@sort_field}
            sort_direction={@sort_direction}
            per_page={@per_page}
            shown_counts={@shown_counts}
          />
        <% @live_action == :users -> %>
          <.users
            breakdown_user={@breakdown_user}
            budgets_by_user={@budgets_by_user}
            period={@period}
            sort_field={@sort_field}
            sort_direction={@sort_direction}
            per_page={@per_page}
            shown_counts={@shown_counts}
            list_search={@list_search}
          />
        <% @live_action == :group -> %>
          <.groups
            metrics={@metrics}
            breakdown_group={@breakdown_group}
            group_budgets={@group_budgets}
            group_budget={@group_budget}
            breakdown_member={@breakdown_member}
            breakdown_model={@breakdown_model}
            drilldown_series={@drilldown_series}
            drilldown_series_labels={@drilldown_series_labels}
            group_filter={@group_id}
            list_search={@list_search}
            period={@period}
            sort_field={@sort_field}
            sort_direction={@sort_direction}
            per_page={@per_page}
            shown_counts={@shown_counts}
          />
      <% end %>
    </div>
  </div>
</Layouts.dashboard>
