<Layouts.dashboard flash={@flash} current_scope={@current_user} impersonator={@impersonator}>
  <div class="space-y-6">
    <%!-- Header ──────────────────────────────────────────────────────── --%>
    <div class="flex items-center justify-between flex-wrap gap-4">
      <.header>
        Monitor en vivo
        <:subtitle>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-signal" class="w-4 h-4 text-base-content/50" />
            Terminal de actividad · última hora
          </span>
        </:subtitle>
      </.header>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-2 text-sm text-base-content/60">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-success"></span>
          </span>
          En vivo
        </span>
        <span class="badge badge-sm badge-primary">
          {@total_inflight} en vuelo
        </span>
      </div>
    </div>

    <%!-- Alert KPIs: creds en error, breakers, miembros sin crédito ──────── --%>
    <div
      :if={
        @error_credentials != [] or @breaker_alerts != [] or @budget_exhausted != []
      }
      class="grid grid-cols-1 sm:grid-cols-3 gap-4"
    >
      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body p-4">
          <div class="flex items-center justify-between">
            <p class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
              Credenciales en error
            </p>
            <.icon name="hero-exclamation-circle" class="w-4 h-4 text-error" />
          </div>
          <p class="mt-1 text-2xl font-bold text-base-content" id="alert-count-creds">
            {length(@error_credentials)}
          </p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body p-4">
          <div class="flex items-center justify-between">
            <p class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
              Breakers abiertos
            </p>
            <.icon name="hero-shield-exclamation" class="w-4 h-4 text-warning" />
          </div>
          <p class="mt-1 text-2xl font-bold text-base-content" id="alert-count-breakers">
            {length(@breaker_alerts)}
          </p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body p-4">
          <div class="flex items-center justify-between">
            <p class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
              Miembros sin crédito
            </p>
            <.icon name="hero-banknotes" class="w-4 h-4 text-error" />
          </div>
          <p class="mt-1 text-2xl font-bold text-base-content" id="alert-count-budgets">
            {length(@budget_exhausted)}
          </p>
        </div>
      </div>
    </div>

    <%!-- Alert tables: creds, breakers, budgets ─────────────────────────── --%>
    <div class="space-y-6">
      <%!-- Credentials in error --%>
      <div :if={@error_credentials != []} class="space-y-2">
        <h3 class="text-sm font-semibold text-base-content/70 uppercase tracking-wide">
          Credenciales deshabilitadas por error
        </h3>
        <div class="card bg-base-100 border border-error/30 shadow-sm">
          <div class="card-body p-0">
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Proveedor</th>
                    <th>Alias</th>
                    <th>API Key</th>
                    <th>Endpoint</th>
                    <th>Razón</th>
                    <th>Error</th>
                    <th>Cuándo</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={cred <- @error_credentials} id={"alert-cred-#{cred.id}"}>
                    <td class="font-medium">{cred.provider.name}</td>
                    <td>{cred.name || "—"}</td>
                    <td class="font-mono text-xs">{api_key_prefix(cred.api_key_encrypted)}</td>
                    <td class="text-xs text-base-content/70 max-w-[200px] truncate" title={cred.provider.base_url}>
                      {cred.provider.base_url}
                    </td>
                    <td>
                      <code class="text-xs text-error">{cred.error_reason || "auth_error"}</code>
                    </td>
                    <td class="text-xs text-base-content/70 max-w-xs">
                      <span :if={cred.error_message} class="line-clamp-2" title={cred.error_message}>
                        {cred.error_message}
                      </span>
                      <span :if={!cred.error_message} class="text-base-content/30">—</span>
                    </td>
                    <td class="text-xs text-base-content/50">
                      {format_datetime(cred.error_at, @timezone)}
                    </td>
                    <td class="text-right">
                      <button phx-click="reactivate_credential" phx-value-id={cred.id}
                        class="btn btn-xs btn-warning" id={"alert-reactivate-#{cred.id}"}>
                        <.icon name="hero-arrow-path" class="w-3 h-3" /> Reactivar
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <%!-- Open circuit breakers --%>
      <div :if={@breaker_alerts != []} class="space-y-2">
        <h3 class="text-sm font-semibold text-base-content/70 uppercase tracking-wide">
          Circuit breakers abiertos
        </h3>
        <div class="card bg-base-100 border border-warning/30 shadow-sm">
          <div class="card-body p-0">
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Proveedor</th>
                    <th>Alias</th>
                    <th>API Key</th>
                    <th>Estado</th>
                    <th>Razón</th>
                    <th>Detalle</th>
                    <th>Fallos</th>
                    <th>Abierto desde</th>
                    <th>Errores 24h</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={{cred, details} <- @breaker_alerts} id={"alert-breaker-#{cred.id}"}>
                    <td class="font-medium">{cred.provider.name}</td>
                    <td>{cred.name || "—"}</td>
                    <td class="font-mono text-xs">{api_key_prefix(cred.api_key_encrypted)}</td>
                    <td>
                      <span class={[
                        "badge badge-sm",
                        details.state == :open && "badge-error",
                        details.state == :half_open && "badge-warning"
                      ]}>
                        {breaker_label(details.state)}
                      </span>
                    </td>
                    <td class="text-sm">{reason_label(details.last_reason)}</td>
                    <td class="text-xs text-base-content/70 max-w-[260px] truncate" title={details.last_error_message}>
                      {details.last_error_message || "—"}
                    </td>
                    <td class="text-sm tabular-nums">{details.failures}</td>
                    <td class="text-sm">{fmt_duration(details.opened_at)}</td>
                    <td class="text-sm tabular-nums">
                      {errors_for_credential(cred, @cred_error_counts)}
                    </td>
                    <td class="text-right">
                      <button phx-click="reset_breaker" phx-value-id={cred.id}
                        class="btn btn-xs btn-ghost" id={"alert-reset-breaker-#{cred.id}"}>
                        <.icon name="hero-arrow-path" class="w-3 h-3" /> Reset breaker
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <%!-- Members out of budget --%>
      <div :if={@budget_exhausted != []} class="space-y-2">
        <h3 class="text-sm font-semibold text-base-content/70 uppercase tracking-wide">
          Miembros sin crédito
        </h3>
        <div class="card bg-base-100 border border-error/30 shadow-sm">
          <div class="card-body p-0">
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Usuario</th>
                    <th>Equipo</th>
                    <th>Límite agotado</th>
                    <th>Gasto mes</th>
                    <th>Gasto hoy</th>
                    <th>Requests hoy</th>
                    <th>Proveedor top (hoy)</th>
                    <th>Último request</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={b <- @budget_exhausted} id={"alert-budget-#{b.member.id}"}>
                    <td class="font-medium">{b.member.user.email}</td>
                    <td>{b.member.team.name}</td>
                    <td>
                      <span class="badge badge-sm badge-error">{budget_periods(b)}</span>
                    </td>
                    <td class="font-mono text-xs">
                      ${fmt_money(b.monthly_spend_usd)}
                      <span :if={b.monthly_limit_usd} class="text-base-content/50">
                        / ${fmt_money(b.monthly_limit_usd)}
                      </span>
                    </td>
                    <td class="font-mono text-xs">
                      ${fmt_money(b.daily_spend_usd)}
                    </td>
                    <td class="text-sm tabular-nums">
                      {Map.get(@budget_activity, b.member.id, %{}) |> Map.get(:requests_today, 0)}
                    </td>
                    <td class="text-sm">
                      {Map.get(@budget_activity, b.member.id, %{}) |> Map.get(:top_provider, "—")}
                    </td>
                    <td class="text-xs text-base-content/50">
                      {Map.get(@budget_activity, b.member.id, %{}) |> Map.get(:last_request) |> format_datetime(@timezone)}
                    </td>
                    <td class="text-right">
                      <.link navigate={~p"/dashboard/credits"} class="btn btn-xs btn-ghost"
                        id={"alert-budget-credits-#{b.member.id}"}>
                        Ver créditos
                      </.link>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Índices strip ───────────────────────────────────────────────── --%>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      <.index_card
        label="Requests / s"
        value={format_number(@indices[:rps] || 0)}
        icon="hero-bolt"
        color="text-primary"
      />
      <.index_card
        label="En vuelo"
        value={format_number(@indices[:inflight] || 0)}
        icon="hero-rocket-launch"
        color="text-secondary"
      />
      <.index_card
        label="% Error"
        value={"#{Float.round((@indices[:error_rate] || 0.0) * 100, 1)}%"}
        icon="hero-exclamation-triangle"
        color={health_class(@indices[:error_rate] || 0.0)}
      />
      <.index_card
        label="Costo total"
        value={"$#{format_cost(@indices[:cost_usd] || Decimal.new(0))}"}
        icon="hero-banknotes"
        color="text-success"
      />
      <.index_card
        label="Total requests"
        value={format_number(@indices[:total_requests] || 0)}
        icon="hero-chart-bar"
        color="text-base-content/60"
      />
    </div>

    <%!-- Tabs ───────────────────────────────────────────────────────── --%>
    <div role="tablist" class="tabs tabs-bordered">
      <button
        role="tab"
        class={["tab", @active_tab == "model" && "tab-active"]}
        phx-click="switch-tab"
        phx-value-tab="model"
      >
        Por Modelo
      </button>
      <button
        role="tab"
        class={["tab", @active_tab == "credential" && "tab-active"]}
        phx-click="switch-tab"
        phx-value-tab="credential"
      >
        Por API Key
      </button>
    </div>

    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <%!-- TAB: POR MODELO                                                    --%>
    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <%= if @active_tab == "model" do %>
      <%= if @tickets == [] do %>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <p class="text-sm text-base-content/40 py-8 text-center">
              Sin actividad registrada. Los requests aparecerán aquí en cuanto lleguen.
            </p>
          </div>
        </div>
      <% else %>
        <div class="card bg-base-100 border border-base-300 shadow-sm" id="monitor-chart">
          <div class="card-body space-y-1 p-4 sm:p-6">
            <%!-- Table header --%>
            <div class="hidden md:grid grid-cols-[1fr_120px_56px_64px_64px_48px] gap-3 px-2 pb-2 border-b border-base-200 text-[10px] font-semibold uppercase tracking-wider text-base-content/40">
              <span>Modelo</span>
              <span class="text-center">60 min</span>
              <span class="text-right">RPM</span>
              <span class="text-right hidden lg:block">Hora</span>
              <span class="text-right hidden lg:block">Total</span>
              <span class="text-center">Vuelo</span>
            </div>

            <%!-- Ticket rows --%>
            <div :for={ticket <- @tickets} class="space-y-0">
              <button
                type="button"
                class={[
                  "w-full grid grid-cols-[1fr_auto] md:grid-cols-[1fr_120px_56px_64px_64px_48px] gap-3 items-center px-2 py-2 rounded-lg transition-colors text-left",
                  @expanded_model == ticket.alias_id && "bg-base-200/50",
                  "hover:bg-base-200/30"
                ]}
                phx-click="toggle-expand"
                phx-value-model-id={ticket.alias_id}
              >
                <%!-- Model name + health dot --%>
                <div class="flex items-center gap-2 min-w-0">
                  <span class={["w-2 h-2 rounded-full shrink-0", health_dot_class(0)]} />
                  <span class="text-xs font-medium text-base-content/80 truncate">
                    {ticket.model_name}
                  </span>
                </div>

                <%!-- Sparkline --%>
                <div class="hidden md:block w-[120px]">
                  <svg viewBox="0 0 120 30" class="w-full h-8" preserveAspectRatio="none">
                    <path
                      d={sparkline_area_path(ticket.sparkline)}
                      class="fill-primary/10"
                    >
                    </path>
                    <polyline
                      points={sparkline_points(ticket.sparkline)}
                      fill="none"
                      class="stroke-primary"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                    </polyline>
                  </svg>
                </div>

                <%!-- Current RPM --%>
                <span class="hidden md:block text-right text-[11px] tabular-nums text-base-content/70">
                  {current_rpm(ticket.sparkline)}
                </span>

                <%!-- Hour volume --%>
                <span class="hidden lg:block text-right text-[11px] tabular-nums text-base-content/50">
                  {format_number(hour_volume(ticket.sparkline))}
                </span>

                <%!-- Total since start --%>
                <span class="hidden lg:block text-right text-[11px] tabular-nums text-base-content/50">
                  {format_number(ticket.total_requests)}
                </span>

                <%!-- In-flight badge --%>
                <span class={[
                  "badge badge-sm shrink-0 w-8 justify-center",
                  inflight_badge_class(ticket.inflight)
                ]}>
                  {inflight_label(ticket.inflight)}
                </span>
              </button>

              <%!-- Drill-down: credentials por modelo --%>
              <%= if @expanded_model == ticket.alias_id do %>
                <.credential_drilldown rows={@credential_rows} />
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <%!-- TAB: POR API KEY                                                   --%>
    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <%= if @active_tab == "credential" do %>
      <%= if @credential_tickets == [] do %>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <p class="text-sm text-base-content/40 py-8 text-center">
              Sin actividad registrada. Los requests aparecerán aquí en cuanto lleguen.
            </p>
          </div>
        </div>
      <% else %>
        <div class="card bg-base-100 border border-base-300 shadow-sm" id="monitor-chart-creds">
          <div class="card-body space-y-1 p-4 sm:p-6">
            <%!-- Table header --%>
            <div class="hidden lg:grid grid-cols-[1fr_1fr_120px_56px_56px_56px_72px_1fr] gap-3 px-2 pb-2 border-b border-base-200 text-[10px] font-semibold uppercase tracking-wider text-base-content/40">
              <span>API Key</span>
              <span>Proveedor</span>
              <span class="text-center">60 min</span>
              <span class="text-right">RPM</span>
              <span class="text-right">Hora</span>
              <span class="text-right">Total</span>
              <span class="text-center">Vuelo</span>
              <span>Breaker · Usuarios en vuelo</span>
            </div>
            <div class="hidden md:grid lg:hidden grid-cols-[1fr_1fr_120px_56px_56px_48px] gap-3 px-2 pb-2 border-b border-base-200 text-[10px] font-semibold uppercase tracking-wider text-base-content/40">
              <span>API Key</span>
              <span>Proveedor</span>
              <span class="text-center">60 min</span>
              <span class="text-right">RPM</span>
              <span class="text-right">Hora</span>
              <span class="text-center">Vuelo</span>
            </div>

            <%!-- Credential ticket rows --%>
            <div :for={ticket <- @credential_tickets} class="space-y-0">
              <button
                type="button"
                class={[
                  "w-full grid grid-cols-[1fr_auto] md:grid-cols-[1fr_1fr_120px_56px_56px_48px] lg:grid-cols-[1fr_1fr_120px_56px_56px_56px_72px_1fr] gap-3 items-center px-2 py-2 rounded-lg transition-colors text-left",
                  @expanded_credential == ticket.credential_name && "bg-base-200/50",
                  "hover:bg-base-200/30"
                ]}
                phx-click="toggle-expand-credential"
                phx-value-credential-name={ticket.credential_name}
              >
                <%!-- Credential name + breaker dot --%>
                <div class="flex items-center gap-2 min-w-0">
                  <span class={[
                    "w-2 h-2 rounded-full shrink-0",
                    breaker_dot_class(ticket.breaker_state)
                  ]} />
                  <span class="text-xs font-medium text-base-content/80 truncate">
                    {ticket.credential_name}
                  </span>
                </div>

                <%!-- Provider name --%>
                <span class="text-xs text-base-content/50 truncate hidden md:block">
                  {ticket.provider_name}
                </span>

                <%!-- Sparkline --%>
                <div class="hidden md:block w-[120px]">
                  <svg viewBox="0 0 120 30" class="w-full h-8" preserveAspectRatio="none">
                    <path
                      d={sparkline_area_path(ticket.sparkline)}
                      class="fill-primary/10"
                    >
                    </path>
                    <polyline
                      points={sparkline_points(ticket.sparkline)}
                      fill="none"
                      class="stroke-primary"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                    </polyline>
                  </svg>
                </div>

                <%!-- Current RPM --%>
                <span class="hidden md:block text-right text-[11px] tabular-nums text-base-content/70">
                  {current_rpm(ticket.sparkline)}
                </span>

                <%!-- Hour volume --%>
                <span class="hidden md:block text-right text-[11px] tabular-nums text-base-content/50">
                  {format_number(hour_volume(ticket.sparkline))}
                </span>

                <%!-- Total (lg only) --%>
                <span class="hidden lg:block text-right text-[11px] tabular-nums text-base-content/50">
                  {format_number(ticket.total_requests)}
                </span>

                <%!-- In-flight badge --%>
                <span class={[
                  "badge badge-sm shrink-0 w-8 justify-center",
                  inflight_badge_class(ticket.inflight)
                ]}>
                  {inflight_label(ticket.inflight)}
                </span>

                <%!-- Breaker + Usuarios en vuelo (lg only) --%>
                <div class="hidden lg:flex items-center gap-2 min-w-0">
                  <%= if ticket.breaker_state && ticket.breaker_state != :closed do %>
                    <span class={[
                      "badge badge-xs shrink-0",
                      breaker_badge_class(ticket.breaker_state)
                    ]}>
                      {breaker_label(ticket.breaker_state)}
                    </span>
                    <span
                      class="text-[9px] text-base-content/40 truncate"
                      title={breaker_reason_label(ticket.breaker_reason)}
                    >
                      {breaker_reason_label(ticket.breaker_reason)}
                    </span>
                  <% else %>
                    <span class="text-[10px] text-base-content/30 shrink-0">Cerrado</span>
                  <% end %>
                  <div class="flex flex-wrap gap-1 min-w-0">
                    <span :for={u <- ticket.inflight_users} class="badge badge-xs badge-primary">
                      <%= if u.count > 1 do %>
                        {u.name} ({u.count})
                      <% else %>
                        {u.name}
                      <% end %>
                    </span>
                  </div>
                </div>
              </button>

              <%!-- Drill-down: models served by this API key --%>
              <%= if @expanded_credential == ticket.credential_name do %>
                <.credential_model_drilldown rows={@credential_model_rows} />
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</Layouts.dashboard>
