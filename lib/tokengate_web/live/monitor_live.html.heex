<Layouts.dashboard flash={@flash} current_scope={@current_user} impersonator={@impersonator}>
  <div class="space-y-6">
    <%!-- Header ──────────────────────────────────────────────────────── --%>
    <div class="flex items-center justify-between flex-wrap gap-4">
      <.header>
        Monitor en vivo
        <:subtitle>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-signal" class="w-4 h-4 text-base-content/50" />
            Terminal de actividad · tiempo real
          </span>
        </:subtitle>
      </.header>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-2 text-sm text-base-content/60">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-success"></span>
          </span>
          En vivo
        </span>
        <span class="badge badge-sm badge-primary">
          {@total_inflight} en vuelo
        </span>
      </div>
    </div>

    <%!-- Índices strip ───────────────────────────────────────────────── --%>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <.index_card
        label="En vuelo"
        value={format_number(@indices[:inflight] || 0)}
        icon="hero-rocket-launch"
        color="text-secondary"
      />
      <.index_card
        label="Providers en vuelo"
        value={format_number(@indices[:inflight_providers] || 0)}
        icon="hero-server-stack"
        color="text-secondary"
      />
      <.index_card
        label="Usuarios en vuelo"
        value={format_number(@indices[:inflight_users] || 0)}
        icon="hero-users"
        color="text-secondary"
      />
      <.index_card
        label="Requests hoy"
        value={format_number(@indices[:today_requests] || 0)}
        icon="hero-bolt"
        color="text-primary"
        delta={@indices[:delta_requests]}
      />
      <.index_card
        label="% Error hoy"
        value={"#{Float.round((@indices[:today_error_rate] || 0.0) * 100, 1)}%"}
        icon="hero-exclamation-triangle"
        color={health_class(@indices[:today_error_rate] || 0.0)}
        delta={@indices[:delta_error_rate]}
        delta_suffix="pp"
      />
      <.index_card
        label="Costo hoy"
        value={"$#{format_cost(@indices[:today_cost] || Decimal.new(0))}"}
        icon="hero-banknotes"
        color="text-success"
        delta={@indices[:delta_cost]}
      />
    </div>

    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <%!-- TABLA: POR MODELO                                                 --%>
    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <%= if @tickets == [] do %>
      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body">
          <p class="text-sm text-base-content/40 py-8 text-center">
            Sin actividad registrada. Los requests aparecerán aquí en cuanto lleguen.
          </p>
        </div>
      </div>
    <% else %>
      <div class="card bg-base-100 border border-base-300 shadow-sm" id="monitor-chart">
        <div class="card-body space-y-1 p-4 sm:p-6">
          <%!-- Table header: 3 zonas - nombre | data hora | data vuelo --%>
          <div class="hidden md:grid grid-cols-[1fr_auto_1fr_auto_1fr_auto] gap-3 px-2 pb-2 border-b border-base-200 text-[10px] font-semibold uppercase tracking-wider text-base-content/40">
            <%!-- Zona 1: Modelo --%>
            <span>Modelo</span>
            <span class="w-px bg-base-200"></span>
            <%!-- Zona 2: Data por hora --%>
            <div class="flex items-center justify-end gap-4">
              <span class="w-[120px] text-center">60 min</span>
              <span class="text-right w-12">RPM</span>
              <span class="text-right w-16 hidden lg:block">Hora</span>
              <span class="text-right w-14 hidden lg:block">Lat</span>
              <span class="text-right w-16 hidden lg:block">$ Hora</span>
              <span class="text-right w-16 hidden lg:block">$ Día</span>
            </div>
            <span class="w-px bg-base-200"></span>
            <%!-- Zona 3: Data al vuelo --%>
            <div class="flex items-center justify-end gap-4">
              <span class="text-center w-20">Providers</span>
              <span class="text-center w-12">Vuelo</span>
            </div>
            <span class="w-px bg-base-200"></span>
          </div>

          <%!-- Ticket rows --%>
          <div :for={ticket <- @tickets} class="space-y-0">
            <button
              type="button"
              class={[
                "w-full grid grid-cols-[1fr_auto_1fr_auto_1fr_auto] gap-3 items-center px-2 py-2 rounded-lg transition-colors text-left",
                @expanded_model == ticket.alias_id && "bg-base-200/50",
                "hover:bg-base-200/30"
              ]}
              phx-click="toggle-expand"
              phx-value-model-id={ticket.alias_id}
            >
              <%!-- Zona 1: Modelo --%>
              <div class="flex items-center gap-2 min-w-0">
                <span class={["w-2 h-2 rounded-full shrink-0", health_dot_class(0)]} />
                <span class="text-xs font-medium text-base-content/80 truncate">
                  {ticket.model_name}
                </span>
              </div>

              <span class="w-px h-8 bg-base-200/50"></span>

              <%!-- Zona 2: Data por hora --%>
              <div class="flex items-center justify-end gap-4 min-w-0">
                <%!-- Sparkline --%>
                <div class="hidden md:block w-[120px] shrink-0">
                  <svg viewBox="0 0 120 30" class="w-full h-8" preserveAspectRatio="none">
                    <path
                      d={sparkline_area_path(ticket.sparkline)}
                      class="fill-primary/10"
                    >
                    </path>
                    <polyline
                      points={sparkline_points(ticket.sparkline)}
                      fill="none"
                      class="stroke-primary"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                    </polyline>
                  </svg>
                </div>

                <%!-- Current RPM --%>
                <span class="hidden md:block text-right text-[11px] tabular-nums text-base-content/70 w-12 shrink-0">
                  {current_rpm(ticket.sparkline)}
                </span>

                <%!-- Hour volume --%>
                <span class="hidden lg:block text-right text-[11px] tabular-nums text-base-content/50 w-16 shrink-0">
                  {format_number(hour_volume(ticket.sparkline))}
                </span>

                <%!-- Avg latency --%>
                <span class="hidden lg:block text-right text-[11px] tabular-nums text-base-content/60 w-14 shrink-0">
                  {if ticket.avg_latency_ms, do: "#{ticket.avg_latency_ms}ms", else: "—"}
                </span>

                <%!-- Cost last hour --%>
                <span class="hidden lg:block text-right text-[11px] tabular-nums text-success/70 w-16 shrink-0">
                  ${format_cost(ticket.cost_hour)}
                </span>

                <%!-- Cost last day --%>
                <span class="hidden lg:block text-right text-[11px] tabular-nums text-base-content/50 w-16 shrink-0">
                  ${format_cost(ticket.cost_day)}
                </span>
              </div>

              <span class="w-px h-8 bg-base-200/50"></span>

              <%!-- Zona 3: Data al vuelo --%>
              <div class="flex items-center justify-end gap-4 min-w-0">
                <%!-- Providers en vuelo --%>
                <span class="hidden md:flex items-center gap-1 text-[11px] tabular-nums text-base-content/60 w-20 shrink-0">
                  <.icon name="hero-server-stack" class="w-3 h-3 text-base-content/40" />
                  {ticket.inflight_providers}
                </span>

                <%!-- In-flight badge --%>
                <span class={[
                  "badge badge-sm shrink-0 w-12 justify-center",
                  inflight_badge_class(ticket.inflight)
                ]}>
                  {inflight_label(ticket.inflight)}
                </span>
              </div>

              <span class="w-px h-8 bg-base-200/50"></span>
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.dashboard>
