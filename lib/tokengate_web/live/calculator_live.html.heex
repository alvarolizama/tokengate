<Layouts.dashboard flash={@flash} current_scope={@current_user} current_path={@current_path}>
  <div class="space-y-6">
    <%!-- Header ──────────────────────────────────────────────────────────── --%>
    <div class="flex items-center justify-between flex-wrap gap-4">
      <.header>
        {gettext("Cost calculator")}
        <:subtitle>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-calculator" class="w-4 h-4 text-base-content/50" />
            {gettext("Compares real vs estimated spend by model, lane and key")}
          </span>
        </:subtitle>
        <:actions>
          <%!-- Canonical period set, in the URL: the same patch-link selector
               the stats pages use (no duplicate literal list here). --%>
          <.period_selector target={~p"/calculator"} period={@period} id="period-selector" />
        </:actions>
      </.header>
    </div>

    <%!-- Two columns: controls (1/4) + results (3/4) ─────────────────────── --%>
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 items-start">
      <%!-- Left: form ───────────────────────────────────────────────────── --%>
      <div class="card bg-base-100 border border-base-300 shadow-sm lg:col-span-1 lg:sticky lg:top-20">
        <div class="card-body p-4">
          <.form for={%{}} id="calculator-form" phx-change="calculate" phx-submit="calculate">
            <div class="space-y-4">
              <div class="space-y-1.5">
                <label class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
                  {gettext("Model")}
                </label>
                <select
                  name="model_id"
                  class="select select-bordered select-sm w-full"
                >
                  <option value="">{gettext("Pick a model…")}</option>
                  <%= for model <- @models do %>
                    <option value={model.id} selected={model.id == @selected_model_id}>
                      {model.name}
                    </option>
                  <% end %>
                </select>
              </div>

              <div class="space-y-1.5">
                <label
                  class="text-xs font-semibold uppercase tracking-wide text-base-content/50"
                  for="lane-select"
                >
                  Lane
                </label>
                <select
                  id="lane-select"
                  name="lane_id"
                  class="select select-bordered select-sm w-full"
                >
                  <option value="">{gettext("All providers")}</option>
                  <%= for lane <- @lanes do %>
                    <option value={lane.id} selected={lane.id == @selected_lane_id}>
                      {lane_label(lane)}
                    </option>
                  <% end %>
                </select>
              </div>

              <%!-- Only a lane mounted on a pool can narrow down to ONE of its keys --%>
              <% pool_lane = selected_pool_lane(@lanes, @selected_lane_id) %>
              <div :if={pool_lane} class="space-y-1.5">
                <label
                  class="text-xs font-semibold uppercase tracking-wide text-base-content/50"
                  for="credential-select"
                >
                  API key
                </label>
                <select
                  id="credential-select"
                  name="credential_id"
                  class="select select-bordered select-sm w-full"
                >
                  <option value="">{gettext("All pool keys")}</option>
                  <%= for credential <- pool_credentials(pool_lane) do %>
                    <option
                      value={credential.id}
                      selected={credential.id == @selected_credential_id}
                    >
                      {credential_label(credential)}
                    </option>
                  <% end %>
                </select>
              </div>

              <%!-- The period lives in the URL: the selector sits in the header,
                   so the form only carries the model/lane/key and the rates. --%>

              <%!-- Custom pricing, stacked for the narrow column --%>
              <div class="pt-4 border-t border-base-200 space-y-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
                  {gettext("Custom prices")}
                </p>
                <p class="text-[11px] text-base-content/40 -mt-1">
                  <%= if @lane_non_token do %>
                    {gettext("The lane bills per unit, not per token — no estimate")}
                  <% else %>
                    {gettext(
                      "Per %{unit} of tokens — only affects the \"Estimated (custom)\" line",
                      unit: Pricing.rate_suffix(@lane_unit)
                    )}
                  <% end %>
                </p>

                <div
                  :if={@lane_non_token}
                  id="lane-unit-notice"
                  class="alert alert-warning text-[11px] py-2 px-3"
                >
                  <span>
                    {gettext(
                      "This lane bills per unit (%{unit}), not per token: the estimate does not apply. Only real spend is shown.",
                      unit: Pricing.label(@lane_unit)
                    )}
                  </span>
                </div>

                <%!-- An empty or invalid rate is NOT free and NOT the hardcoded
                     default: the estimate counts $0 there and this banner says
                     which field carries no price. --%>
                <div
                  :if={@price_issues != []}
                  id="calc-price-issues"
                  class="alert alert-warning text-[11px] py-2 px-3"
                  role="status"
                >
                  <span>{price_issues_text(@price_issues)}</span>
                </div>

                <div class="space-y-3">
                  <div class="space-y-1.5">
                    <label class="text-xs font-medium text-base-content/60" for="cost-input">
                      {gettext("Input price")}
                    </label>
                    <div class="join w-full">
                      <span class="join-item px-3 flex items-center text-sm text-base-content/50 bg-base-200 border border-base-300 border-r-0 rounded-l">
                        $
                      </span>
                      <input
                        type="number"
                        name="cost_input"
                        id="cost-input"
                        value={@cost_input}
                        min="0"
                        step="0.01"
                        class="input input-bordered input-sm w-full rounded-l-none"
                      />
                      <span class="join-item px-3 flex items-center text-xs text-base-content/50 bg-base-200 border border-base-300 border-l-0 rounded-r">
                        /{Pricing.rate_suffix(@lane_unit)}
                      </span>
                    </div>
                  </div>

                  <div class="space-y-1.5">
                    <label class="text-xs font-medium text-base-content/60" for="cost-cache">
                      {gettext("Cache price")}
                    </label>
                    <div class="join w-full">
                      <span class="join-item px-3 flex items-center text-sm text-base-content/50 bg-base-200 border border-base-300 border-r-0 rounded-l">
                        $
                      </span>
                      <input
                        type="number"
                        name="cost_cache"
                        id="cost-cache"
                        value={@cost_cache}
                        min="0"
                        step="0.01"
                        class="input input-bordered input-sm w-full rounded-l-none"
                      />
                      <span class="join-item px-3 flex items-center text-xs text-base-content/50 bg-base-200 border border-base-300 border-l-0 rounded-r">
                        /{Pricing.rate_suffix(@lane_unit)}
                      </span>
                    </div>
                  </div>

                  <div class="space-y-1.5">
                    <label class="text-xs font-medium text-base-content/60" for="cost-cache-write">
                      {gettext("Cache write price")}
                    </label>
                    <div class="join w-full">
                      <span class="join-item px-3 flex items-center text-sm text-base-content/50 bg-base-200 border border-base-300 border-r-0 rounded-l">
                        $
                      </span>
                      <input
                        type="number"
                        name="cost_cache_write"
                        id="cost-cache-write"
                        value={@cost_cache_write}
                        min="0"
                        step="0.01"
                        class="input input-bordered input-sm w-full rounded-l-none"
                      />
                      <span class="join-item px-3 flex items-center text-xs text-base-content/50 bg-base-200 border border-base-300 border-l-0 rounded-r">
                        /{Pricing.rate_suffix(@lane_unit)}
                      </span>
                    </div>
                  </div>

                  <div class="space-y-1.5">
                    <label class="text-xs font-medium text-base-content/60" for="cost-output">
                      {gettext("Output price")}
                    </label>
                    <div class="join w-full">
                      <span class="join-item px-3 flex items-center text-sm text-base-content/50 bg-base-200 border border-base-300 border-r-0 rounded-l">
                        $
                      </span>
                      <input
                        type="number"
                        name="cost_output"
                        id="cost-output"
                        value={@cost_output}
                        min="0"
                        step="0.01"
                        class="input input-bordered input-sm w-full rounded-l-none"
                      />
                      <span class="join-item px-3 flex items-center text-xs text-base-content/50 bg-base-200 border border-base-300 border-l-0 rounded-r">
                        /{Pricing.rate_suffix(@lane_unit)}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </.form>
        </div>
      </div>

      <%!-- Right: summary + chart ───────────────────────────────────────── --%>
      <div class="lg:col-span-3 space-y-4">
        <%= if @summary do %>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <.kpi_card
              id="calc-real"
              label={gettext("Actual spend")}
              icon="hero-banknotes"
              accent="primary"
              title={gettext("Cost reported by the provider for the period")}
            >
              {format_cost(@summary.total_real)}
              <:sub :if={
                Decimal.compare(@summary.total_real, 0) == :eq and @summary.total_requests > 0
              }>
                {gettext("The provider reports no cost")}
              </:sub>
            </.kpi_card>

            <%!-- Without a token unit there is no estimate: the card is not rendered --%>
            <.kpi_card
              :if={!@lane_non_token}
              id="calc-estimated"
              label={gettext("Estimated (custom)")}
              icon="hero-calculator"
              accent="primary"
              title={gettext("Estimated cost with the custom prices on the left")}
            >
              {format_cost(@summary.total_estimated)}
            </.kpi_card>

            <.kpi_card
              id="calc-difference"
              label={gettext("Difference")}
              icon="hero-scale"
              accent={difference_accent(@summary.difference)}
              title={
                gettext("Real − Estimated (custom): positive = you paid more than estimated")
              }
            >
              <span :if={@summary.difference} class={difference_class(@summary.difference)}>
                {difference_sign(@summary.difference)}{abs_decimal(@summary.difference)}
              </span>
              <span :if={is_nil(@summary.difference)} class="text-base-content/40">—</span>
              <:sub :if={difference_pct(@summary)}>
                <span class={difference_class(@summary.difference)}>
                  {difference_sign(@summary.difference)}{difference_pct(@summary)}% {gettext(
                    "vs estimated"
                  )}
                </span>
              </:sub>
            </.kpi_card>
          </div>

          <%!-- Volumen del período: requests + tokens --%>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <.kpi_card
              id="calc-requests"
              label={gettext("Requests")}
              icon="hero-bolt"
              accent="primary"
            >
              {format_number(@summary.total_requests)}
            </.kpi_card>

            <.kpi_card
              id="calc-tokens"
              label={gettext("Tokens")}
              icon="hero-cpu-chip"
              accent="primary"
              title={
                "#{format_number(@summary.total_prompt)} in / #{format_number(@summary.total_cache_read)} cache / #{format_number(@summary.total_cache_creation)} cache write / #{format_number(@summary.total_completion)} out"
              }
            >
              <span class="flex items-baseline gap-2">
                {format_compact(@summary.total_prompt)}
                <span class="text-sm text-base-content/50">in</span>
                <span class="text-base-content/30">/</span>
                {format_compact(@summary.total_cache_read)}
                <span class="text-sm text-base-content/50">cache</span>
                <span class="text-base-content/30">/</span>
                {format_compact(@summary.total_completion)}
                <span class="text-sm text-base-content/50">out</span>
              </span>
              <:sub>
                total {format_number(@summary.total_prompt + @summary.total_completion)} tokens
                · {format_compact(@summary.total_cache_creation)} cache write
              </:sub>
            </.kpi_card>
          </div>
        <% end %>

        <%!-- Placeholder until a model is picked ─────────────────────────── --%>
        <%= if is_nil(@summary) do %>
          <div class="card bg-base-100 border border-base-300 shadow-sm" id="calc-empty">
            <div class="card-body">
              <p class="text-sm text-base-content/40 py-12 text-center">
                {gettext("Pick a model to see the real vs estimated spend comparison.")}
              </p>
            </div>
          </div>
        <% end %>

        <%!-- No data for the selected model/period ───────────────────────── --%>
        <%= if @chart_data == [] and @selected_model_id do %>
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body">
              <p class="text-sm text-base-content/40 py-8 text-center">
                {gettext("No data for this model in the selected period.")}
              </p>
            </div>
          </div>
        <% end %>

        <%!-- Chart ──────────────────────────────────────────────────────────── --%>
        <%= if @chart_data != [] do %>
          <% chart = chart_points(@chart_data) %>
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body space-y-3 p-4 sm:p-6">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <h3 class="text-sm font-semibold text-base-content">
                  {gettext("Comparison: Real vs Estimated spend")}
                </h3>
                <div class="flex items-center gap-4 text-xs">
                  <span class="inline-flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-sm bg-success"></span>
                    <span class="text-base-content/60">Real</span>
                  </span>
                  <span :if={!@lane_non_token} class="inline-flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-sm bg-primary"></span>
                    <span class="text-base-content/60">{gettext("Estimated (custom)")}</span>
                  </span>
                </div>
              </div>

              <div class="w-full overflow-x-auto">
                <svg
                  viewBox="0 0 800 220"
                  class="w-full h-auto min-w-[600px]"
                  preserveAspectRatio="xMidYMid meet"
                >
                  <%!-- Y-axis grid lines + labels --%>
                  <%= for tick <- chart.y_ticks do %>
                    <line
                      x1={chart[:pad_left] || 70}
                      y1={tick.y}
                      x2="790"
                      y2={tick.y}
                      class="stroke-base-200"
                      stroke-width="0.5"
                    />
                    <text
                      x={(chart[:pad_left] || 70) - 5}
                      y={tick.y + 4}
                      text-anchor="end"
                      class="fill-base-content/40 text-[9px]"
                    >
                      ${tick.value}
                    </text>
                  <% end %>

                  <%!-- Real cost area fill --%>
                  <path d={chart.real_area} class="fill-success/10" />

                  <%!-- Real cost line --%>
                  <polyline
                    points={chart.real_points}
                    fill="none"
                    class="stroke-success"
                    stroke-width="2"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                  />

                  <%!-- Estimated cost line (custom prices) — absent without a token unit --%>
                  <polyline
                    :if={!@lane_non_token}
                    points={chart.est_points}
                    fill="none"
                    class="stroke-primary"
                    stroke-width="2"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                    stroke-dasharray="4,2"
                  />

                  <%!-- X-axis line --%>
                  <line
                    x1={chart[:pad_left] || 70}
                    y1={(chart[:pad_top] || 10) + (chart[:plot_h] || 175)}
                    x2="790"
                    y2={(chart[:pad_top] || 10) + (chart[:plot_h] || 175)}
                    class="stroke-base-300"
                    stroke-width="1"
                  />

                  <%!-- X-axis labels --%>
                  <%= for label <- chart.x_labels do %>
                    <text
                      x={label.x}
                      y="215"
                      text-anchor="middle"
                      class="fill-base-content/40 text-[8px]"
                    >
                      {label.label}
                    </text>
                  <% end %>
                </svg>
              </div>

              <%!-- Hourly breakdown table ─────────────────────────────────────── --%>
              <div class="mt-4 overflow-x-auto">
                <div class={[
                  "hidden md:grid gap-2 px-2 pb-2 border-b border-base-200 text-[10px] font-semibold uppercase tracking-wider text-base-content/40",
                  if(@lane_non_token,
                    do: "grid-cols-[1fr_1fr_1fr_1fr_1fr_1fr_1fr]",
                    else: "grid-cols-[1fr_1fr_1fr_1fr_1fr_1fr_1fr_1fr]"
                  )
                ]}>
                  <span>{gettext("Hour")}</span>
                  <span class="text-right">Requests</span>
                  <span class="text-right">{gettext("In")}</span>
                  <span class="text-right">Cache read</span>
                  <span class="text-right">Cache write</span>
                  <span class="text-right">{gettext("Out")}</span>
                  <span class="text-right">Real</span>
                  <span :if={!@lane_non_token} class="text-right">{gettext("Estimated (custom)")}</span>
                </div>
                <div
                  :for={row <- @chart_data}
                  class={[
                    "grid grid-cols-[1fr_auto] gap-2 px-2 py-1.5 items-center text-[11px] tabular-nums hover:bg-base-200/20 border-b border-base-200/30 last:border-b-0",
                    if(@lane_non_token,
                      do: "md:grid-cols-[1fr_1fr_1fr_1fr_1fr_1fr_1fr]",
                      else: "md:grid-cols-[1fr_1fr_1fr_1fr_1fr_1fr_1fr_1fr]"
                    )
                  ]}
                >
                  <span class="text-base-content/60 truncate">
                    {Calendar.strftime(row.hour, "%d/%m %H:%M")}
                  </span>
                  <span class="text-right text-base-content/60 hidden md:block">{format_number(
                    row.request_count
                  )}</span>
                  <span class="text-right text-base-content/50 hidden md:block">{format_number(
                    row.prompt_tokens
                  )}</span>
                  <span class="text-right text-base-content/50 hidden md:block">{format_number(
                    row.cache_read_tokens
                  )}</span>
                  <span class="text-right text-base-content/50 hidden md:block">{format_number(
                    row.cache_creation_tokens
                  )}</span>
                  <span class="text-right text-base-content/50 hidden md:block">{format_number(
                    row.completion_tokens
                  )}</span>
                  <span class="text-right font-medium text-success/70">{format_cost(row.real_cost)}</span>
                  <span :if={!@lane_non_token} class="text-right font-medium text-primary/70">{format_cost(
                    row.estimated_cost
                  )}</span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.dashboard>
