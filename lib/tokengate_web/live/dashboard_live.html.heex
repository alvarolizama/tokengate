<Layouts.dashboard flash={@flash} current_scope={@current_user}>
  <div class="space-y-6">
    <.header>
      Dashboard
      <:subtitle>
        <span class="inline-flex items-center gap-2">
          <.icon name="hero-funnel" class="w-4 h-4 text-base-content/50" />
          {@scope_label}
        </span>
      </:subtitle>
    </.header>

    <%!-- API usage info --%>
    <div class="alert alert-info" id="api-usage-info">
      <.icon name="hero-information-circle" class="w-5 h-5 shrink-0" />
      <div class="flex-1 text-sm">
        <p class="font-semibold">Endpoint de la API</p>
        <p class="mt-1">
          Usa tu clave en el header
          <code class="font-mono bg-base-200 px-1 rounded">Authorization: Bearer tu-clave</code>
        </p>
        <div class="mt-2 space-y-1">
          <p>
            <span class="text-base-content/60">Modelos disponibles:</span>
            <code class="font-mono bg-base-200 px-1 rounded">GET /v1/models</code>
          </p>
          <p>
            <span class="text-base-content/60">Chat completions:</span>
            <code class="font-mono bg-base-200 px-1 rounded">POST /v1/chat/completions</code>
          </p>
        </div>
      </div>
    </div>

    <%!-- One-time new token alert --%>
    <div :if={@new_token} class="alert alert-warning shadow-lg" id="new-token-alert" role="alert">
      <.icon name="hero-key" class="w-5 h-5 shrink-0" />
      <div class="flex-1">
        <p class="font-semibold">Nueva clave generada para {@new_token_team}</p>
        <div class="relative mt-2">
          <code
            class="block p-2 pr-12 bg-base-200 rounded text-sm font-mono break-all select-all"
            id="new-token-value"
          >
            {@new_token}
          </code>
          <button
            type="button"
            onclick="navigator.clipboard.writeText(document.getElementById('new-token-value').innerText).then(()=>{this.innerText='✓';setTimeout(()=>{this.innerText='Copiar'},1500)})"
            class="absolute right-2 top-1/2 -translate-y-1/2 btn btn-xs btn-ghost"
            id="copy-token-btn"
            aria-label="Copiar al portapapeles"
          >
            Copiar
          </button>
        </div>
        <p class="text-xs mt-2 text-base-content/70">
          Copia esta clave ahora. No se volverá a mostrar.
        </p>
      </div>
      <button
        phx-click="dismiss_token"
        class="btn btn-sm btn-ghost"
        id="dismiss-token-btn"
        aria-label="Cerrar"
      >
        <.icon name="hero-x-mark" class="w-4 h-4" />
      </button>
    </div>

    <%!-- Personal API keys --%>
    <section>
      <h2 class="text-base font-semibold mb-3">Tus claves</h2>

      <%= if @memberships == [] do %>
        <div class="text-center py-8 text-base-content/40">
          <.icon name="hero-key" class="w-8 h-8 mx-auto mb-2 opacity-40" />
          <p>No perteneces a ningún equipo todavía.</p>
        </div>
      <% else %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= for membership <- @memberships do %>
            <div
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
              id={"membership-#{membership.id}"}
            >
              <div class="card-body p-5">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-semibold text-base-content">{membership.team.name}</h3>
                    <p class="text-xs text-base-content/50 mt-0.5 capitalize">
                      {membership.team_role}
                    </p>
                  </div>
                  <span class={["badge", "badge-sm", key_status_badge(membership)]}>
                    {key_status_label(membership)}
                  </span>
                </div>

                <div class="mt-3">
                  <p class="text-xs text-base-content/50 uppercase tracking-wide">Clave</p>
                  <code class="text-sm font-mono">{masked_key(membership)}</code>
                </div>

                <%= if membership.api_key do %>
                  <p class="text-xs text-base-content/40 mt-2">
                    Creada el {format_date(membership.api_key.inserted_at)}
                  </p>

                  <div class="flex gap-2 mt-3">
                    <button
                      phx-click="replace_key"
                      phx-value-id={membership.id}
                      data-confirm="¿Reemplazar clave? La clave anterior dejará de funcionar inmediatamente."
                      class="btn btn-sm btn-primary"
                      id={"replace-#{membership.id}"}
                    >
                      <.icon name="hero-arrow-path" class="w-4 h-4" /> Reemplazar
                    </button>

                    <%= if membership.api_key.status == "active" do %>
                      <button
                        phx-click="revoke_key"
                        phx-value-id={membership.id}
                        data-confirm="¿Revocar clave? Esta acción no se puede deshacer."
                        class="btn btn-sm btn-ghost text-error"
                        id={"revoke-#{membership.id}"}
                      >
                        <.icon name="hero-no-symbol" class="w-4 h-4" /> Revocar
                      </button>
                    <% end %>
                  </div>
                <% else %>
                  <p class="text-xs text-base-content/40 mt-2">Sin clave generada</p>
                  <div class="mt-3">
                    <button
                      phx-click="replace_key"
                      phx-value-id={membership.id}
                      class="btn btn-sm btn-primary"
                      id={"generate-#{membership.id}"}
                    >
                      <.icon name="hero-key" class="w-4 h-4" /> Generar clave
                    </button>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <%!-- Teams & budgets --%>
    <section id="teams-budgets-section">
      <h2 class="text-base font-semibold mb-3">Tus equipos</h2>

      <%= if @team_budgets == [] do %>
        <div class="text-center py-8 text-base-content/40">
          <.icon name="hero-user-group" class="w-8 h-8 mx-auto mb-2 opacity-40" />
          <p>No perteneces a ningún equipo todavía.</p>
        </div>
      <% else %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= for tb <- @team_budgets do %>
            <div
              class="card bg-base-100 border border-base-300 shadow-sm"
              id={"team-budget-#{tb.team.id}"}
            >
              <div class="card-body p-5">
                <div class="flex items-center justify-between">
                  <h3 class="font-semibold text-base-content">{tb.team.name}</h3>
                  <.link
                    patch={~p"/dashboard/teams"}
                    class="btn btn-xs btn-ghost"
                  >
                    <.icon name="hero-arrow-right" class="w-3 h-3" />
                  </.link>
                </div>

                <div class="mt-3 space-y-3">
                  <%!-- Daily budget --%>
                  <div>
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-base-content/60">Gasto diario</span>
                      <span class="font-mono">
                        ${format_decimal(tb.daily_spend)}
                        <span class="text-base-content/40">
                          / {if tb.daily_limit, do: "${format_decimal(tb.daily_limit)}", else: "∞"}
                        </span>
                      </span>
                    </div>
                    <div class="mt-1 h-2 rounded-full bg-base-200 overflow-hidden">
                      <div
                        class={[
                          "h-full rounded-full transition-all",
                          budget_bar_class(budget_pct(tb.daily_spend, tb.daily_limit))
                        ]}
                        style={"width: #{min(budget_pct(tb.daily_spend, tb.daily_limit) || 0, 100)}%"}
                      >
                      </div>
                    </div>
                  </div>

                  <%!-- Monthly budget --%>
                  <div>
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-base-content/60">Gasto mensual</span>
                      <span class="font-mono">
                        ${format_decimal(tb.monthly_spend)}
                        <span class="text-base-content/40">
                          / {if tb.monthly_limit,
                            do: "${format_decimal(tb.monthly_limit)}",
                            else: "∞"}
                        </span>
                      </span>
                    </div>
                    <div class="mt-1 h-2 rounded-full bg-base-200 overflow-hidden">
                      <div
                        class={[
                          "h-full rounded-full transition-all",
                          budget_bar_class(budget_pct(tb.monthly_spend, tb.monthly_limit))
                        ]}
                        style={"width: #{min(budget_pct(tb.monthly_spend, tb.monthly_limit) || 0, 100)}%"}
                      >
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <%!-- Metrics section --%>
    <%= if @loading do %>
      <div class="flex items-center justify-center py-20">
        <span class="loading loading-spinner loading-lg text-primary"></span>
        <span class="ml-3 text-base-content/60">Cargando métricas…</span>
      </div>
    <% else %>
      <%= if @metrics.requests_total == 0 do %>
        <div id="empty-state" class="flex flex-col items-center justify-center py-20 text-center">
          <div class="w-20 h-20 rounded-full bg-base-300 flex items-center justify-center mb-4">
            <.icon name="hero-chart-bar" class="w-10 h-10 text-base-content/40" />
          </div>
          <h3 class="text-lg font-semibold text-base-content">Aún no hay requests</h3>
          <p class="mt-2 text-sm text-base-content/60 max-w-md">
            Manda tu primer request al proxy para ver métricas aquí.
          </p>
        </div>
      <% else %>
        <!-- Metric cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div
            id="requests-card"
            class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
          >
            <div class="card-body p-5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                  Requests (24h)
                </span>
                <span class={[
                  "flex items-center justify-center w-9 h-9 rounded-lg",
                  accent_bg("primary")
                ]}>
                  <.icon
                    name="hero-arrow-trending-up"
                    class={["w-5 h-5", accent_text("primary")]}
                  />
                </span>
              </div>
              <p class="mt-2 text-2xl font-bold text-base-content">
                {format_number(@metrics.requests_total)}
              </p>
            </div>
          </div>

          <div
            id="error-rate-card"
            class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
          >
            <div class="card-body p-5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                  Tasa de error
                </span>
                <span class={[
                  "flex items-center justify-center w-9 h-9 rounded-lg",
                  accent_bg(if(@metrics.error_rate > 0.05, do: "error", else: "success"))
                ]}>
                  <.icon
                    name="hero-exclamation-triangle"
                    class={[
                      "w-5 h-5",
                      accent_text(if(@metrics.error_rate > 0.05, do: "error", else: "success"))
                    ]}
                  />
                </span>
              </div>
              <p class="mt-2 text-2xl font-bold text-base-content">
                {Float.round(@metrics.error_rate * 100, 2)}%
              </p>
            </div>
          </div>

          <div
            id="cost-card"
            class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
          >
            <div class="card-body p-5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                  Costo
                </span>
                <span class={[
                  "flex items-center justify-center w-9 h-9 rounded-lg",
                  accent_bg("accent")
                ]}>
                  <.icon name="hero-currency-dollar" class={["w-5 h-5", accent_text("accent")]} />
                </span>
              </div>
              <p class="mt-2 text-2xl font-bold text-base-content">
                ${format_decimal(@metrics.cost_usd)}
              </p>
            </div>
          </div>

          <div
            id="savings-card"
            class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
          >
            <div class="card-body p-5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                  Ahorros
                </span>
                <span class={[
                  "flex items-center justify-center w-9 h-9 rounded-lg",
                  accent_bg("success")
                ]}>
                  <.icon name="hero-banknotes" class={["w-5 h-5", accent_text("success")]} />
                </span>
              </div>
              <p class="mt-2 text-2xl font-bold text-base-content">
                ${format_decimal(@metrics.savings_usd)}
              </p>
            </div>
          </div>
        </div>

        <!-- Tokens + latency -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body">
              <h2 class="card-title text-base">
                <.icon name="hero-cpu-chip" class="w-5 h-5 text-base-content/60" /> Tokens
              </h2>
              <div class="grid grid-cols-2 gap-4 mt-2">
                <div>
                  <p class="text-xs text-base-content/50 uppercase tracking-wide">Prompt</p>
                  <p id="prompt-tokens" class="text-2xl font-semibold">
                    {format_number(@metrics.prompt_tokens)}
                  </p>
                </div>
                <div>
                  <p class="text-xs text-base-content/50 uppercase tracking-wide">Completion</p>
                  <p id="completion-tokens" class="text-2xl font-semibold">
                    {format_number(@metrics.completion_tokens)}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body">
              <h2 class="card-title text-base">
                <.icon name="hero-clock" class="w-5 h-5 text-base-content/60" /> Latencia
              </h2>
              <div class="grid grid-cols-2 gap-4 mt-2">
                <div>
                  <p class="text-xs text-base-content/50 uppercase tracking-wide">Promedio</p>
                  <p id="latency-avg" class="text-2xl font-semibold">
                    {Float.round(@metrics.latency_avg_ms, 1)} ms
                  </p>
                </div>
                <div>
                  <p class="text-xs text-base-content/50 uppercase tracking-wide">P95</p>
                  <p id="latency-p95" class="text-2xl font-semibold">
                    {@metrics.latency_p95_ms} ms
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Hourly cost chart (inline SVG bars, no JS libs) -->
        <div id="hourly-chart" class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-base">
              <.icon name="hero-chart-bar" class="w-5 h-5 text-base-content/60" />
              Costo por hora (24h)
            </h2>

            <%= if @hourly_series == [] or chart_max_cost(@hourly_series) == 0.0 do %>
              <div class="h-40 flex items-center justify-center text-base-content/40 text-sm">
                Sin datos para las últimas 24 horas.
              </div>
            <% else %>
              <% max_cost = chart_max_cost(@hourly_series) %>
              <% bar_count = max(length(@hourly_series), 1) %>
              <% bar_width = max(380 / bar_count - 4, 2) %>
              <svg viewBox="0 0 400 150" class="w-full h-40 mt-4" preserveAspectRatio="none">
                <%= for {row, i} <- Enum.with_index(@hourly_series) do %>
                  <% cost = Decimal.to_float(row.cost_usd) %>
                  <% height = if max_cost > 0, do: max(cost / max_cost * 120, 1), else: 1 %>
                  <% x = 10 + i * (bar_width + 4) %>
                  <% y = 140 - height %>
                  <rect
                    x={x}
                    y={y}
                    width={bar_width}
                    height={height}
                    rx="2"
                    class="fill-primary/70 hover:fill-primary transition-colors"
                  >
                    <title>
                      {Calendar.strftime(row.hour, "%H:%M")} — ${Float.round(cost, 6)}
                    </title>
                  </rect>
                <% end %>
                <line x1="10" y1="140" x2="390" y2="140" class="stroke-base-300" stroke-width="1" />
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</Layouts.dashboard>
