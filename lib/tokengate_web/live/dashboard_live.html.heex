<Layouts.dashboard
  flash={@flash}
  current_scope={@current_user}
  impersonator={@impersonator}
  current_path={@current_path}
>
  <div class="space-y-6">
    <.header>
      {gettext("Dashboard")}
      <:subtitle>
        <span class="inline-flex items-center gap-2">
          <.icon name="hero-funnel" class="w-4 h-4 text-base-content/50" />
          {@scope_label}
        </span>
      </:subtitle>
      <%!-- Period selector + loading spinner. The selector is the SHARED
           canonical one (same four windows and labels as /stats) and it
           patches the query string, so the active period lives in the URL. --%>
      <:actions :if={@has_access}>
        <div class="flex items-center gap-3">
          <span
            :if={@loading and @displayed_period != nil}
            class="loading loading-spinner loading-sm text-primary"
            id="dashboard-loading"
            title={gettext("Refreshing metrics…")}
          ></span>
          <.period_selector target={~p"/dashboard"} period={@period} />
        </div>
      </:actions>
    </.header>

    <%!-- One-time new token alert — verde de éxito: es una clave CREADA, no una
         advertencia; mismo tratamiento que el banner de /services. El token
         vive aquí y SOLO aquí: es el único momento en que se puede copiar. --%>
    <div :if={@new_token} class="alert alert-success shadow-lg" id="new-token-alert" role="alert">
      <.icon name="hero-key" class="w-5 h-5 shrink-0" />
      <div class="flex-1">
        <p class="font-semibold">
          {gettext("New key generated for %{group}", group: @new_token_group)}
        </p>
        <div class="relative mt-2">
          <code
            class="block p-2 pr-24 bg-black/10 rounded text-sm font-mono break-all select-all"
            id="new-token-value"
          >
            {@new_token}
          </code>
          <button
            type="button"
            id="copy-token-btn"
            aria-label={gettext("Copy the key to the clipboard")}
            title={gettext("Copy the key to the clipboard")}
            phx-hook=".CopyToken"
            data-source="new-token-value"
            data-copied-label={gettext("Copied!")}
            class="absolute right-2 top-1/2 -translate-y-1/2 btn btn-xs btn-ghost"
          >
            <.icon name="hero-clipboard-document" class="w-3.5 h-3.5" />
            <span data-copy-label>{gettext("Copy")}</span>
          </button>
        </div>
        <p class="text-xs mt-2 opacity-80">
          {gettext("Copy this key now. It will not be shown again.")}
        </p>
      </div>
      <button
        phx-click="dismiss_token"
        class="btn btn-sm btn-ghost"
        id="dismiss-token-btn"
        aria-label={gettext("Close")}
      >
        <.icon name="hero-x-mark" class="w-4 h-4" />
      </button>
    </div>

    <%!-- Copy hook for the one-time token. It copies the VISIBLE token and
         swaps only the label span, so the clipboard icon survives the
         "Copied!" feedback — the global CopyToClipboard hook rewrites the
         button's whole textContent and eats the icon after the first click. --%>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyToken">
      export default {
        mounted() {
          this.el.addEventListener("click", () => {
            const source = document.getElementById(this.el.dataset.source)
            if (!source) return
            navigator.clipboard.writeText(source.textContent.trim()).then(() => {
              const label = this.el.querySelector("[data-copy-label]")
              if (!label || label.dataset.copied) return
              const original = label.textContent
              label.dataset.copied = "true"
              label.textContent = this.el.dataset.copiedLabel || "Copied!"
              setTimeout(() => {
                label.textContent = original
                delete label.dataset.copied
              }, 1500)
            })
          })
        }
      }
    </script>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyValue">
      export default {
        mounted() {
          this.el.addEventListener("click", () => {
            const text = this.el.dataset.copyText
            if (!text || !navigator.clipboard?.writeText) return
            navigator.clipboard.writeText(text).then(() => {
              const label = this.el.querySelector("[data-copy-label]")
              if (!label || label.dataset.copied) return
              const original = label.textContent
              label.dataset.copied = "true"
              label.textContent = this.el.dataset.copiedLabel || "Copied!"
              setTimeout(() => {
                label.textContent = original
                delete label.dataset.copied
              }, 1500)
            }).catch(() => {})
          })
        }
      }
    </script>

    <%!-- Groups + models catalog + supervised services — arriba de métricas --%>
    <section id="groups-section">
      <%= if @groups == [] and not @has_access do %>
        <div class="text-center py-12 text-base-content/50" id="no-group-state">
          <.icon name="hero-user-group" class="w-10 h-10 mx-auto mb-3 opacity-40" />
          <p class="font-medium">{gettext("You have no limit profile assigned.")}</p>
          <p class="text-sm mt-1 text-base-content/40">
            {gettext("Ask an administrator to assign you a limit profile.")}
          </p>
        </div>
      <% else %>
        <% card_count = length(@groups) + if(@supervised_services_count > 0, do: 1, else: 0) %>
        <div class={[
          "grid grid-cols-1 gap-4",
          card_count > 1 && "lg:grid-cols-2",
          card_count > 0 && "mb-6"
        ]}>
          <%= for t <- @groups do %>
            <div
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow h-full"
              id={"group-#{t.group.id}"}
            >
              <div class="card-body p-5 flex flex-col h-full">
                <%!-- Header: group name, key status --%>
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-semibold text-base-content">{t.group.name}</h3>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class={["badge", "badge-sm", key_status_badge(t)]}>
                      {key_status_label(t)}
                    </span>
                  </div>
                </div>

                <%!-- API key section. Only the PREFIX is rendered: the token
                     itself is never in the DOM after issuance, so there is
                     nothing to copy here (a "copy" button here would copy a
                     mask that does not authenticate). --%>
                <div class="mt-3">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-xs text-base-content/50 uppercase tracking-wide">
                      {gettext("API key")}
                    </p>
                    <button
                      type="button"
                      phx-click="manage_keys"
                      class="btn btn-soft btn-primary btn-xs gap-1.5"
                      id={"manage-keys-#{t.group.id}"}
                      title={gettext("View, create and revoke your API keys")}
                    >
                      <.icon name="hero-key" class="w-3.5 h-3.5" />
                      <span>{gettext("Manage keys")}</span>
                      <span
                        class="badge badge-xs badge-primary"
                        id={"active-keys-count-#{t.group.id}"}
                      >
                        {@active_keys_count}
                      </span>
                    </button>
                  </div>
                  <div class="flex items-center gap-1" id={"api-key-row-#{t.membership.id}"}>
                    <code class="text-sm font-mono" id={"api-key-text-#{t.membership.id}"}>
                      {masked_key(t)}
                    </code>
                  </div>
                </div>

                <%= if t.api_key && t.api_key.status == "active" do %>
                  <p class="text-xs text-base-content/40 mt-1">
                    {gettext("Created on %{date}",
                      date: format_date(t.api_key.inserted_at, @timezone)
                    )}
                  </p>

                  <div class="flex gap-2 mt-3">
                    <%!-- Revoke = issue a new key and void the previous one. --%>
                    <button
                      phx-click="revoke_key"
                      phx-value-id={t.membership.id}
                      data-confirm={
                        gettext(
                          "Revoke this key? A new one is issued and this token stops working."
                        )
                      }
                      class="btn btn-ghost btn-sm text-warning"
                      id={"revoke-#{t.membership.id}"}
                      title={
                        gettext(
                          "Revoke: issues a new key and voids the previous one immediately."
                        )
                      }
                    >
                      <.icon name="hero-arrow-path" class="w-4 h-4" /> {gettext("Revoke")}
                    </button>

                    <%!-- Delete = soft-hide: it leaves the listings and the
                         historical consumption keeps its attribution. --%>
                    <button
                      phx-click="hide_key"
                      phx-value-id={t.membership.id}
                      data-confirm={
                        gettext(
                          "Delete this key? It disappears from the listings and its token stops working; historical consumption is preserved."
                        )
                      }
                      class="btn btn-sm btn-ghost text-error"
                      id={"hide-#{t.membership.id}"}
                      title={
                        gettext(
                          "Delete: hides the key from every surface and preserves historical consumption."
                        )
                      }
                    >
                      <.icon name="hero-trash" class="w-4 h-4" /> {gettext("Delete key")}
                    </button>
                  </div>

                  <p
                    class="text-xs text-base-content/40 mt-2"
                    id={"key-actions-help-#{t.membership.id}"}
                  >
                    {gettext(
                      "Revoke issues a new key and voids the previous one · Delete hides the key from the listings and preserves historical consumption."
                    )}
                  </p>
                <% else %>
                  <p class="text-xs text-base-content/40 mt-1">
                    {if t.api_key,
                      do: gettext("Key revoked"),
                      else: gettext("No key generated")}
                  </p>
                  <div class="mt-3">
                    <button
                      phx-click="generate_key"
                      phx-value-id={t.membership.id}
                      class="btn btn-sm btn-primary btn-soft"
                      id={"generate-#{t.membership.id}"}
                    >
                      <.icon name="hero-key" class="w-4 h-4" /> {gettext("Generate key")}
                    </button>
                  </div>
                <% end %>

                <%!-- {gettext("Monthly cap")} + top-ups — mt-auto pushes to bottom --%>
                <div class="mt-auto pt-4 border-t border-base-200 space-y-3">
                  <div>
                    <%= if credit_visible?(t.credit) do %>
                      <% cpct = credit_pct(t.credit) %>
                      <div class="flex items-center justify-between text-xs mb-1.5">
                        <span class="text-base-content/60">{gettext("Monthly cap")}</span>
                        <.budget_badge pct={cpct} />
                      </div>
                      <.budget_bar
                        spend={t.credit.limit_spend_usd}
                        limit={t.credit.limit_usd}
                        pct={cpct}
                      />
                      <div
                        :if={Decimal.compare(t.credit.remaining_topup_usd, 0) == :gt}
                        class="flex items-center justify-between text-xs mt-2"
                      >
                        <span class="text-base-content/60">{gettext("Available top-ups")}</span>
                        <span class="font-mono text-success">
                          ${format_decimal(t.credit.remaining_topup_usd)}
                        </span>
                      </div>
                    <% else %>
                      <div class="flex items-center justify-between text-xs">
                        <span class="text-base-content/60">{gettext("Monthly cap")}</span>
                        <span class="text-base-content/40">{gettext("No budget")}</span>
                      </div>
                      <div class="flex items-center justify-between text-xs mt-1">
                        <span class="text-base-content/60">{gettext("Monthly spend")}</span>
                        <span class="font-mono">${format_decimal(t.monthly_spend)}</span>
                      </div>
                      <div
                        :if={t.credit && Decimal.compare(t.credit.remaining_topup_usd, 0) == :gt}
                        class="flex items-center justify-between text-xs mt-1"
                      >
                        <span class="text-base-content/60">{gettext("Available top-ups")}</span>
                        <span class="font-mono text-success">
                          ${format_decimal(t.credit.remaining_topup_usd)}
                        </span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <%!-- Supervised services shortcut — visible when the user supervises any service --%>
          <.link
            :if={@supervised_services_count > 0}
            navigate={~p"/services/supervised"}
            class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow block"
            id="supervised-services-card"
          >
            <div class="card-body p-5 flex flex-col h-full">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="font-semibold text-base-content">
                    {gettext("Supervised services")}
                  </h3>
                  <p class="text-xs text-base-content/50 mt-0.5">
                    {gettext("%{count} assigned service(s) · Read-only view",
                      count: @supervised_services_count
                    )}
                  </p>
                </div>
                <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-primary/10">
                  <.icon name="hero-eye" class="w-5 h-5 text-primary" />
                </span>
              </div>
            </div>
          </.link>
        </div>

        <%!-- Read-only accessible models catalog with lab logos, API URLs, and informational market prices --%>
        <% filtered_models =
          filter_accessible_models(@accessible_models, @accessible_models_query) %>
        <% show_market_col = Enum.any?(@accessible_models, &Model.has_market_prices?(&1.model)) %>
        <div
          :if={@groups != [] or @accessible_models != []}
          class="card bg-base-100 border border-base-300 shadow-sm mb-6"
          id="accessible-models-card"
        >
          <div class="card-body p-5 gap-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <div class="flex items-center gap-2">
                  <.icon name="hero-cube" class="w-5 h-5 text-base-content/60" />
                  <h3 class="font-semibold text-base-content">
                    {gettext("Available models")}
                  </h3>
                  <span class="badge badge-sm badge-ghost" id="accessible-models-count">
                    {length(@accessible_models)}
                  </span>
                  <span class="badge badge-xs badge-outline text-base-content/50">
                    {gettext("Read-only")}
                  </span>
                </div>
                <p class="text-xs text-base-content/50 mt-0.5">
                  {gettext("Models granted to your account and the API endpoint for each")}
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <div class="flex items-center gap-1.5 rounded-lg border border-base-300 bg-base-200/40 px-2.5 py-1">
                  <span class="text-[10px] uppercase tracking-wide text-base-content/50">
                    {gettext("Base URL")}
                  </span>
                  <code class="text-xs font-mono text-base-content/80" id="dashboard-api-base-url">
                    {"#{@api_base_url}/v1"}
                  </code>
                  <button
                    type="button"
                    id="copy-api-base-url"
                    phx-hook=".CopyValue"
                    data-copy-text={"#{@api_base_url}/v1"}
                    data-copied-label={gettext("Copied!")}
                    class="btn btn-xs btn-ghost px-1.5"
                    title={gettext("Copy base URL")}
                  >
                    <.icon name="hero-clipboard-document" class="w-3.5 h-3.5" />
                    <span data-copy-label class="text-[10px]">{gettext("Copy")}</span>
                  </button>
                </div>

                <.form
                  :if={length(@accessible_models) > 4}
                  for={%{}}
                  id="accessible-models-search-form"
                  phx-change="search_accessible_models"
                  phx-submit="search_accessible_models"
                >
                  <div class="relative">
                    <.icon
                      name="hero-magnifying-glass"
                      class="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-base-content/40"
                    />
                    <input
                      type="text"
                      name="q"
                      id="accessible-models-search"
                      value={@accessible_models_query}
                      placeholder={gettext("Search models…")}
                      phx-debounce="200"
                      autocomplete="off"
                      class="input input-xs input-bordered pl-8 w-44 sm:w-56"
                    />
                  </div>
                </.form>
              </div>
            </div>

            <%= if @accessible_models == [] do %>
              <p
                class="text-sm text-base-content/40 py-4 text-center"
                id="accessible-models-empty"
              >
                {gettext("No models granted to your profile yet.")}
              </p>
            <% else %>
              <div class="overflow-x-auto">
                <.table
                  id="accessible-models-table"
                  rows={filtered_models}
                  row_id={fn item -> "accessible-model-#{item.model.id}" end}
                  empty?={filtered_models == []}
                  empty_text={gettext("No models match your search.")}
                >
                  <:col :let={item} label={gettext("Model")}>
                    <div class="flex items-center gap-2.5 min-w-0">
                      <.model_mark
                        mark={item.mark}
                        id={"accessible-model-mark-#{item.model.id}"}
                      />
                      <div class="min-w-0">
                        <div class="flex items-center gap-1.5">
                          <span class="font-mono font-medium text-sm text-base-content truncate">
                            {item.model.name}
                          </span>
                          <span
                            :if={item.model.pinned}
                            class="text-warning shrink-0"
                            title={gettext("Pinned")}
                          >
                            <.icon name="hero-star-solid" class="w-3 h-3" />
                          </span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 text-[11px] text-base-content/50">
                          <span class="tabular-nums">
                            {format_compact(item.model.context_window)} ctx
                          </span>
                          <span
                            :for={profile <- item.profiles}
                            :if={length(@groups) > 1}
                            class="badge badge-xs badge-ghost"
                          >
                            {profile}
                          </span>
                        </div>
                      </div>
                    </div>
                  </:col>
                  <:col :let={item} label={gettext("Type")}>
                    <span class="badge badge-sm badge-outline badge-info whitespace-nowrap">
                      {item.model.model_type}
                    </span>
                  </:col>
                  <:col :let={item} label={gettext("API URL")}>
                    <%= if item.api_url do %>
                      <div class="flex items-center gap-1.5 min-w-0">
                        <span class="badge badge-xs badge-ghost font-mono shrink-0">POST</span>
                        <code
                          id={"accessible-model-url-#{item.model.id}"}
                          class="font-mono text-xs text-base-content/80 whitespace-nowrap"
                        >
                          {item.api_url}
                        </code>
                        <button
                          type="button"
                          id={"copy-model-url-#{item.model.id}"}
                          phx-hook=".CopyValue"
                          data-copy-text={item.api_url}
                          data-copied-label={gettext("Copied!")}
                          class="btn btn-xs btn-ghost px-1.5 shrink-0"
                          title={gettext("Copy API URL")}
                        >
                          <.icon name="hero-clipboard-document" class="w-3.5 h-3.5" />
                          <span data-copy-label class="sr-only">{gettext("Copy")}</span>
                        </button>
                      </div>
                    <% else %>
                      <span class="text-base-content/30">—</span>
                    <% end %>
                  </:col>
                  <:col
                    :let={item}
                    :if={show_market_col}
                    label={gettext("Market ref (USD / 1M)")}
                    align="right"
                    tooltip={
                      gettext(
                        "Informational market reference only — actual cost depends on upstream usage"
                      )
                    }
                  >
                    <%= if Model.has_market_prices?(item.model) do %>
                      <div
                        id={"accessible-model-market-#{item.model.id}"}
                        class="text-xs whitespace-nowrap tabular-nums"
                        title={
                          gettext(
                            "Informational market reference only — not used for billing or budget deductions"
                          )
                        }
                      >
                        <span>
                          {format_market_price(item.model.market_input_price_per_1m)}
                          <span class="text-base-content/40">in</span>
                          <span class="text-base-content/30">·</span>
                          {format_market_price(item.model.market_output_price_per_1m)}
                          <span class="text-base-content/40">out</span>
                        </span>
                        <div
                          :if={item.model.market_cache_price_per_1m}
                          class="text-[10px] text-base-content/50"
                        >
                          {format_market_price(item.model.market_cache_price_per_1m)} cache
                        </div>
                      </div>
                    <% else %>
                      <span class="text-base-content/30">—</span>
                    <% end %>
                  </:col>
                </.table>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>

    <%= if @has_access do %>
      <%!-- Metrics section. The skeleton shows only on the very first load
           (the bundle lands async after mount); period switches keep the
           previous bundle visible (dimmed) until the new one lands, so the
           click feels instant. --%>
      <%= if @loading and @displayed_period == nil do %>
        <div id="metrics-skeleton" class="space-y-6" aria-busy="true" aria-live="polite">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div
              :for={i <- 1..4}
              class="card bg-base-100 border border-base-300 shadow-sm animate-pulse"
              data-skeleton={i}
            >
              <div class="card-body p-5 space-y-3">
                <div class="h-3 w-24 rounded bg-base-300"></div>
                <div class="h-7 w-32 rounded bg-base-300"></div>
                <div class="h-2 w-20 rounded bg-base-200"></div>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div
              :for={i <- 1..4}
              class="card bg-base-100 border border-base-300 shadow-sm animate-pulse"
              data-skeleton-chart={i}
            >
              <div class="card-body p-5 space-y-3">
                <div class="h-3 w-20 rounded bg-base-300"></div>
                <div class="h-40 rounded bg-base-200"></div>
              </div>
            </div>
          </div>
          <span class="sr-only">{gettext("Loading metrics…")}</span>
        </div>
      <% else %>
        <% title_period = @displayed_period || @period %>
        <div class={["space-y-6 transition-opacity duration-200", @loading && "opacity-60"]}>
          <%= if @metrics.requests_total == 0 do %>
            <div
              id="empty-state"
              class="flex flex-col items-center justify-center py-12 text-center"
            >
              <div class="w-20 h-20 rounded-full bg-base-300 flex items-center justify-center mb-4">
                <.icon name="hero-chart-bar" class="w-10 h-10 text-base-content/40" />
              </div>
              <h3 class="text-lg font-semibold text-base-content">
                {gettext("No requests yet")}
              </h3>
              <p class="mt-2 text-sm text-base-content/60 max-w-md">
                {gettext("Send your first request to the proxy to see metrics here.")}
              </p>
            </div>
          <% else %>
            <%!-- KPI cards canónicas — mismo componente que /stats (DESIGN.md C4/C5).
                 En /dashboard el costo muestra SOLO el gasto del período
                 seleccionado (uniforme con Requests/Tokens/TPS), sin el marco
                 UTC del tope global. --%>
            <.kpi_cards
              metrics={@metrics}
              deltas={@metrics[:deltas]}
              period={@period}
              cost_window="period"
              timezone={@timezone}
            />

            <!-- Breakdown tabs -->
            <div class="card bg-base-100 border border-base-300 shadow-sm">
              <div class="card-body">
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <h2 class="card-title text-base">
                    <.icon name="hero-chart-bar-square" class="w-5 h-5 text-base-content/60" />
                    {gettext("Breakdown")}
                  </h2>
                  <div class="join" id="breakdown-tabs" role="tablist">
                    <button
                      phx-click="set_breakdown"
                      phx-value-tab="model"
                      class={[
                        "join-item btn btn-sm",
                        if(breakdown_tab_active?(@active_breakdown, "model"),
                          do: "btn-primary",
                          else: "btn-ghost"
                        )
                      ]}
                      id="tab-model"
                    >
                      {gettext("By model")}
                    </button>
                    <button
                      phx-click="set_breakdown"
                      phx-value-tab="member"
                      class={[
                        "join-item btn btn-sm",
                        if(breakdown_tab_active?(@active_breakdown, "member"),
                          do: "btn-primary",
                          else: "btn-ghost"
                        )
                      ]}
                      id="tab-member"
                    >
                      {gettext("By API key")}
                    </button>
                  </div>
                </div>

                <%!-- Model breakdown --%>
                <%= if @active_breakdown == "model" do %>
                  <%= if has_breakdown_data?(@breakdown_model) do %>
                    <div class="overflow-x-auto mt-3">
                      <.table
                        id="bd-model-rows"
                        rows={@breakdown_model}
                        row_id={fn row -> "bd-model-#{row.model_id || "unknown"}" end}
                      >
                        <:col :let={row} label={gettext("Model")}>
                          <div class="flex items-center gap-2 font-medium">
                            <.model_mark
                              mark={Map.get(@model_marks, row.model_id)}
                              id={"bd-model-mark-#{row.model_id || "unknown"}"}
                            />
                            <span>{row.model_name}</span>
                          </div>
                        </:col>
                        <:col :let={row} label={gettext("Requests")} align="right">
                          <span class="font-mono">{format_number(row.request_count)}</span>
                        </:col>
                        <:col :let={row} label={gettext("Cost")} align="right">
                          <span class="font-mono">${format_decimal(row.cost_usd)}</span>
                        </:col>
                        <:col :let={row} label={gettext("Tokens in")} align="right">
                          <span class="font-mono">{format_number(row.prompt_tokens)}</span>
                        </:col>
                        <:col :let={row} label={gettext("Tokens out")} align="right">
                          <span class="font-mono">{format_number(row.completion_tokens)}</span>
                        </:col>
                        <:col :let={row} label={gettext("TPS")} align="right">
                          <span class="font-mono">{format_tps(row.avg_tps)}</span>
                        </:col>
                      </.table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      {gettext("No data for this period.")}
                    </p>
                  <% end %>
                <% end %>

                <%!-- API key breakdown --%>
                <%= if @active_breakdown == "member" do %>
                  <%= if has_breakdown_data?(@breakdown_member) do %>
                    <div class="overflow-x-auto mt-3">
                      <.table
                        id="bd-member-rows"
                        rows={@breakdown_member}
                        row_id={fn row -> row.dom_id end}
                      >
                        <:col :let={row} label={gettext("API key")}>
                          <%= cond do %>
                            <% row.label -> %>
                              <div class="font-medium">{row.label}</div>
                              <code
                                :if={row.masked_prefix}
                                class="text-xs font-mono text-base-content/50"
                              >
                                {row.masked_prefix}
                              </code>
                            <% row.masked_prefix -> %>
                              <code class="text-sm font-mono">{row.masked_prefix}</code>
                            <% true -> %>
                              <span class="text-base-content/60">{gettext("Unattributed")}</span>
                          <% end %>
                        </:col>
                        <:col :let={row} label={gettext("Status")}>
                          <%= case row.status do %>
                            <% "active" -> %>
                              <span class="badge badge-sm badge-success">{gettext("Active")}</span>
                            <% "revoked" -> %>
                              <span class="badge badge-sm badge-error">{gettext("Revoked")}</span>
                            <% _ -> %>
                              <span class="text-base-content/40">—</span>
                          <% end %>
                        </:col>
                        <:col :let={row} label={gettext("Requests")} align="right">
                          <span class="font-mono">{format_number(row.request_count)}</span>
                        </:col>
                        <:col :let={row} label={gettext("Cost")} align="right">
                          <span class="font-mono">${format_decimal(row.cost_usd)}</span>
                        </:col>
                        <:col :let={row} label={gettext("Tokens in")} align="right">
                          <span class="font-mono">{format_number(row.prompt_tokens)}</span>
                        </:col>
                        <:col :let={row} label={gettext("Tokens out")} align="right">
                          <span class="font-mono">{format_number(row.completion_tokens)}</span>
                        </:col>
                        <:col :let={row} label={gettext("TPS")} align="right">
                          <span class="font-mono">{format_tps(row.avg_tps)}</span>
                        </:col>
                      </.table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      {gettext("No data for this period.")}
                    </p>
                  <% end %>
                <% end %>
              </div>
            </div>

            <%!-- Charts: cost / requests / tokens per hour --%>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" id="charts-grid">
              <.bar_chart
                id="cost-chart"
                title={chart_title(title_period)}
                icon="hero-currency-dollar"
                series={@cost_series}
                bar_class="fill-accent/70 hover:fill-accent"
                empty_label={
                  gettext("No data for %{period}.",
                    period: String.downcase(period_label(title_period))
                  )
                }
              />
              <.bar_chart
                id="requests-chart"
                title={requests_title(title_period)}
                icon="hero-arrow-trending-up"
                series={@requests_series}
                bar_class="fill-primary/70 hover:fill-primary"
                empty_label={
                  gettext("No data for %{period}.",
                    period: String.downcase(period_label(title_period))
                  )
                }
              />
              <.stacked_bar_chart
                id="tokens-chart"
                title={tokens_title(title_period)}
                icon="hero-cpu-chip"
                series={@tokens_series}
                empty_label={
                  gettext("No data for %{period}.",
                    period: String.downcase(period_label(title_period))
                  )
                }
              />
              <.bar_chart
                id="tps-chart"
                title={tps_title(title_period)}
                icon="hero-bolt"
                series={@tps_series}
                bar_class="fill-success/70 hover:fill-success"
                empty_label={
                  gettext("No data for %{period}.",
                    period: String.downcase(period_label(title_period))
                  )
                }
              />
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%!-- Mis claves API — el usuario logueado gestiona sus N claves con etiqueta
       desde el mismo panel que la página admin de usuarios. --%>
  <.modal
    :if={@keys_modal_open}
    id="user-keys-modal"
    title={gettext("My API keys")}
    on_close="cancel_manage_keys"
    max_w="max-w-2xl"
  >
    <p class="text-xs text-base-content/50 mb-4">
      {gettext("You can have several active keys, each with its own label.")}
    </p>

    <.keys_panel
      subject_kind="user"
      subject_id={@current_user.id}
      keys={@keys}
      spend={@keys_spend}
      new_token={@new_key_token}
      create_event="create_key"
      revoke_event="revoke_user_key"
      hide_event="hide_user_key"
      rename_event="rename_user_key"
      cancel_rename_event="cancel_rename_key"
      editing_key_id={@editing_key_id}
      dismiss_event="dismiss_new_key_token"
      sticky_event="clear_user_sticky_routes"
      empty_text={gettext("You have no active keys yet.")}
    />

    <div class="flex gap-2 mt-4 justify-end">
      <button type="button" phx-click="cancel_manage_keys" class="btn btn-ghost btn-sm">
        {gettext("Close")}
      </button>
    </div>
  </.modal>
</Layouts.dashboard>
