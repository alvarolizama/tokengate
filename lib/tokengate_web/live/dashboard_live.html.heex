<Layouts.dashboard
  flash={@flash}
  current_scope={@current_user}
  impersonator={@impersonator}
  current_path={@current_path}
>
  <div class="space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <.header>
        {gettext("Dashboard")}
        <:subtitle>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-funnel" class="w-4 h-4 text-base-content/50" />
            {@scope_label}
          </span>
        </:subtitle>
      </.header>

      <%!-- Period selector + loading spinner (mismo patrón que /stats) --%>
      <div :if={@has_access} class="flex items-center gap-3">
        <span
          :if={@loading and @displayed_period != nil}
          class="loading loading-spinner loading-sm text-primary"
          id="dashboard-loading"
          title={gettext("Refreshing metrics…")}
        ></span>
        <div class="join" id="period-selector" role="tablist">
          <button
            :for={period <- ~w(today 7d 30d 90d)}
            phx-click="set_period"
            phx-value-period={period}
            class={[
              "join-item btn btn-sm",
              if(period_active?(@period, period), do: "btn-primary", else: "btn-ghost")
            ]}
            id={"period-#{period}"}
          >
            <span
              :if={@loading and period_active?(@period, period)}
              class="loading loading-spinner loading-xs"
            ></span>
            {period_label(period)}
          </button>
        </div>
      </div>
    </div>

    <%!-- One-time new token alert — verde de éxito: es una clave CREADA, no una
         advertencia; mismo tratamiento que el banner de /services. --%>
    <div :if={@new_token} class="alert alert-success shadow-lg" id="new-token-alert" role="alert">
      <.icon name="hero-key" class="w-5 h-5 shrink-0" />
      <div class="flex-1">
        <p class="font-semibold">Nueva clave generada para {@new_token_group}</p>
        <div class="relative mt-2">
          <code
            class="block p-2 pr-24 bg-black/10 rounded text-sm font-mono break-all select-all"
            id="new-token-value"
          >
            {@new_token}
          </code>
          <button
            type="button"
            id="copy-token-btn"
            aria-label="Copiar al portapapeles"
            phx-hook="CopyToClipboard"
            data-target="new-token-value"
            class="absolute right-2 top-1/2 -translate-y-1/2 btn btn-xs btn-ghost"
          >
            {gettext("Copy")}
          </button>
        </div>
        <p class="text-xs mt-2 opacity-80">
          {gettext("Copy this key now. It will not be shown again.")}
        </p>
      </div>
      <button
        phx-click="dismiss_token"
        class="btn btn-sm btn-ghost"
        id="dismiss-token-btn"
        aria-label="Cerrar"
      >
        <.icon name="hero-x-mark" class="w-4 h-4" />
      </button>
    </div>

    <%!-- Groups + models catalog + supervised services — arriba de métricas --%>
    <section id="groups-section">
      <%= if @groups == [] and not @has_access do %>
        <div class="text-center py-12 text-base-content/50" id="no-group-state">
          <.icon name="hero-user-group" class="w-10 h-10 mx-auto mb-3 opacity-40" />
          <p class="font-medium">{gettext("You have no limit profile assigned.")}</p>
          <p class="text-sm mt-1 text-base-content/40">
            {gettext("Ask an administrator to assign you a limit profile.")}
          </p>
        </div>
      <% else %>
        <%!-- All cards full width, stacked vertically --%>
        <div class="grid grid-cols-1 gap-4 mb-6">
          <%= for t <- @groups do %>
            <div
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow h-full"
              id={"group-#{t.group.id}"}
            >
              <div class="card-body p-5 flex flex-col h-full">
                <%!-- Header: group name, role, key status --%>
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-semibold text-base-content">{t.group.name}</h3>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class={["badge", "badge-sm", key_status_badge(t)]}>
                      {key_status_label(t)}
                    </span>
                  </div>
                </div>

                <%!-- API key section --%>
                <div class="mt-3">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-xs text-base-content/50 uppercase tracking-wide">
                      {gettext("API key")}
                    </p>
                    <button
                      type="button"
                      phx-click="manage_keys"
                      class="btn btn-ghost btn-xs"
                      id={"manage-keys-#{t.group.id}"}
                      title={gettext("View, create and revoke your API keys")}
                    >
                      <.icon name="hero-key" class="w-3.5 h-3.5" /> Gestionar llaves
                    </button>
                  </div>
                  <div class="flex items-center gap-1" id={"api-key-row-#{t.membership.id}"}>
                    <code class="text-sm font-mono" id={"api-key-text-#{t.membership.id}"}>
                      {masked_key(t)}
                    </code>
                    <button
                      type="button"
                      phx-hook="CopyToClipboard"
                      data-target={"api-key-text-#{t.membership.id}"}
                      aria-label={gettext("Copy API key")}
                      title={gettext("Copy API key")}
                      class="btn btn-ghost btn-xs btn-square"
                      id={"copy-key-#{t.membership.id}"}
                    >
                      <.icon name="hero-clipboard-document" class="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>

                <%= if t.api_key do %>
                  <p class="text-xs text-base-content/40 mt-1">
                    Creada el {format_date(t.api_key.inserted_at, @timezone)}
                  </p>

                  <div class="flex gap-2 mt-3">
                    <button
                      phx-click="replace_key"
                      phx-value-id={t.membership.id}
                      data-confirm={
                        gettext(
                          "Regenerate key? The current key stops working immediately and a new one is issued."
                        )
                      }
                      class="btn btn-sm btn-primary"
                      id={"replace-#{t.membership.id}"}
                      title={
                        gettext(
                          "Regenerate: issues a new key and voids the current one. The limit profile keeps working, now with the new key."
                        )
                      }
                    >
                      <.icon name="hero-arrow-path" class="w-4 h-4" /> Regenerar clave
                    </button>

                    <%= if t.api_key.status == "active" do %>
                      <button
                        phx-click="revoke_key"
                        phx-value-id={t.membership.id}
                        data-confirm={
                          gettext("Revoke key? The key is voided and NO other is issued.")
                        }
                        class="btn btn-sm btn-ghost text-error"
                        id={"revoke-#{t.membership.id}"}
                        title={
                          gettext(
                            "Revoke: voids the key without issuing a new one. The limit profile loses access until you generate another."
                          )
                        }
                      >
                        <.icon name="hero-no-symbol" class="w-4 h-4" /> Revocar
                      </button>
                    <% end %>
                  </div>

                  <%= if t.api_key.status == "active" do %>
                    <p
                      class="text-xs text-base-content/40 mt-2"
                      id={"key-actions-help-#{t.membership.id}"}
                    >
                      <span class="font-medium">{gettext("Regenerate")}</span>
                      emite una clave nueva (la anterior deja de servir al instante) ·
                      <span class="font-medium">{gettext("Revoke")}</span>
                      {gettext("it only voids it, without issuing another.")}
                    </p>
                  <% end %>
                <% else %>
                  <p class="text-xs text-base-content/40 mt-1">{gettext("No key generated")}</p>
                  <div class="mt-3">
                    <button
                      phx-click="replace_key"
                      phx-value-id={t.membership.id}
                      class="btn btn-sm btn-primary"
                      id={"generate-#{t.membership.id}"}
                    >
                      <.icon name="hero-key" class="w-4 h-4" /> Generar clave
                    </button>
                  </div>
                <% end %>

                <%!-- {gettext("Monthly cap")} + top-ups — mt-auto pushes to bottom --%>
                <div class="mt-auto pt-4 border-t border-base-200 space-y-3">
                  <div>
                    <%= if credit_visible?(t.credit) do %>
                      <div class="flex items-center justify-between text-xs">
                        <span class="text-base-content/60">{gettext("Monthly cap")}</span>
                        <span class="font-mono">
                          {format_decimal(t.credit.limit_spend_usd)}
                          <span class="text-base-content/40">/ {format_decimal(t.credit.limit_usd)}</span>
                        </span>
                      </div>
                      <div class="mt-1 h-2 rounded-full bg-base-200 overflow-hidden">
                        <% cpct = credit_pct(t.credit) %>
                        <div
                          class={["h-full rounded-full transition-all", budget_bar_class(cpct)]}
                          style={budget_bar_width(cpct)}
                        >
                        </div>
                      </div>
                      <div
                        :if={Decimal.compare(t.credit.remaining_topup_usd, 0) == :gt}
                        class="flex items-center justify-between text-xs"
                      >
                        <span class="text-base-content/60">{gettext("Available top-ups")}</span>
                        <span class="font-mono text-success">
                          {format_decimal(t.credit.remaining_topup_usd)}
                        </span>
                      </div>
                    <% else %>
                      <div class="flex items-center justify-between text-xs">
                        <span class="text-base-content/60">{gettext("Monthly cap")}</span>
                        <span class="text-base-content/40">{gettext("No budget")}</span>
                      </div>
                      <div class="flex items-center justify-between text-xs mt-1">
                        <span class="text-base-content/60">{gettext("Monthly spend")}</span>
                        <span class="font-mono">${format_decimal(t.monthly_spend)}</span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <%!-- Supervised services shortcut — visible when the user supervises any service --%>
          <.link
            :if={@supervised_services_count > 0}
            navigate={~p"/services/supervised"}
            class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow block"
            id="supervised-services-card"
          >
            <div class="card-body p-5 flex flex-col h-full">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="font-semibold text-base-content">
                    {gettext("Supervised services")}
                  </h3>
                  <p class="text-xs text-base-content/50 mt-0.5">
                    {@supervised_services_count} servicio(s) asignado(s) · Vista de solo lectura
                  </p>
                </div>
                <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-primary/10">
                  <.icon name="hero-eye" class="w-5 h-5 text-primary" />
                </span>
              </div>
            </div>
          </.link>
        </div>
      <% end %>
    </section>

    <%= if @has_access do %>
      <%!-- Metrics section. The full-screen spinner shows only on the very
           first load; period switches keep the previous bundle visible
           (dimmed) until the new one lands, so the click feels instant. --%>
      <%= if @loading and @displayed_period == nil do %>
        <div class="flex items-center justify-center py-20">
          <span class="loading loading-spinner loading-lg text-primary"></span>
          <span class="ml-3 text-base-content/60">{gettext("Loading metrics…")}</span>
        </div>
      <% else %>
        <% title_period = @displayed_period || @period %>
        <div class={["space-y-6 transition-opacity duration-200", @loading && "opacity-60"]}>
          <%= if @metrics.requests_total == 0 do %>
            <div
              id="empty-state"
              class="flex flex-col items-center justify-center py-12 text-center"
            >
              <div class="w-20 h-20 rounded-full bg-base-300 flex items-center justify-center mb-4">
                <.icon name="hero-chart-bar" class="w-10 h-10 text-base-content/40" />
              </div>
              <h3 class="text-lg font-semibold text-base-content">
                {gettext("No requests yet")}
              </h3>
              <p class="mt-2 text-sm text-base-content/60 max-w-md">
                {gettext("Send your first request to the proxy to see metrics here.")}
              </p>
            </div>
          <% else %>
            <%!-- KPI cards canónicas — mismo componente que /stats (DESIGN.md C4/C5).
                 Con período "Hoy" el costo mide el día UTC y declara el reinicio. --%>
            <.kpi_cards
              metrics={@metrics}
              deltas={@metrics[:deltas]}
              period={@period}
              reset_hours={@budget_reset_hours}
              reset_minutes={@budget_reset_minutes}
              reset_at={@budget_reset_at}
              timezone={@timezone}
            />

            <!-- Breakdown tabs -->
            <div class="card bg-base-100 border border-base-300 shadow-sm">
              <div class="card-body">
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <h2 class="card-title text-base">
                    <.icon name="hero-chart-bar-square" class="w-5 h-5 text-base-content/60" />
                    {gettext("Breakdown")}
                  </h2>
                  <div class="join" id="breakdown-tabs" role="tablist">
                    <button
                      phx-click="set_breakdown"
                      phx-value-tab="model"
                      class={[
                        "join-item btn btn-sm",
                        if(breakdown_tab_active?(@active_breakdown, "model"),
                          do: "btn-primary",
                          else: "btn-ghost"
                        )
                      ]}
                      id="tab-model"
                    >
                      {gettext("By model")}
                    </button>
                    <button
                      phx-click="set_breakdown"
                      phx-value-tab="member"
                      class={[
                        "join-item btn btn-sm",
                        if(breakdown_tab_active?(@active_breakdown, "member"),
                          do: "btn-primary",
                          else: "btn-ghost"
                        )
                      ]}
                      id="tab-member"
                    >
                      {gettext("By API key")}
                    </button>
                    <%= if has_breakdown_data?(@breakdown_group) do %>
                      <button
                        phx-click="set_breakdown"
                        phx-value-tab="group"
                        class={[
                          "join-item btn btn-sm",
                          if(breakdown_tab_active?(@active_breakdown, "group"),
                            do: "btn-primary",
                            else: "btn-ghost"
                          )
                        ]}
                        id="tab-group"
                      >
                        {gettext("By limit profile")}
                      </button>
                    <% end %>
                  </div>
                </div>

                <%!-- Model breakdown --%>
                <%= if @active_breakdown == "model" do %>
                  <%= if has_breakdown_data?(@breakdown_model) do %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>{gettext("Model")}</th>
                            <th class="text-right">{gettext("Requests")}</th>
                            <th class="text-right">{gettext("Cost")}</th>
                            <th class="text-right">{gettext("Tokens in")}</th>
                            <th class="text-right">{gettext("Tokens out")}</th>
                            <th class="text-right">{gettext("TPS")}</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr
                            :for={row <- @breakdown_model}
                            id={"bd-model-#{row.model_id || "unknown"}"}
                          >
                            <td class="font-medium">
                              <div class="flex items-center gap-2">
                                <.model_mark
                                  mark={Map.get(@model_marks, row.model_id)}
                                  id={"bd-model-mark-#{row.model_id || "unknown"}"}
                                />
                                <span>{row.model_name}</span>
                              </div>
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(row.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.completion_tokens)}
                            </td>
                            <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      {gettext("No data for this period.")}
                    </p>
                  <% end %>
                <% end %>

                <%!-- Member (API key) breakdown --%>
                <%= if @active_breakdown == "member" do %>
                  <%= if has_breakdown_data?(@breakdown_member) do %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>{gettext("Limit profile")}</th>
                            <th>{gettext("User")}</th>
                            <th class="text-right">{gettext("Requests")}</th>
                            <th class="text-right">{gettext("Cost")}</th>
                            <th class="text-right">{gettext("Tokens in")}</th>
                            <th class="text-right">{gettext("Tokens out")}</th>
                            <th class="text-right">{gettext("TPS")}</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr
                            :for={row <- @breakdown_member}
                            id={"bd-member-#{row.group_member_id}"}
                          >
                            <td>{row.group_name}</td>
                            <td class="font-mono text-sm">{row.user_email}</td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(row.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.completion_tokens)}
                            </td>
                            <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      {gettext("No data for this period.")}
                    </p>
                  <% end %>
                <% end %>

                <%!-- Group breakdown --%>
                <%= if @active_breakdown == "group" do %>
                  <%= if has_breakdown_data?(@breakdown_group) do %>
                    <div class="overflow-x-auto mt-3">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>{gettext("Limit profile")}</th>
                            <th class="text-right">{gettext("Requests")}</th>
                            <th class="text-right">{gettext("Cost")}</th>
                            <th class="text-right">{gettext("Tokens in")}</th>
                            <th class="text-right">{gettext("Tokens out")}</th>
                            <th class="text-right">{gettext("TPS")}</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr :for={row <- @breakdown_group} id={"bd-group-#{row.group_id}"}>
                            <td class="font-medium">{row.group_name}</td>
                            <td class="text-right font-mono">
                              {format_number(row.request_count)}
                            </td>
                            <td class="text-right font-mono">
                              ${format_decimal(row.cost_usd)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.prompt_tokens)}
                            </td>
                            <td class="text-right font-mono">
                              {format_number(row.completion_tokens)}
                            </td>
                            <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  <% else %>
                    <p class="text-sm text-base-content/40 py-6 text-center">
                      {gettext("No data for this period.")}
                    </p>
                  <% end %>
                <% end %>
              </div>
            </div>

            <%!-- Charts: cost / requests / tokens per hour --%>
            <div class="grid grid-cols-4 gap-4" id="charts-grid">
              <.bar_chart
                id="cost-chart"
                title={chart_title(title_period)}
                icon="hero-currency-dollar"
                series={@cost_series}
                bar_class="fill-accent/70 hover:fill-accent"
                empty_label={
                  gettext("No data for %{period}.",
                    period: String.downcase(period_label(title_period))
                  )
                }
              />
              <.bar_chart
                id="requests-chart"
                title={requests_title(title_period)}
                icon="hero-arrow-trending-up"
                series={@requests_series}
                bar_class="fill-primary/70 hover:fill-primary"
                empty_label={
                  gettext("No data for %{period}.",
                    period: String.downcase(period_label(title_period))
                  )
                }
              />
              <.stacked_bar_chart
                id="tokens-chart"
                title={tokens_title(title_period)}
                icon="hero-cpu-chip"
                series={@tokens_series}
                empty_label={
                  gettext("No data for %{period}.",
                    period: String.downcase(period_label(title_period))
                  )
                }
              />
              <.bar_chart
                id="tps-chart"
                title={tps_title(title_period)}
                icon="hero-bolt"
                series={@tps_series}
                bar_class="fill-success/70 hover:fill-success"
                empty_label={
                  gettext("No data for %{period}.",
                    period: String.downcase(period_label(title_period))
                  )
                }
              />
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%!-- Mis claves API — el usuario logueado gestiona sus N claves con etiqueta
       desde el mismo panel que la página admin de usuarios. --%>
  <.admin_modal
    :if={@keys_modal_open}
    id="user-keys-modal"
    on_close="cancel_manage_keys"
    width="max-w-2xl"
  >
    <h2 class="text-lg font-semibold mb-1">{gettext("My API keys")}</h2>
    <p class="text-xs text-base-content/50 mb-4">
      {gettext("You can have several active keys, each with its own label.")}
    </p>

    <.keys_panel
      subject_kind="user"
      subject_id={@current_user.id}
      keys={@keys}
      spend={@keys_spend}
      new_token={@new_key_token}
      create_event="create_key"
      revoke_event="revoke_user_key"
      dismiss_event="dismiss_new_key_token"
      sticky_event="clear_user_sticky_routes"
      empty_text={gettext("You have no active keys yet.")}
    />

    <div class="flex gap-2 mt-4 justify-end">
      <button type="button" phx-click="cancel_manage_keys" class="btn btn-ghost btn-sm">
        {gettext("Close")}
      </button>
    </div>
  </.admin_modal>
</Layouts.dashboard>
