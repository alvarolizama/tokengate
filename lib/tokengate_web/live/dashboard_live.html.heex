<Layouts.dashboard flash={@flash} current_scope={@current_user} impersonator={@impersonator}>
  <div class="space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <.header>
        Dashboard
        <:subtitle>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-funnel" class="w-4 h-4 text-base-content/50" />
            {@scope_label}
          </span>
        </:subtitle>
      </.header>

      <%!-- Period selector --%>
      <div :if={@has_access} class="join" id="period-selector" role="tablist">
        <button
          :for={period <- ~w(today 7d 30d 90d)}
          phx-click="set_period"
          phx-value-period={period}
          class={[
            "join-item btn btn-sm",
            if(period_active?(@period, period), do: "btn-primary", else: "btn-ghost")
          ]}
          id={"period-#{period}"}
        >
          {period_label(period)}
        </button>
      </div>
    </div>

    <%!-- One-time new token alert --%>
    <div :if={@new_token} class="alert alert-warning shadow-lg" id="new-token-alert" role="alert">
      <.icon name="hero-key" class="w-5 h-5 shrink-0" />
      <div class="flex-1">
        <p class="font-semibold">Nueva clave generada para {@new_token_team}</p>
        <div class="relative mt-2">
          <code
            class="block p-2 pr-24 bg-base-200 rounded text-sm font-mono break-all select-all"
            id="new-token-value"
          >
            {@new_token}
          </code>
          <button
            type="button"
            id="copy-token-btn"
            aria-label="Copiar al portapapeles"
            phx-hook="CopyToClipboard"
            data-target="new-token-value"
            class="absolute right-2 top-1/2 -translate-y-1/2 btn btn-xs btn-ghost"
          >
            Copiar
          </button>
        </div>
        <p class="text-xs mt-2 text-base-content/70">
          Copia esta clave ahora. No se volverá a mostrar.
        </p>
      </div>
      <button
        phx-click="dismiss_token"
        class="btn btn-sm btn-ghost"
        id="dismiss-token-btn"
        aria-label="Cerrar"
      >
        <.icon name="hero-x-mark" class="w-4 h-4" />
      </button>
    </div>

    <%!-- Teams + models catalog — arriba de métricas --%>
    <section id="teams-section">

      <%= if @teams == [] and not @has_access do %>
        <div class="text-center py-12 text-base-content/50" id="no-team-state">
          <.icon name="hero-user-group" class="w-10 h-10 mx-auto mb-3 opacity-40" />
          <p class="font-medium">No tienes ningún equipo asignado.</p>
          <p class="text-sm mt-1 text-base-content/40">
            Contacta al administrador para que te asigne un equipo.
          </p>
        </div>
      <% else %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <%= for t <- @teams do %>
            <div
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
              id={"team-#{t.team.id}"}
            >
              <div class="card-body p-5">
                <%!-- Header: team name, role, key status --%>
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-semibold text-base-content">{t.team.name}</h3>
                    <p class="text-xs text-base-content/50 mt-0.5 capitalize">{t.team_role}</p>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class={["badge", "badge-sm", key_status_badge(t)]}>
                      {key_status_label(t)}
                    </span>
                    <.link patch={~p"/dashboard/teams"} class="btn btn-xs btn-ghost">
                      <.icon name="hero-arrow-right" class="w-3 h-3" />
                    </.link>
                  </div>
                </div>

                <%!-- API key section --%>
                <div class="mt-3">
                  <p class="text-xs text-base-content/50 uppercase tracking-wide">Clave API</p>
                  <code class="text-sm font-mono">{masked_key(t)}</code>
                </div>

                <%= if t.api_key do %>
                  <p class="text-xs text-base-content/40 mt-1">
                    Creada el {format_date(t.api_key.inserted_at)}
                  </p>

                  <div class="flex gap-2 mt-3">
                    <button
                      phx-click="replace_key"
                      phx-value-id={t.membership.id}
                      data-confirm="¿Reemplazar clave? La clave anterior dejará de funcionar inmediatamente."
                      class="btn btn-sm btn-primary"
                      id={"replace-#{t.membership.id}"}
                    >
                      <.icon name="hero-arrow-path" class="w-4 h-4" /> Reemplazar
                    </button>

                    <%= if t.api_key.status == "active" do %>
                      <button
                        phx-click="revoke_key"
                        phx-value-id={t.membership.id}
                        data-confirm="¿Revocar clave? Esta acción no se puede deshacer."
                        class="btn btn-sm btn-ghost text-error"
                        id={"revoke-#{t.membership.id}"}
                      >
                        <.icon name="hero-no-symbol" class="w-4 h-4" /> Revocar
                      </button>
                    <% end %>
                  </div>
                <% else %>
                  <p class="text-xs text-base-content/40 mt-1">Sin clave generada</p>
                  <div class="mt-3">
                    <button
                      phx-click="replace_key"
                      phx-value-id={t.membership.id}
                      class="btn btn-sm btn-primary"
                      id={"generate-#{t.membership.id}"}
                    >
                      <.icon name="hero-key" class="w-4 h-4" /> Generar clave
                    </button>
                  </div>
                <% end %>

                <%!-- Budget bar — monthly only --%>
                <div class="mt-4 pt-4 border-t border-base-200 space-y-3">
                  <div>
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-base-content/60">Gasto mensual</span>
                      <span class="font-mono">
                        ${format_decimal(t.monthly_spend)}
                        <span :if={t.monthly_limit} class="text-base-content/40">
                          / ${format_decimal(t.monthly_limit)}
                        </span>
                      </span>
                    </div>
                    <div
                      :if={t.monthly_limit}
                      class="mt-1 h-2 rounded-full bg-base-200 overflow-hidden"
                    >
                      <% monthly_pct = budget_pct(t.monthly_spend, t.monthly_limit) %>
                      <div
                        class={[
                          "h-full rounded-full transition-all",
                          budget_bar_class(monthly_pct)
                        ]}
                        style={budget_bar_width(monthly_pct)}
                      >
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <%!-- Models catalog card (always visible) --%>
          <div
            id="models-catalog-card"
            class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
          >
            <div class="card-body p-5">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                  Modelos
                </span>
                <span class={[
                  "flex items-center justify-center w-9 h-9 rounded-lg",
                  accent_bg("primary")
                ]}>
                  <.icon name="hero-server-stack" class={["w-5 h-5", accent_text("primary")]} />
                </span>
              </div>
              <div class="overflow-y-auto max-h-56">
                <table class="w-full text-xs">
                  <thead>
                    <tr class="text-base-content/50 border-b border-base-200">
                      <th class="text-left py-1 font-medium">Modelo</th>
                      <th class="text-right py-1 font-medium">In</th>
                      <th class="text-right py-1 font-medium">Out</th>
                      <th class="text-right py-1 font-medium">Ctx</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%= for model <- @model_catalog do %>
                      <tr class="border-b border-base-200 last:border-0 hover:bg-base-200/50">
                        <td class="py-1.5 font-medium text-base-content truncate max-w-[120px]" title={model.name}>
                          {model.name}
                        </td>
                        <td class="py-1.5 text-right text-base-content/70" title={"Input: $#{format_decimal(model.market_input)}/1M"}>
                          ${format_decimal(model.market_input)}
                        </td>
                        <td class="py-1.5 text-right text-base-content/70" title={"Output: $#{format_decimal(model.market_output)}/1M"}>
                          ${format_decimal(model.market_output)}
                        </td>
                        <td class="py-1.5 text-right text-base-content/70" title={"Contexto: #{format_number(model.context_window)} tokens"}>
                          {format_compact(model.context_window)}
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
                <%= if @model_catalog == [] do %>
                  <p class="text-sm text-base-content/40 italic py-2">Sin modelos configurados</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </section>

    <%= if @has_access do %>
      <%!-- Metrics section --%>
      <%= if @loading do %>
        <div class="flex items-center justify-center py-20">
          <span class="loading loading-spinner loading-lg text-primary"></span>
          <span class="ml-3 text-base-content/60">Cargando métricas…</span>
        </div>
      <% else %>
        <%= if @metrics.requests_total == 0 do %>
          <div
            id="empty-state"
            class="flex flex-col items-center justify-center py-12 text-center"
          >
            <div class="w-20 h-20 rounded-full bg-base-300 flex items-center justify-center mb-4">
              <.icon name="hero-chart-bar" class="w-10 h-10 text-base-content/40" />
            </div>
            <h3 class="text-lg font-semibold text-base-content">Aún no hay requests</h3>
            <p class="mt-2 text-sm text-base-content/60 max-w-md">
              Manda tu primer request al proxy para ver métricas aquí.
            </p>
          </div>
        <% else %>
          <!-- Metric cards: 6 KPIs + model catalog -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <%!-- Costo real (provider_cost_usd) --%>
            <div
              id="cost-real-card"
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
            >
              <div class="card-body p-5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                    Costo real
                  </span>
                  <span class={[
                    "flex items-center justify-center w-9 h-9 rounded-lg",
                    accent_bg("accent")
                  ]}>
                    <.icon name="hero-currency-dollar" class={["w-5 h-5", accent_text("accent")]} />
                  </span>
                </div>
                <p class="mt-2 text-2xl font-bold text-base-content">
                  ${format_decimal(@metrics.provider_cost_usd)}
                </p>
              </div>
            </div>

            <%!-- Costo estimado (estimated_cost_usd) --%>
            <div
              id="cost-estimated-card"
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
            >
              <div class="card-body p-5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                    Estimado
                  </span>
                  <span class={[
                    "flex items-center justify-center w-9 h-9 rounded-lg",
                    accent_bg("primary")
                  ]}>
                    <.icon name="hero-calculator" class={["w-5 h-5", accent_text("primary")]} />
                  </span>
                </div>
                <p class="mt-2 text-2xl font-bold text-base-content">
                  ${format_decimal(@metrics.estimated_cost_usd)}
                </p>
              </div>
            </div>

            <%!-- Ahorros --%>
            <div
              id="savings-card"
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
            >
              <div class="card-body p-5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                    Ahorros
                  </span>
                  <span class={[
                    "flex items-center justify-center w-9 h-9 rounded-lg",
                    accent_bg("success")
                  ]}>
                    <.icon name="hero-banknotes" class={["w-5 h-5", accent_text("success")]} />
                  </span>
                </div>
                <p class="mt-2 text-2xl font-bold text-base-content">
                  ${format_decimal(@metrics.savings_usd)}
                </p>
              </div>
            </div>

            <%!-- Requests --%>
            <div
              id="requests-card"
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
            >
              <div class="card-body p-5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                    Requests
                  </span>
                  <span class={[
                    "flex items-center justify-center w-9 h-9 rounded-lg",
                    accent_bg("primary")
                  ]}>
                    <.icon
                      name="hero-arrow-trending-up"
                      class={["w-5 h-5", accent_text("primary")]}
                    />
                  </span>
                </div>
                <p class="mt-2 text-2xl font-bold text-base-content">
                  {format_number(@metrics.requests_total)}
                </p>
              </div>
            </div>

            <%!-- Tokens (prompt + completion) --%>
            <div
              id="tokens-card"
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
            >
              <div class="card-body p-5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                    Tokens
                  </span>
                  <span class={[
                    "flex items-center justify-center w-9 h-9 rounded-lg",
                    accent_bg("primary")
                  ]}>
                    <.icon name="hero-cpu-chip" class={["w-5 h-5", accent_text("primary")]} />
                  </span>
                </div>
                <div class="mt-2 flex items-baseline gap-3">
                  <div>
                    <p
                      class="text-lg font-bold text-base-content"
                      title={format_number(@metrics.prompt_tokens)}
                    >
                      {format_compact(@metrics.prompt_tokens)}
                    </p>
                    <p class="text-xs text-base-content/50">in</p>
                  </div>
                  <span class="text-base-content/30">/</span>
                  <div>
                    <p
                      class="text-lg font-bold text-base-content"
                      title={format_number(@metrics.completion_tokens)}
                    >
                      {format_compact(@metrics.completion_tokens)}
                    </p>
                    <p class="text-xs text-base-content/50">out</p>
                  </div>
                </div>
              </div>
            </div>

            <%!-- TPS promedio --%>
            <div
              id="tps-card"
              class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow"
            >
              <div class="card-body p-5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-base-content/60 uppercase tracking-wide">
                    TPS promedio
                  </span>
                  <span class={[
                    "flex items-center justify-center w-9 h-9 rounded-lg",
                    accent_bg("accent")
                  ]}>
                    <.icon name="hero-bolt" class={["w-5 h-5", accent_text("accent")]} />
                  </span>
                </div>
                <p class="mt-2 text-2xl font-bold text-base-content">
                  {format_tps(@metrics.avg_tps)}
                </p>
                <p class="text-xs text-base-content/40 mt-1">
                  {format_latency(@metrics.avg_latency_ms)}
                  <span
                    :if={@metrics[:avg_ttft_ms]}
                    title="Time to first token promedio (streaming)"
                  >
                    · TTFT {format_latency(@metrics.avg_ttft_ms)}
                  </span>
                </p>
              </div>
            </div>
          </div>

          <!-- Breakdown tabs -->
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <h2 class="card-title text-base">
                  <.icon name="hero-chart-bar-square" class="w-5 h-5 text-base-content/60" />
                  Desglose
                </h2>
                <div class="join" id="breakdown-tabs" role="tablist">
                  <button
                    phx-click="set_breakdown"
                    phx-value-tab="model"
                    class={[
                      "join-item btn btn-sm",
                      if(breakdown_tab_active?(@active_breakdown, "model"),
                        do: "btn-primary",
                        else: "btn-ghost"
                      )
                    ]}
                    id="tab-model"
                  >
                    Por modelo
                  </button>
                  <button
                    phx-click="set_breakdown"
                    phx-value-tab="member"
                    class={[
                      "join-item btn btn-sm",
                      if(breakdown_tab_active?(@active_breakdown, "member"),
                        do: "btn-primary",
                        else: "btn-ghost"
                      )
                    ]}
                    id="tab-member"
                  >
                    Por API key
                  </button>
                  <%= if has_breakdown_data?(@breakdown_team) do %>
                    <button
                      phx-click="set_breakdown"
                      phx-value-tab="team"
                      class={[
                        "join-item btn btn-sm",
                        if(breakdown_tab_active?(@active_breakdown, "team"),
                          do: "btn-primary",
                          else: "btn-ghost"
                        )
                      ]}
                      id="tab-team"
                    >
                      Por equipo
                    </button>
                  <% end %>
                </div>
              </div>

              <%!-- Model breakdown --%>
              <%= if @active_breakdown == "model" do %>
                <%= if has_breakdown_data?(@breakdown_model) do %>
                  <div class="overflow-x-auto mt-3">
                    <table class="table table-sm table-zebra">
                      <thead>
                        <tr>
                          <th>Modelo</th>
                          <th class="text-right">Requests</th>
                          <th class="text-right">Costo real</th>
                          <th class="text-right">Mercado</th>
                          <th class="text-right">Ahorro</th>
                          <th class="text-right">Tokens in</th>
                          <th class="text-right">Tokens out</th>
                          <th class="text-right">TPS</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr
                          :for={row <- @breakdown_model}
                          id={"bd-model-#{row.model_id || "unknown"}"}
                        >
                          <td class="font-medium">{row.model_name}</td>
                          <td class="text-right font-mono">{format_number(row.request_count)}</td>
                          <td class="text-right font-mono">
                            ${format_decimal(row.provider_cost_usd)}
                          </td>
                          <td class="text-right font-mono text-base-content/60">
                            ${format_decimal(row.estimated_cost_usd)}
                          </td>
                          <td class="text-right font-mono text-success">
                            ${format_decimal(row.savings_usd)}
                          </td>
                          <td class="text-right font-mono">{format_number(row.prompt_tokens)}</td>
                          <td class="text-right font-mono">
                            {format_number(row.completion_tokens)}
                          </td>
                          <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                <% else %>
                  <p class="text-sm text-base-content/40 py-6 text-center">
                    Sin datos para este periodo.
                  </p>
                <% end %>
              <% end %>

              <%!-- Member (API key) breakdown --%>
              <%= if @active_breakdown == "member" do %>
                <%= if has_breakdown_data?(@breakdown_member) do %>
                  <div class="overflow-x-auto mt-3">
                    <table class="table table-sm table-zebra">
                      <thead>
                        <tr>
                          <th>Equipo</th>
                          <th>Usuario</th>
                          <th class="text-right">Requests</th>
                          <th class="text-right">Costo real</th>
                          <th class="text-right">Mercado</th>
                          <th class="text-right">Ahorro</th>
                          <th class="text-right">Tokens in</th>
                          <th class="text-right">Tokens out</th>
                          <th class="text-right">TPS</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr :for={row <- @breakdown_member} id={"bd-member-#{row.team_member_id}"}>
                          <td>{row.team_name}</td>
                          <td class="font-mono text-sm">{row.user_email}</td>
                          <td class="text-right font-mono">{format_number(row.request_count)}</td>
                          <td class="text-right font-mono">
                            ${format_decimal(row.provider_cost_usd)}
                          </td>
                          <td class="text-right font-mono text-base-content/60">
                            ${format_decimal(row.estimated_cost_usd)}
                          </td>
                          <td class="text-right font-mono text-success">
                            ${format_decimal(row.savings_usd)}
                          </td>
                          <td class="text-right font-mono">{format_number(row.prompt_tokens)}</td>
                          <td class="text-right font-mono">
                            {format_number(row.completion_tokens)}
                          </td>
                          <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                <% else %>
                  <p class="text-sm text-base-content/40 py-6 text-center">
                    Sin datos para este periodo.
                  </p>
                <% end %>
              <% end %>

              <%!-- Team breakdown --%>
              <%= if @active_breakdown == "team" do %>
                <%= if has_breakdown_data?(@breakdown_team) do %>
                  <div class="overflow-x-auto mt-3">
                    <table class="table table-sm table-zebra">
                      <thead>
                        <tr>
                          <th>Equipo</th>
                          <th class="text-right">Requests</th>
                          <th class="text-right">Costo real</th>
                          <th class="text-right">Mercado</th>
                          <th class="text-right">Ahorro</th>
                          <th class="text-right">Tokens in</th>
                          <th class="text-right">Tokens out</th>
                          <th class="text-right">TPS</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr :for={row <- @breakdown_team} id={"bd-team-#{row.team_id}"}>
                          <td class="font-medium">{row.team_name}</td>
                          <td class="text-right font-mono">{format_number(row.request_count)}</td>
                          <td class="text-right font-mono">
                            ${format_decimal(row.provider_cost_usd)}
                          </td>
                          <td class="text-right font-mono text-base-content/60">
                            ${format_decimal(row.estimated_cost_usd)}
                          </td>
                          <td class="text-right font-mono text-success">
                            ${format_decimal(row.savings_usd)}
                          </td>
                          <td class="text-right font-mono">{format_number(row.prompt_tokens)}</td>
                          <td class="text-right font-mono">
                            {format_number(row.completion_tokens)}
                          </td>
                          <td class="text-right font-mono">{format_tps(row.avg_tps)}</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                <% else %>
                  <p class="text-sm text-base-content/40 py-6 text-center">
                    Sin datos para este periodo.
                  </p>
                <% end %>
              <% end %>
            </div>
          </div>

          <%!-- Charts: requests / cost / savings per bucket --%>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4" id="charts-grid">
            <.bar_chart
              id="requests-chart"
              title={requests_title(@period)}
              icon="hero-arrow-trending-up"
              series={@requests_series}
              bar_class="fill-accent/70 hover:fill-accent"
              empty_label={"Sin datos para #{String.downcase(period_label(@period))}."}
            />
            <.bar_chart
              id="cost-chart"
              title={chart_title(@period)}
              icon="hero-currency-dollar"
              series={@cost_series}
              empty_label={"Sin datos para #{String.downcase(period_label(@period))}."}
            />
            <.bar_chart
              id="savings-chart"
              title={savings_title(@period)}
              icon="hero-banknotes"
              series={@savings_series}
              bar_class="fill-success/70 hover:fill-success"
              empty_label="Sin ahorro en este periodo."
            />
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</Layouts.dashboard>
