<Layouts.dashboard
  flash={@flash}
  current_scope={@current_user}
  impersonator={@impersonator}
  current_path={@current_path}
>
  <div class="space-y-6">
    <.header>
      Top-ups
      <:subtitle>{gettext("One-off credit, per user or service")}</:subtitle>
      <:actions>
        <div class="flex items-center gap-3">
          <.form
            for={%{}}
            phx-change="search_topups"
            phx-submit="search_topups"
            id="topup-search-form"
          >
            <div class="relative">
              <.icon
                name="hero-magnifying-glass"
                class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40"
              />
              <input
                type="text"
                name="q"
                placeholder={gettext("Search by user or service…")}
                value={@search_query}
                phx-debounce="300"
                class="input input-sm input-bordered pl-9 w-64"
                id="topup-search"
              />
            </div>
          </.form>
          <.button phx-click="new_topup" id="new-topup-btn">
            <.icon name="hero-plus" class="w-4 h-4" /> {gettext("New top-up")}
          </.button>
          <button
            :if={@archived_count > 0}
            phx-click="toggle_archived"
            id="toggle-archived-btn"
            class="btn btn-ghost btn-sm gap-1"
          >
            <.icon name="hero-archive-box-arrow-down" class="w-4 h-4" />
            <%= if @show_archived do %>
              {gettext("Hide archived")}
            <% else %>
              {gettext("Show archived (%{count})", count: @archived_count)}
            <% end %>
          </button>
        </div>
      </:actions>
    </.header>

    <%!-- Form modal --%>
    <div :if={@form} class="fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="absolute inset-0 bg-black/50" phx-click="cancel_topup" />
      <div class="relative card bg-base-100 border border-base-300 shadow-xl w-full max-w-lg">
        <div class="card-body p-6">
          <h2 class="text-lg font-semibold mb-4">
            {if @editing_topup_id, do: gettext("Edit top-up"), else: gettext("New top-up")}
          </h2>
          <.form for={@form} id="topup-form" phx-submit="save_topup">
            <%!-- One-shot submit token: the double-submit guard. Consumed by
                 the first save, so a second submit of this form is a no-op. --%>
            <input
              type="hidden"
              name="idempotency_key"
              id="topup-idempotency-key"
              value={@form_token}
            />
            <div id="topup-owner">
              <label class="text-xs text-base-content/60 block mb-1">{gettext("Owner")}</label>

              <div class="flex gap-1 mb-2">
                <button
                  type="button"
                  phx-click="owner_kind"
                  phx-value-kind="user"
                  id="owner-kind-user"
                  class={[
                    "btn btn-xs",
                    if(@owner_kind == "user", do: "btn-primary", else: "btn-ghost")
                  ]}
                >
                  {gettext("User")}
                </button>
                <button
                  type="button"
                  phx-click="owner_kind"
                  phx-value-kind="service"
                  id="owner-kind-service"
                  class={[
                    "btn btn-xs",
                    if(@owner_kind == "service", do: "btn-primary", else: "btn-ghost")
                  ]}
                >
                  {gettext("Service")}
                </button>
              </div>

              <div :if={@selected_owner} class="mb-2" id="selected-owner">
                <span class="badge badge-primary badge-sm gap-1">
                  {owner_badge(@selected_owner)}
                </span>
              </div>

              <.input
                type="text"
                name="owner_query"
                value={@owner_query}
                placeholder={
                  if @owner_kind == "user",
                    do: gettext("Search user…"),
                    else: gettext("Search service…")
                }
                phx-change="search_owner"
                phx-debounce="200"
                id="topup-owner-search"
                autocomplete="off"
              />

              <div
                :if={@owner_query != "" and @owner_results == []}
                class="text-xs text-base-content/40 mt-2"
              >
                {gettext("No matches.")}
              </div>

              <div
                :if={@owner_results != []}
                class="mt-2 max-h-40 overflow-y-auto border border-base-300 rounded-md"
              >
                <button
                  :for={o <- @owner_results}
                  type="button"
                  id={"select-owner-#{o.id}"}
                  phx-click="select_owner"
                  phx-value-id={o.id}
                  class="w-full text-left px-3 py-2 text-sm hover:bg-base-100 border-b border-base-300 last:border-b-0"
                >
                  <div class="font-medium">{subject_primary(o)}</div>
                  <div :if={subject_secondary(o)} class="text-xs text-base-content/60">
                    {subject_secondary(o)}
                  </div>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
              <.input
                field={@form[:amount_usd]}
                type="number"
                step="0.01"
                min="0.01"
                label={gettext("Amount (USD)")}
              />
              <.input field={@form[:label]} type="text" label={gettext("Label (optional)")} />
            </div>

            <div class="mt-3">
              <.input
                field={@form[:expires_in_days]}
                type="select"
                label={gettext("Expiration")}
                options={expiry_options()}
                hint={gettext("Counted from its creation")}
              />
            </div>

            <div class="mt-3">
              <.input field={@form[:note]} type="text" label={gettext("Note (optional)")} />
            </div>

            <div class="flex gap-2 mt-4 justify-end">
              <button type="button" phx-click="cancel_topup" class="btn btn-ghost btn-sm">
                {gettext("Cancel")}
              </button>
              <button type="submit" class="btn btn-primary btn-sm" id="save-topup-btn">
                {gettext("Save")}
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>

    <%!-- Listado — una fila por top-up --%>
    <div class="overflow-x-auto card bg-base-100 border border-base-300 shadow-sm">
      <.table
        id="topups"
        rows={@streams.topups}
        row_item={fn {_dom_id, topup} -> topup end}
        row_class={fn {_dom_id, topup} -> archived?(topup, @consumed) && "opacity-50" end}
        sort_field={@sort_field}
        sort_direction={@sort_direction}
        sort_event="sort_topups"
        empty?={@topups_empty?}
      >
        <:col :let={topup} label={gettext("Owner")} field={:target}>
          <div class="font-medium">{owner_label(topup)}</div>
          <div class="text-[10px] text-base-content/50">{owner_type(topup)}</div>
        </:col>
        <:col :let={topup} label={gettext("Amount")} field={:amount} align="right">
          <span class="font-mono">{usd(topup.amount_usd)}</span>
        </:col>
        <:col :let={topup} label={gettext("Consumption")} align="right">
          <div id={"topup-usage-#{topup.id}"} class="w-40 ml-auto">
            <div class="flex items-center gap-2">
              <div class="flex-1 h-1.5 rounded-full bg-base-300 overflow-hidden">
                <div class="h-full bg-primary" style={"width: #{row_pct(topup, @consumed)}%"} />
              </div>
              <span class="text-xs font-mono">{usd(row_consumed(topup, @consumed))}</span>
            </div>
            <div
              :if={row_state(topup, @consumed) == :revoked}
              class="text-[10px] text-warning mt-0.5"
            >
              {gettext("balance revoked")}
            </div>
          </div>
        </:col>
        <:col :let={topup} label={gettext("Expires")} field={:expires_at}>
          <span class="text-xs">{expires_label(topup.expires_at)}</span>
        </:col>
        <:col :let={topup} label={gettext("Status")} field={:status}>
          <span class={["badge badge-sm", state_badge_class(row_state(topup, @consumed))]}>
            {state_label(row_state(topup, @consumed))}
          </span>
        </:col>
        <:action :let={topup}>
          <button
            phx-click="edit_topup"
            phx-value-id={topup.id}
            class="btn btn-ghost btn-xs"
            id={"edit-topup-#{topup.id}"}
            title={gettext("Edit")}
          >
            <.icon name="hero-pencil-square" class="w-4 h-4" />
          </button>
          <button
            phx-click="toggle_topup_status"
            phx-value-id={topup.id}
            class="btn btn-ghost btn-xs"
            id={"toggle-topup-status-#{topup.id}"}
            title={
              if topup.status == "active", do: gettext("Deactivate"), else: gettext("Reactivate")
            }
          >
            <.icon
              name={if topup.status == "active", do: "hero-pause", else: "hero-play"}
              class="w-4 h-4"
            />
          </button>
          <button
            phx-click="revoke_topup"
            phx-value-id={topup.id}
            data-confirm={
              gettext("Revoke this top-up? The remaining balance stops being granted.")
            }
            class="btn btn-ghost btn-xs text-error"
            id={"revoke-topup-#{topup.id}"}
            title={gettext("Revoke")}
          >
            <.icon name="hero-trash" class="w-4 h-4" />
          </button>
        </:action>
        <:empty>
          <.icon name="hero-arrow-up-circle" class="w-10 h-10 mx-auto mb-2 opacity-40" />
          <p>{gettext("No top-ups — no subject has one-off credit.")}</p>
        </:empty>
      </.table>
    </div>
  </div>
</Layouts.dashboard>
