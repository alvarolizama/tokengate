<Layouts.dashboard
  flash={@flash}
  current_scope={@current_user}
  impersonator={@impersonator}
  current_path={@current_path}
>
  <div class="space-y-6">
    <.header>
      Top-ups
      <:subtitle>Crédito de un solo uso, por usuario o servicio</:subtitle>
      <:actions>
        <div class="flex items-center gap-3">
          <.form
            for={%{}}
            phx-change="search_topups"
            phx-submit="search_topups"
            id="topup-search-form"
          >
            <div class="relative">
              <.icon
                name="hero-magnifying-glass"
                class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40"
              />
              <input
                type="text"
                name="q"
                placeholder="Buscar por usuario o servicio…"
                value={@search_query}
                phx-debounce="300"
                class="input input-sm input-bordered pl-9 w-64"
                id="topup-search"
              />
            </div>
          </.form>
          <.button phx-click="new_topup" id="new-topup-btn">
            <.icon name="hero-plus" class="w-4 h-4" /> Nuevo top-up
          </.button>
          <button
            :if={@archived_count > 0}
            phx-click="toggle_archived"
            id="toggle-archived-btn"
            class="btn btn-ghost btn-sm gap-1"
          >
            <.icon name="hero-archive-box-arrow-down" class="w-4 h-4" />
            <%= if @show_archived do %>
              Ocultar archivados
            <% else %>
              Ver archivados ({@archived_count})
            <% end %>
          </button>
        </div>
      </:actions>
    </.header>

    <%!-- Form modal --%>
    <div :if={@form} class="fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="absolute inset-0 bg-black/50" phx-click="cancel_topup" />
      <div class="relative card bg-base-100 border border-base-300 shadow-xl w-full max-w-lg">
        <div class="card-body p-6">
          <h2 class="text-lg font-semibold mb-4">
            {if @editing_topup_id, do: "Editar top-up", else: "Nuevo top-up"}
          </h2>
          <.form for={@form} id="topup-form" phx-submit="save_topup">
            <div id="topup-owner">
              <label class="text-xs text-base-content/60 block mb-1">Dueño</label>

              <div class="flex gap-1 mb-2">
                <button
                  type="button"
                  phx-click="owner_kind"
                  phx-value-kind="user"
                  id="owner-kind-user"
                  class={[
                    "btn btn-xs",
                    if(@owner_kind == "user", do: "btn-primary", else: "btn-ghost")
                  ]}
                >
                  Usuario
                </button>
                <button
                  type="button"
                  phx-click="owner_kind"
                  phx-value-kind="service"
                  id="owner-kind-service"
                  class={[
                    "btn btn-xs",
                    if(@owner_kind == "service", do: "btn-primary", else: "btn-ghost")
                  ]}
                >
                  Servicio
                </button>
              </div>

              <div :if={@selected_owner} class="mb-2" id="selected-owner">
                <span class="badge badge-primary badge-sm gap-1">
                  {owner_badge(@selected_owner)}
                </span>
              </div>

              <.input
                type="text"
                name="topup_owner_query"
                value={@owner_query}
                placeholder={"Buscar #{if @owner_kind == "user", do: "usuario", else: "servicio"}…"}
                phx-change="search_owner"
                phx-debounce="200"
                id="topup-owner-search"
                autocomplete="off"
              />

              <div
                :if={@owner_query != "" and @owner_results == []}
                class="text-xs text-base-content/40 mt-2"
              >
                Sin coincidencias.
              </div>

              <div
                :if={@owner_results != []}
                class="mt-2 max-h-40 overflow-y-auto border border-base-300 rounded-md"
              >
                <button
                  :for={o <- @owner_results}
                  type="button"
                  id={"select-owner-#{o.id}"}
                  phx-click="select_owner"
                  phx-value-id={o.id}
                  class="w-full text-left px-3 py-2 text-sm hover:bg-base-100 border-b border-base-300 last:border-b-0"
                >
                  <div class="font-medium">{subject_primary(o)}</div>
                  <div :if={subject_secondary(o)} class="text-xs text-base-content/60">
                    {subject_secondary(o)}
                  </div>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
              <.input
                field={@form[:amount_usd]}
                type="number"
                step="0.01"
                min="0.01"
                label="Monto (USD)"
              />
              <.input field={@form[:label]} type="text" label="Etiqueta (opcional)" />
            </div>

            <div class="mt-3">
              <.input
                field={@form[:expires_in_days]}
                type="select"
                label="Expiración"
                options={expiry_options()}
                hint="Contada desde su creación"
              />
            </div>

            <div class="mt-3">
              <.input field={@form[:note]} type="text" label="Nota (opcional)" />
            </div>

            <div class="flex gap-2 mt-4 justify-end">
              <button type="button" phx-click="cancel_topup" class="btn btn-ghost btn-sm">
                Cancelar
              </button>
              <button type="submit" class="btn btn-primary btn-sm" id="save-topup-btn">
                Guardar
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>

    <%!-- Compact table --%>
    <div class="overflow-x-auto card bg-base-100 border border-base-300 shadow-sm">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>
              <.sort_button
                field={:target}
                label="Dueño"
                sort_field={@sort_field}
                sort_direction={@sort_direction}
              />
            </th>
            <th class="text-right">
              <.sort_button
                field={:amount}
                label="Monto"
                sort_field={@sort_field}
                sort_direction={@sort_direction}
              />
            </th>
            <th class="text-right">Consumo</th>
            <th>
              <.sort_button
                field={:expires_at}
                label="Vence"
                sort_field={@sort_field}
                sort_direction={@sort_direction}
              />
            </th>
            <th>
              <.sort_button
                field={:status}
                label="Estado"
                sort_field={@sort_field}
                sort_direction={@sort_direction}
              />
            </th>
            <th></th>
          </tr>
        </thead>
        <tbody id="topups" phx-update="stream">
          <tr
            :for={{dom_id, topup} <- @streams.topups}
            id={dom_id}
            class={archived?(topup) && "opacity-50"}
          >
            <td>
              <div class="font-medium">{owner_label(topup)}</div>
              <div class="text-[10px] text-base-content/50">{owner_type(topup)}</div>
            </td>
            <td class="text-right font-mono">{usd(topup.amount_usd)}</td>
            <td id={"topup-usage-#{topup.id}"} class="w-40">
              <div class="flex items-center gap-2">
                <div class="flex-1 h-1.5 rounded-full bg-base-300 overflow-hidden">
                  <div
                    class="h-full bg-primary"
                    style={"width: #{consumed_pct(topup)}%"}
                  />
                </div>
                <span class="text-xs font-mono">{usd(Topups.consumed_usd(topup))}</span>
              </div>
              <div :if={state(topup) == :revoked} class="text-[10px] text-warning mt-0.5">
                saldo revocado
              </div>
            </td>
            <td class="text-xs">{expires_label(topup.expires_at)}</td>
            <td>
              <div class="flex items-center gap-1">
                <span class={["badge badge-sm", state_badge_class(state(topup))]}>
                  {state_label(state(topup))}
                </span>
              </div>
            </td>
            <td class="text-right">
              <div class="flex gap-1 justify-end">
                <button
                  phx-click="edit_topup"
                  phx-value-id={topup.id}
                  class="btn btn-ghost btn-xs"
                  id={"edit-topup-#{topup.id}"}
                >
                  Editar
                </button>
                <button
                  phx-click="toggle_topup_status"
                  phx-value-id={topup.id}
                  class="btn btn-ghost btn-xs"
                  id={"toggle-topup-status-#{topup.id}"}
                >
                  {if topup.status == "active", do: "Desactivar", else: "Reactivar"}
                </button>
                <button
                  phx-click="revoke_topup"
                  phx-value-id={topup.id}
                  data-confirm="¿Revocar este top-up? El saldo restante deja de otorgarse."
                  class="btn btn-ghost btn-xs text-error"
                  id={"revoke-topup-#{topup.id}"}
                >
                  <.icon name="hero-trash" class="w-4 h-4" /> Revocar
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
      <div
        :if={@topups_empty?}
        class="text-center py-12 text-base-content/40"
        id="topups-empty"
      >
        <.icon name="hero-arrow-up-circle" class="w-10 h-10 mx-auto mb-2 opacity-40" />
        <p>No hay top-ups — ningún sujeto tiene crédito de un solo uso.</p>
      </div>
    </div>
  </div>
</Layouts.dashboard>
