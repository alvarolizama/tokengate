<Layouts.dashboard flash={@flash} current_scope={@current_user} impersonator={@impersonator}>
  <div class="space-y-6">
    <%!-- Header ──────────────────────────────────────────────────────── --%>
    <.header>
      Providers Benchmarks
      <:subtitle>
        <span class="inline-flex items-center gap-2">
          <.icon name="hero-chart-bar" class="w-4 h-4 text-base-content/50" />
          Comparativa de proveedores con data real de uso · TTFT · TPS · Latencia
        </span>
      </:subtitle>
    </.header>

    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <%!-- FILTERS: MODEL + PERIOD                                         --%>
    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body p-4 sm:p-6">
        <div class="flex flex-col lg:flex-row lg:items-end gap-4">
          <.form for={%{}} phx-change="select_alias" id="alias-form" class="flex-1">
            <label class="text-xs font-semibold uppercase tracking-wide text-base-content/40 block mb-2">
              Modelo a comparar
            </label>
            <select name="alias_id" class="select select-bordered select-sm w-full max-w-md">
              <option value="">Selecciona un modelo…</option>
              <%= for alias <- @model_aliases do %>
                <option value={alias.id} selected={selected_alias?(alias, @selected_alias)}>
                  {alias.name}
                </option>
              <% end %>
            </select>
          </.form>

          <div id="period-picker">
            <label class="text-xs font-semibold uppercase tracking-wide text-base-content/40 block mb-2">
              Ventana
            </label>
            <div class="join">
              <%= for period <- @periods do %>
                <button
                  type="button"
                  phx-click="set_period"
                  phx-value-period={period}
                  class={[
                    "btn btn-sm join-item",
                    period_active?(period, @period) && "btn-primary",
                    !period_active?(period, @period) && "btn-ghost"
                  ]}
                >
                  {fmt_period(period)}
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <%= if @selected_alias do %>
          <p class="text-xs text-base-content/50 mt-3">
            Data agregada de request_logs · {fmt_period(@period)} · una fila por proveedor
          </p>
        <% end %>
      </div>
    </div>

    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <%!-- REPORT                                                           --%>
    <%!-- ──────────────────────────────────────────────────────────────── --%>
    <%= cond do %>
      <% is_nil(@selected_alias) -> %>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-4 sm:p-6">
            <p class="text-sm text-base-content/40 py-8 text-center">
              Selecciona un modelo para ver su comparativa de proveedores.
            </p>
          </div>
        </div>
      <% @report == [] -> %>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-4 sm:p-6">
            <p class="text-sm text-base-content/40 py-8 text-center">
              Sin uso registrado de este modelo en la ventana. Los benchmarks se
              construyen con logs reales — corre tráfico por el proxy y vuelve.
            </p>
          </div>
        </div>
      <% true -> %>
        <% best_tps = best_row(@report, :avg_tps, :max) %>
        <% best_ttft = best_row(@report, :avg_ttft_ms, :min) %>
        <% best_lat = best_row(@report, :avg_latency_ms, :min) %>
        <% best_p95 = best_row(@report, :p95_latency_ms, :min) %>
        <% best_err = best_row(@report, :error_rate, :min) %>
        <% max_tps = max_metric(@report, :avg_tps) %>
        <% total_requests = Enum.sum(Enum.map(@report, & &1.request_count)) %>
        <% total_cost =
          Enum.reduce(@report, Decimal.new(0), &Decimal.add(&2, &1.total_cost_usd)) %>
        <% total_errors = Enum.sum(Enum.map(@report, & &1.error_count)) %>
        <% global_error_rate =
          if(total_requests > 0,
            do: Float.round(total_errors / total_requests * 100, 1),
            else: 0.0
          ) %>

        <%!-- Summary strip --%>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body p-4">
              <p class="text-[10px] uppercase tracking-wider text-base-content/40">Requests</p>
              <p class="text-xl font-semibold tabular-nums">{total_requests}</p>
              <p class="text-[10px] text-base-content/40">
                errores {fmt_pct(global_error_rate)}
              </p>
            </div>
          </div>
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body p-4">
              <p class="text-[10px] uppercase tracking-wider text-base-content/40">
                Proveedores activos
              </p>
              <p class="text-xl font-semibold tabular-nums">{length(@report)}</p>
            </div>
          </div>
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body p-4">
              <p class="text-[10px] uppercase tracking-wider text-base-content/40">Costo total</p>
              <p class="text-xl font-semibold tabular-nums">{fmt_cost(total_cost)}</p>
            </div>
          </div>
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body p-4">
              <p class="text-[10px] uppercase tracking-wider text-base-content/40">Mejor TPS</p>
              <p class="text-xl font-semibold tabular-nums text-success">
                {if best_tps, do: fmt_tps(best_tps.avg_tps), else: "—"}
              </p>
              <p class="text-[10px] text-base-content/40">{best_tps && best_tps.provider_name}</p>
            </div>
          </div>
        </div>

        <%!-- Comparative table --%>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-4 sm:p-6">
            <h3 class="text-sm font-semibold text-base-content mb-3">
              Comparativa por proveedor
              <span class="badge badge-ghost badge-sm ml-2">{length(@report)}</span>
            </h3>
            <div class="overflow-x-auto">
              <table class="table table-sm" id="benchmark-report">
                <thead>
                  <tr class="text-[10px] uppercase tracking-wider text-base-content/40">
                    <th>Proveedor</th>
                    <th class="text-right">Requests</th>
                    <th class="text-right">Errores</th>
                    <th class="text-right">TTFT avg</th>
                    <th class="text-right">TPS</th>
                    <th class="text-right">Latencia avg</th>
                    <th class="text-right">Latencia p95</th>
                    <th class="text-right">Costo</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for row <- @report do %>
                    <tr id={"provider-row-#{row.provider_id}"}>
                      <td class="text-xs font-semibold text-base-content/90">
                        <span class="inline-flex items-center gap-1">
                          <span :if={row == best_tps} class="text-success" title="Mejor TPS">★</span>
                          <span :if={row == best_ttft} class="text-secondary" title="Mejor TTFT">★</span>
                          <span :if={row == best_lat} class="text-accent" title="Mejor latencia">★</span>
                          {row.provider_name}
                        </span>
                        <%!-- TPS relative bar keeps the comparison visual --%>
                        <div class="h-1.5 bg-base-200 rounded-full overflow-hidden mt-1.5 w-32">
                          <div
                            class="h-full rounded-full transition-all duration-500"
                            style={"width: #{bar_width(row.avg_tps, max_tps)}%; background-color: oklch(var(--p))"}
                          />
                        </div>
                      </td>
                      <td class="text-right text-xs tabular-nums text-base-content/80">
                        {row.request_count}
                      </td>
                      <td class="text-right text-xs tabular-nums">
                        <span
                          :if={row == best_err}
                          class="mr-1 text-success"
                          title="Menor tasa de error"
                        >★</span>
                        <span class={["badge badge-sm", error_badge(row.error_rate)]}>
                          {fmt_pct(row.error_rate)}
                        </span>
                      </td>
                      <td class={[
                        "text-right text-xs tabular-nums",
                        row == best_ttft && "font-bold text-secondary"
                      ]}>
                        {fmt_ms(row.avg_ttft_ms)}
                      </td>
                      <td class={[
                        "text-right text-xs tabular-nums",
                        row == best_tps && "font-bold text-success"
                      ]}>
                        {fmt_tps(row.avg_tps)}
                      </td>
                      <td class={[
                        "text-right text-xs tabular-nums",
                        row == best_lat && "font-bold text-accent"
                      ]}>
                        {fmt_ms(row.avg_latency_ms)}
                      </td>
                      <td class={[
                        "text-right text-xs tabular-nums text-base-content/70",
                        row == best_p95 && "font-bold"
                      ]}>
                        {fmt_ms(row.p95_latency_ms)}
                      </td>
                      <td class="text-right text-xs tabular-nums text-base-content/70">
                        {fmt_cost(row.total_cost_usd)}
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <p class="text-[10px] text-base-content/40 mt-3">
              ★ mejor de cada métrica · TPS = tokens completados / tiempo total de generación ·
              TTFT promedio sobre requests con streaming · errores = status ≥ 400
            </p>
          </div>
        </div>
    <% end %>
  </div>
</Layouts.dashboard>
