<Layouts.dashboard flash={@flash} current_scope={@current_user} impersonator={@impersonator}>
  <div class="space-y-6">
    <.header>
      Suscripciones
      <:subtitle>Crédito por grupo (default) o por usuario (directo / top-up)</:subtitle>
      <:actions>
        <div class="flex items-center gap-3">
          <.form
            for={%{}}
            phx-change="search_subscriptions"
            phx-submit="search_subscriptions"
            id="search-form"
          >
            <div class="relative">
              <.icon
                name="hero-magnifying-glass"
                class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40"
              />
              <input
                type="text"
                name="q"
                placeholder="Buscar por grupo o usuario…"
                value={@search_query}
                phx-debounce="300"
                class="input input-sm input-bordered pl-9 w-64"
                id="subscription-search"
              />
            </div>
          </.form>
          <.button phx-click="new_subscription" id="new-subscription-btn">
            <.icon name="hero-plus" class="w-4 h-4" /> Nueva suscripción
          </.button>
          <button
            :if={@archived_count > 0}
            phx-click="toggle_archived"
            id="toggle-archived-btn"
            class="btn btn-ghost btn-sm gap-1"
          >
            <.icon name="hero-archive-box-arrow-down" class="w-4 h-4" />
            <%= if @show_archived do %>
              Ocultar archivadas
            <% else %>
              Ver archivadas ({@archived_count})
            <% end %>
          </button>
        </div>
      </:actions>
    </.header>

    <%!-- Form modal --%>
    <div :if={@form} class="fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="absolute inset-0 bg-black/50" phx-click="cancel_subscription" />
      <div class="relative card bg-base-100 border border-base-300 shadow-xl w-full max-w-lg">
        <div class="card-body p-6">
          <h2 class="text-lg font-semibold mb-4">
            {if @editing_subscription_id == :new,
              do: "Nueva suscripción",
              else: "Editar suscripción"}
          </h2>
          <.form
            for={@form}
            id="subscription-form"
            phx-change="sub_form_change"
            phx-submit="save_subscription"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="text-xs text-base-content/60 block mb-1">Alcance</label>
                <select
                  name="scope"
                  class="select select-bordered select-sm w-full"
                  id="sub-scope"
                >
                  <option value="group" selected={@sub_scope == "group"}>Grupo (default)</option>
                  <option value="user" selected={@sub_scope == "user"}>
                    Usuario (directa / top-up)
                  </option>
                </select>
              </div>
              <.input field={@form[:name]} type="text" label="Nombre (opcional)" />
            </div>

            <div :if={@sub_scope == "group"} class="mt-3" id="sub-groups">
              <label class="text-xs text-base-content/60 block mb-1">Grupos (comparten esta sub)</label>
              <div class="flex flex-wrap gap-2">
                <label
                  :for={g <- @groups}
                  class="flex items-center gap-2 text-sm bg-base-200/50 rounded-lg px-3 py-1.5"
                >
                  <input
                    type="checkbox"
                    name="group_ids[]"
                    value={g.id}
                    checked={g.id in @sub_group_ids}
                  />
                  {g.name}
                </label>
              </div>
            </div>

            <div :if={@sub_scope == "user"} class="mt-3" id="sub-user">
              <label class="text-xs text-base-content/60 block mb-1">Usuarios</label>

              <div :if={@sub_users != []} class="flex flex-wrap gap-2 mb-2">
                <span
                  :for={u <- @sub_users}
                  class="badge badge-primary badge-sm gap-1"
                  id={"sub-user-#{u.id}"}
                >
                  {u.label}
                  <button
                    type="button"
                    phx-click="remove_sub_user"
                    phx-value-user-id={u.id}
                    class="ml-1 leading-none opacity-70 hover:opacity-100"
                    aria-label="Quitar usuario"
                  >
                    ×
                  </button>
                </span>
              </div>

              <.input
                type="text"
                name="sub_user_query"
                value={@sub_user_query}
                placeholder="Buscar por email o nombre…"
                id="sub-user-search"
                autocomplete="off"
              />

              <div
                :if={@sub_user_query != "" and @sub_user_results == []}
                class="text-xs text-base-content/40 mt-2"
              >
                Sin coincidencias.
              </div>

              <div
                :if={@sub_user_results != []}
                class="mt-2 max-h-40 overflow-y-auto border border-base-300 rounded-md"
              >
                <button
                  :for={u <- @sub_user_results}
                  type="button"
                  id={"add-sub-user-#{u.id}"}
                  phx-click="add_sub_user"
                  phx-value-user-id={u.id}
                  phx-value-label={u.name || u.email}
                  class="w-full text-left px-3 py-2 text-sm hover:bg-base-100 border-b border-base-300 last:border-b-0"
                >
                  <div class="font-medium">{u.name || u.email}</div>
                  <div class="text-xs text-base-content/60">{u.email}</div>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-3">
              <.input field={@form[:units]} type="number" min="0" label="Créditos por ciclo" />
              <.input
                field={@form[:recurrence]}
                type="select"
                label="Recurrencia"
                options={[{"Mensual", "monthly"}, {"Top-up (una vez)", "none"}]}
              />
              <.input
                field={@form[:reset_day]}
                type="number"
                min="1"
                max="31"
                label="Día de corte"
              />
              <.input
                field={@form[:status]}
                type="select"
                label="Estado"
                options={[{"Activa", "active"}, {"Pausada", "paused"}]}
              />
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-3">
              <.input
                field={@form[:rollover_mode]}
                type="select"
                label="Al cerrar el ciclo"
                options={[{"Se pierde", "reset"}, {"Rollover (arrastra %)", "rollover"}]}
              />
              <.input
                field={@form[:rollover_pct]}
                type="number"
                min="0"
                max="100"
                label="% rollover"
              />
              <.input
                field={@form[:rollover_cap_units]}
                type="number"
                min="0"
                label="Tope acumulable"
                hint="Vacío = sin tope"
              />
            </div>

            <div class="flex gap-2 mt-4 justify-end">
              <button type="button" phx-click="cancel_subscription" class="btn btn-ghost btn-sm">
                Cancelar
              </button>
              <button type="submit" class="btn btn-primary btn-sm" id="save-subscription-btn">
                Guardar
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>

    <%!-- Compact table --%>
    <div class="overflow-x-auto card bg-base-100 border border-base-300 shadow-sm">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>
              <.sort_button
                field={:target}
                label="Objetivo"
                current={@sort_field}
                direction={@sort_direction}
              />
            </th>
            <th class="text-right">
              <.sort_button
                field={:units}
                label="Créditos"
                current={@sort_field}
                direction={@sort_direction}
                align="right"
              />
            </th>
            <th class="text-right">Consumo</th>
            <th>
              <.sort_button
                field={:recurrence}
                label="Recurrencia"
                current={@sort_field}
                direction={@sort_direction}
              />
            </th>
            <th>
              <.sort_button
                field={:reset_day}
                label="Corte"
                current={@sort_field}
                direction={@sort_direction}
              />
            </th>
            <th>
              <.sort_button
                field={:rollover}
                label="Rollover"
                current={@sort_field}
                direction={@sort_direction}
              />
            </th>
            <th>
              <.sort_button
                field={:status}
                label="Estado"
                current={@sort_field}
                direction={@sort_direction}
              />
            </th>
            <th></th>
          </tr>
        </thead>
        <tbody id="subscriptions" phx-update="stream">
          <tr
            :for={{dom_id, sub} <- @streams.subscriptions}
            id={dom_id}
            class={archived?(sub, assigns) && "opacity-50"}
          >
            <td class="font-medium">{target_label(sub, assigns)}</td>
            <td class="text-right font-mono">{sub.units}</td>
            <td id={"sub-usage-#{sub.id}"} class="w-40">
              {render_usage_cell(sub, assigns)}
            </td>
            <td>{recurrence_label(sub.recurrence)}</td>
            <td>{sub.reset_day || "—"}</td>
            <td>{rollover_label(sub)}</td>
            <td>
              <div class="flex items-center gap-1">
                <span class={[
                  "badge badge-sm",
                  if(sub.status == "active", do: "badge-success", else: "badge-ghost")
                ]}>
                  {sub.status}
                </span>
                <span
                  :if={archived?(sub, assigns)}
                  class="badge badge-sm badge-warning badge-outline"
                  id={"archived-badge-#{sub.id}"}
                >
                  {archived_reason(sub, assigns)}
                </span>
              </div>
            </td>
            <td class="text-right">
              <div class="flex gap-1 justify-end">
                <button
                  phx-click="edit_subscription"
                  phx-value-id={sub.id}
                  class="btn btn-ghost btn-xs"
                  id={"edit-subscription-#{sub.id}"}
                >
                  Editar
                </button>
                <button
                  phx-click="delete_subscription"
                  phx-value-id={sub.id}
                  data-confirm="¿Eliminar esta suscripción?"
                  class="btn btn-ghost btn-xs text-error"
                  id={"delete-subscription-#{sub.id}"}
                >
                  <.icon name="hero-trash" class="w-4 h-4" />
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
      <div
        :if={@subscriptions_empty?}
        class="text-center py-12 text-base-content/40"
        id="subscriptions-empty"
      >
        <.icon name="hero-banknotes" class="w-10 h-10 mx-auto mb-2 opacity-40" />
        <p>No hay suscripciones — los sujetos sin crédito no tienen tope propio.</p>
      </div>
    </div>
  </div>
</Layouts.dashboard>
