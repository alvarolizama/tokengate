<Layouts.dashboard flash={@flash} current_scope={@current_user} impersonator={@impersonator}>
  <div class="max-w-5xl mx-auto space-y-8">
    <div>
      <h1 class="text-2xl font-bold text-base-content">Budget</h1>
      <p class="text-sm text-base-content/60 mt-1">
        Límites de gasto diarios y sus exclusiones. El límite por usuario se
        evalúa antes del límite global.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <%!-- ── Global daily cap ──────────────────────────────────────── --%>
      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <h2 class="card-title flex items-center gap-2">
            <.icon name="hero-globe-americas" class="w-5 h-5" /> Límite de gasto diario global
          </h2>
          <p class="text-sm text-base-content/60">
            Tope máximo de gasto total por día (UTC), sumando todos los
            sujetos. Cuando se alcanza, toda nueva request se rechaza con 402
            hasta el día siguiente. Vacío = sin límite.
          </p>

          <.form for={@global_form} id="global-cap-form" phx-submit="save_global_cap">
            <.input
              field={@global_form[:daily_max_spend_usd]}
              type="number"
              step="0.01"
              min="0"
              label="USD por día"
              hint="Ej: 50.00 — se corta todo cuando el gasto total del día llega a este monto."
            />
            <div class="flex gap-2 mt-3">
              <button type="submit" class="btn btn-primary btn-sm" id="save-global-cap-btn">
                Guardar
              </button>
            </div>
          </.form>

          <div class="mt-4">
            <div class="flex justify-between text-sm">
              <span class="text-base-content/60">Gastado hoy (total)</span>
              <span class="font-mono font-semibold">
                ${Decimal.round(@global_daily_spend, 2)}
                <%= if @global_daily_cap do %>
                  / ${Decimal.round(@global_daily_cap, 2)}
                <% end %>
              </span>
            </div>
            <%= if @global_daily_cap && @global_daily_pct do %>
              <progress
                class={
                  if @global_daily_pct >= 90,
                    do: "progress progress-error w-full mt-1",
                    else: "progress progress-warning w-full mt-1"
                }
                value={@global_daily_pct}
                max="100"
              />
            <% end %>
          </div>

          <%!-- Global exemptions --%>
          <div class="divider my-2"></div>
          <h3 class="font-semibold text-base-content flex items-center gap-2">
            <.icon name="hero-shield-exclamation" class="w-4 h-4 text-warning" />
            Exclusiones al límite global
          </h3>
          <p class="text-sm text-base-content/60">
            El gasto de estos sujetos no cuenta para el límite global (sigue
            contando para el suyo y para los límites por modelo).
          </p>

          <.form
            for={%{}}
            phx-submit="add_global_exemption"
            phx-change="change_global_subject"
            id="global-exemption-form"
            class="flex flex-wrap gap-2 items-end"
          >
            <div>
              <label class="text-xs text-base-content/60 block mb-1">Tipo</label>
              <select name="global_subject[subject_type]" class="select select-bordered select-sm">
                <option value="user" selected={@global_subject_type == "user"}>Usuario</option>
                <option value="team" selected={@global_subject_type == "team"}>Equipo</option>
                <option value="service" selected={@global_subject_type == "service"}>
                  Servicio
                </option>
              </select>
            </div>
            <div class="flex-1 min-w-48">
              <label class="text-xs text-base-content/60 block mb-1">Sujeto</label>
              <select
                name="global_subject[subject_id]"
                class="select select-bordered select-sm w-full"
              >
                <option value="">
                  {if @global_subject_type == "user",
                    do: "Usuario…",
                    else: if(@global_subject_type == "team", do: "Equipo…", else: "Servicio…")}
                </option>
                <%= for {label, id} <- subject_options(@global_subject_type, assigns) do %>
                  <option value={id}>{label}</option>
                <% end %>
              </select>
            </div>
            <button type="submit" class="btn btn-ghost btn-sm">Excluir</button>
          </.form>

          <%= if @global_exemptions == [] do %>
            <p class="text-sm text-base-content/40">
              Sin exclusiones — todos sujetos al límite global.
            </p>
          <% else %>
            <ul class="space-y-1">
              <li
                :for={e <- @global_exemptions}
                id={"global-exemption-" <> e.id}
                class="flex items-center justify-between text-sm bg-base-200/50 rounded-lg px-3 py-1.5"
              >
                <span>{Exemptions.subject_label(e)}</span>
                <button
                  type="button"
                  phx-click="remove_global_exemption"
                  phx-value-id={e.id}
                  class="btn btn-ghost btn-xs text-error"
                  aria-label="Quitar exención"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </li>
            </ul>
          <% end %>
        </div>
      </div>

      <%!-- ── Per-user daily cap ────────────────────────────────────── --%>
      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <h2 class="card-title flex items-center gap-2">
            <.icon name="hero-user" class="w-5 h-5" /> Límite diario por usuario
          </h2>
          <p class="text-sm text-base-content/60">
            Tope de gasto por día (UTC) para cada usuario y servicio. Se
            evalúa ANTES del límite global: un usuario puede quedar bloqueado
            por su propio límite aunque el global aún tenga margen. Vacío =
            sin límite.
          </p>

          <.form for={@global_form} id="per-user-cap-form" phx-submit="save_per_user_cap">
            <.input
              field={@global_form[:daily_max_per_user_usd]}
              type="number"
              step="0.01"
              min="0"
              label="USD por día y usuario"
              hint="Ej: 5.00 — cada usuario se corta al llegar a este gasto diario propio."
            />
            <div class="flex gap-2 mt-3">
              <button type="submit" class="btn btn-primary btn-sm" id="save-per-user-cap-btn">
                Guardar
              </button>
            </div>
          </.form>

          <div class="mt-4 text-sm">
            <span class="text-base-content/60">Límite actual:</span>
            <span class="font-mono font-semibold">{fmt_usd(@per_user_cap)}</span>
          </div>

          <%!-- Per-user exemptions --%>
          <div class="divider my-2"></div>
          <h3 class="font-semibold text-base-content flex items-center gap-2">
            <.icon name="hero-shield-exclamation" class="w-4 h-4 text-warning" />
            Exclusiones al límite por usuario
          </h3>
          <p class="text-sm text-base-content/60">
            Estos sujetos ignoran el límite diario por usuario. Excluir un
            equipo libera a todos sus miembros.
          </p>

          <.form
            for={%{}}
            phx-submit="add_user_exemption"
            phx-change="change_user_subject"
            id="user-exemption-form"
            class="flex flex-wrap gap-2 items-end"
          >
            <div>
              <label class="text-xs text-base-content/60 block mb-1">Tipo</label>
              <select name="user_subject[subject_type]" class="select select-bordered select-sm">
                <option value="user" selected={@user_subject_type == "user"}>Usuario</option>
                <option value="team" selected={@user_subject_type == "team"}>Equipo</option>
                <option value="service" selected={@user_subject_type == "service"}>
                  Servicio
                </option>
              </select>
            </div>
            <div class="flex-1 min-w-48">
              <label class="text-xs text-base-content/60 block mb-1">Sujeto</label>
              <select
                name="user_subject[subject_id]"
                class="select select-bordered select-sm w-full"
              >
                <option value="">
                  {if @user_subject_type == "user",
                    do: "Usuario…",
                    else: if(@user_subject_type == "team", do: "Equipo…", else: "Servicio…")}
                </option>
                <%= for {label, id} <- subject_options(@user_subject_type, assigns) do %>
                  <option value={id}>{label}</option>
                <% end %>
              </select>
            </div>
            <button type="submit" class="btn btn-ghost btn-sm">Excluir</button>
          </.form>

          <%= if @user_exemptions == [] do %>
            <p class="text-sm text-base-content/40">
              Sin exclusiones — todos sujetos al límite por usuario.
            </p>
          <% else %>
            <ul class="space-y-1">
              <li
                :for={e <- @user_exemptions}
                id={"user-exemption-" <> e.id}
                class="flex items-center justify-between text-sm bg-base-200/50 rounded-lg px-3 py-1.5"
              >
                <span>{Exemptions.subject_label(e)}</span>
                <button
                  type="button"
                  phx-click="remove_user_exemption"
                  phx-value-id={e.id}
                  class="btn btn-ghost btn-xs text-error"
                  aria-label="Quitar exención"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </li>
            </ul>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</Layouts.dashboard>
