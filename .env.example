# ============================================================================
# TokenGate — plantilla de entorno
# ============================================================================
# Copiá este archivo a `.env` y llená los valores reales. `.env` está ignorado
# por git: NUNCA commitees secretos.
#
#   cp .env.example .env && $EDITOR .env
#
# Local: cargalo con `direnv allow` (o tu loader de dotenv).
# Producción: la plataforma de deploy (Coolify, Fly, Render…) inyecta estas
# variables en el contenedor — no se hornean en la imagen (ver README
# §Configuration y SPEC-config.md del repo `boilerplate`).
#
# Las seis primeras son las REQUERIDAS: el boot aborta sin ellas.
# ============================================================================

# ----------------------------------------------------------------------------
# Requeridas en producción (el boot falla si faltan)
# ----------------------------------------------------------------------------

# Conexión a Postgres.
# Local:      ecto://postgres:postgres@localhost/tokengate_dev
# Producción: postgres://usuario:***@host/tokengate_prod
DATABASE_URL=ecto://postgres:postgres@localhost/tokengate_dev

# Firma/cifra cookies y otros secretos.  mix phx.gen.secret
SECRET_KEY_BASE=replace-me-with-output-of-mix-phx-gen-secret

# Host público: hostname pelado, sin esquema ni puerto.
PHX_HOST=localhost

# Clave HMAC de las entregas del webhook de observabilidad.
WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Salts de la cookie de sesión — DOS DISTINTOS, obligatorios en prod.
# Generá cada uno con: mix phx.gen.secret 32
SESSION_SIGNING_SALT=replace-me-with-mix-phx-gen-secret-32
SESSION_ENCRYPTION_SALT=replace-me-with-another-mix-phx-gen-secret-32

# ----------------------------------------------------------------------------
# Red y URL
# ----------------------------------------------------------------------------

# Puerto de escucha. Debe coincidir con "Ports Exposes" del recurso en Coolify.
PORT=4000

# Esquema y puerto de las URLs generadas (no del listen).
# Deploy por HTTP plano detrás de VPN: PHX_SCHEME=http (y ver DISABLE_FORCE_SSL).
PHX_SCHEME=https
PHX_PORT=443

# Lo setean el release y la imagen (bin/server, ENV del Dockerfile): no lo
# pongas a mano salvo que sepas por qué.
# PHX_SERVER=true

# Origins permitidos para el chequeo CSRF/WS, separados por comas
# (scheme://host:puerto, sin paths). Hace falta cuando la app se ve por más de
# un esquema/host/puerto (HTTPS público + HTTP por VPN): sin esto el POST de
# /login muere en 403 sin log de controlador.
# CHECK_ORIGINS=https://gate.example.com,http://10.0.0.5:4000

# Clustering Erlang distribuido (vacío = instancia única).
# DNS_CLUSTER_QUERY=

# ----------------------------------------------------------------------------
# Base de datos
# ----------------------------------------------------------------------------

# Pool de conexiones (default 10).
# POOL_SIZE=10

# TLS contra la base: por default cifrado SIN verificar (las bases gestionadas
# usan certificados self-signed). ECTO_SSL=false lo apaga para una base local;
# ECTO_SSL_VERIFY=true exige CA válida.
# ECTO_SSL=false
# ECTO_SSL_VERIFY=true
# ECTO_IPV6=false

# ----------------------------------------------------------------------------
# Sesión
# ----------------------------------------------------------------------------

# Forzar el flag Secure de la cookie (HTTPS-only). Default: Plug decide por
# request, así un deploy HTTP sigue funcionando.
# SESSION_COOKIE_SECURE=true

# Vida de la sesión en segundos. Default 31536000 (1 año) con renovación
# deslizante: la cookie se re-emite con max_age fresco en cada request.
# SESSION_MAX_AGE_SECONDS=31536000

# ----------------------------------------------------------------------------
# Deploy / contenedor
# ----------------------------------------------------------------------------

# force_ssl es COMPILE-TIME y la imagen sale con HTTPS on (el default de la
# familia, igual que dran y umbral). Para desplegar por HTTP plano (VPN/LAN sin
# terminador TLS) construí con --build-arg DISABLE_FORCE_SSL=1 —va en las build
# vars de Coolify, no en las de runtime— y poné PHX_SCHEME=http.
# DISABLE_FORCE_SSL=1

# Saltea el setup del entrypoint (contenedores de tareas puntuales).
# SKIP_MIGRATIONS=1

# ----------------------------------------------------------------------------
# Primera cuenta
# ----------------------------------------------------------------------------
# Con TOKENGATE_ADMIN_PASSWORD el boot crea el admin (priv/repo/seeds_prod.exs);
# sin ella no crea NINGÚN usuario y la primera cuenta entra por /onboarding —
# la ventana en que el primero que llegue se apropia de la instancia.
# TOKENGATE_ADMIN_EMAIL=admin@tokengate.local
# TOKENGATE_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Notificaciones
# ----------------------------------------------------------------------------

# Token del bot de Telegram. Si está vacío, el token se lee (cifrado) de la
# configuración de notificaciones de la UI.
# TELEGRAM_BOT_TOKEN=

# ----------------------------------------------------------------------------
# Login con Google (vacío = deshabilitado)
# ----------------------------------------------------------------------------

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://gate.example.com/auth/google/callback
# Dominios que pueden auto-registrarse con Google.
# GOOGLE_OAUTH_ALLOWED_DOMAINS=example.com

# ----------------------------------------------------------------------------
# Proxy (tuning del ruteo y los timeouts)
# ----------------------------------------------------------------------------

# Timeout de lectura contra el proveedor (override por proveedor en la UI).
# PROXY_RECEIVE_TIMEOUT_MS=120000

# Streaming: espera máxima del primer chunk.
# FIRST_TOKEN_TIMEOUT_MS=30000

# Circuit breaker: fallos antes de abrir, duración abierto, cooldown tras 429.
# CIRCUIT_BREAKER_THRESHOLD=3
# CIRCUIT_BREAKER_COOLDOWN_MS=30000
# CIRCUIT_BREAKER_RATE_LIMIT_COOLDOWN_MS=20000

# Ruteo: latencia que marca una credencial como degradada y cuánto la penaliza.
# ROUTING_SLOW_THRESHOLD_MS=30000
# ROUTING_SLOW_PENALTY_MS=120000

# ----------------------------------------------------------------------------
# Sólo desarrollo / test (no van en un deploy)
# ----------------------------------------------------------------------------

# TOKENGATE_ALLOW_DEMO_SEEDS=1   # habilita los datasets demo (priv/repo/seeds.exs)
# MIX_TEST_PARTITION=1           # partición de la suite (mix test --partitions)
